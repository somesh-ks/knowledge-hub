{
  "name": "singularity",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "singularity": "tsx packages/engine/src/cli.ts",
    "typecheck": "npm run typecheck:packages && npm run check -w @singularity/web && npm run check -w @singularity/admin && npm run check -w @singularity/design",
    "typecheck:packages": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:fast": "vitest run --exclude '**/git-*.test.ts'",
    "gate": "node scripts/gate.mjs",
    "build": "npm run build -w @singularity/web && npm run build -w @singularity/admin && npm run build -w @singularity/design",
    "dev": "npm run dev -w @singularity/web",
    "dev:admin": "npm run dev -w @singularity/admin",
    "tokens": "tsx scripts/buildTokens.ts",
    "system": "tsx scripts/system/build.ts",
    "ds": "tsx scripts/system/cli.ts",
    "design-check": "vitest run apps/web/src/styles/styles.test.ts scripts/buildTokens.test.ts",
    "blast-radius": "node scripts/blastRadius.mjs",
    "glyphs": "tsx scripts/buildGlyphs.ts",
    "emoji": "tsx scripts/buildEmoji.ts",
    "icons": "tsx scripts/buildIcons.ts",
    "prototype": "tsx scripts/buildPrototype.ts",
    "sound-lab": "tsx scripts/buildSoundLab.ts",
    "covers:sheet": "tsx packages/cover/scripts/contactSheet.ts",
    "secrets:push": "tsx scripts/pushSecrets.ts",
    "backfill:opus": "tsx scripts/backfillOpus.ts",
    "dev:design": "npm run dev -w @singularity/design",
    "vercel:list": "vercel list",
    "vercel:inspect": "vercel inspect",
    "vercel:logs": "vercel logs",
    "vercel:env-list": "vercel env list"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@phosphor-icons/core": "2.1.1",
    "@types/node": "^26.6.5",
    "emojibase-data": "18.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vercel": "65.8.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    },
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  }
}
