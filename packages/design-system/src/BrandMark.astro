---
interface Props {
  class?: string;
}

const { class: className = "wordmark-mark" } = Astro.props;
---

{/* A ringed dot: a point inside a circle, the same figure as the play chip's ringed glyph. The paths
     are the ones scripts/buildIcons.ts draws into the app icon. */}
<svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor">
  <path
    fill-rule="evenodd"
    d="M12 1.25a10.75 10.75 0 1 0 0 21.5 10.75 10.75 0 0 0 0-21.5Zm0 2.5a8.25 8.25 0 1 1 0 16.5 8.25 8.25 0 0 1 0-16.5Z"
  ></path>
  <circle cx="12" cy="12" r="4.5"></circle>
</svg>
