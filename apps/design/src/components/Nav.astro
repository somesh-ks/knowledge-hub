---
import BrandMark from "../../../web/src/components/BrandMark.astro";
import Icon from "../../../web/src/components/Icon.astro";
import { buildDay } from "../../../web/src/lib/buildDay";
import { href, NAV } from "../lib/sections";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  /** The page's path under the base; "" for the overview. */
  current: string;
}

const { current } = Astro.props;
---

{/* The reader's navigation, drawn by its own classes (shell.css): a bottom bar below 64rem and a side
     column from it. The side column opens Foundations into its pages (an accordion, because it is the
     one place with pages under it); the bottom bar has room for the four top-level pages only, so
     Foundations there opens its own page, which lists them. The foot holds what the reader's holds,
     the day it was built, and the one setting. */}
<nav class="app-nav" aria-label="Singularity design system" data-bottom-nav>
  <a class="app-nav-brand wordmark" href={href("")} aria-label="Singularity design system">
    <BrandMark />
    <span>Singularity</span>
    <span class="guide-tag">Design</span>
  </a>
  <ul class="app-nav-list" role="list">
    {
      NAV.map(({ page, children }) => {
        const inside = children?.some((child) => child.path === current) ?? false;
        const open = inside || page.path === current;
        return (
          <li class:list={["guide-nav-entry", children && "guide-nav-group"]}>
            <a
              class="app-nav-item"
              href={href(page.path)}
              aria-current={page.path === current || inside ? "page" : undefined}
              data-group-current={inside ? "" : undefined}
            >
              <span class="app-nav-indicator">
                <Icon name={page.icon} class="icon-lg app-nav-icon-rest" />
                <Icon name={page.iconCurrent} class="icon-lg app-nav-icon-current" />
              </span>
              <span>{page.label}</span>
            </a>
            {children && (
              <>
                <button
                  class="icon-btn guide-nav-toggle"
                  type="button"
                  aria-expanded={open ? "true" : "false"}
                  aria-controls="nav-sub"
                  aria-label={`${page.label} pages`}
                  data-nav-toggle
                >
                  <Icon name="chevronDown" />
                </button>
                <ul class="guide-nav-sub" id="nav-sub" role="list" hidden={!open}>
                  {children.map((child) => (
                    <li>
                      <a class="guide-nav-subitem" href={href(child.path)} aria-current={child.path === current ? "page" : undefined}>
                        <Icon name={child.path === current ? child.iconCurrent : child.icon} class="icon-lg" />
                        <span>{child.label}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </li>
        );
      })
    }
  </ul>
  <div class="guide-nav-foot">
    <ThemeToggle />
    <p class="guide-updated">Updated {buildDay()}</p>
  </div>
</nav>
<script>
  import "../scripts/nav";
</script>
