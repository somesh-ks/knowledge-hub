---
import BrandMark from "../../../web/src/components/BrandMark.astro";
import Icon from "../../../web/src/components/Icon.astro";
import { buildDay } from "../../../web/src/lib/buildDay";
import { href, SECTIONS } from "../lib/sections";
import ThemeChoice from "./ThemeChoice.astro";

interface Props {
  /** The section's path under the base; "" for the overview. */
  current: string;
}

const { current } = Astro.props;
---

{/* The reader's navigation, drawn by its own classes (shell.css): a bottom bar below 64rem and a side
     column from it. The side column's foot holds what the reader's holds, the day it was built, and the
     theme choice, which is the guide's only setting. */}
<nav class="app-nav" aria-label="Singularity design" data-bottom-nav>
  <a class="app-nav-brand wordmark" href={href("")} aria-label="Singularity design">
    <BrandMark />
    <span>Singularity</span>
    <span class="guide-chip">Design</span>
  </a>
  <ul class="app-nav-list" role="list">
    {
      SECTIONS.map((section) => (
        <li>
          <a class="app-nav-item" href={href(section.path)} aria-current={section.path === current ? "page" : undefined}>
            <span class="app-nav-indicator">
              <Icon name={section.icon} class="icon-lg app-nav-icon-rest" />
              <Icon name={section.icon} class="icon-lg app-nav-icon-current" />
            </span>
            <span>{section.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <div class="guide-nav-foot">
    <p class="guide-updated">Updated {buildDay()}</p>
    <ThemeChoice />
  </div>
</nav>
