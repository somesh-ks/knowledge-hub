---
import Icon from "../../../web/src/components/Icon.astro";
import PageHead from "../components/PageHead.astro";
import Shell from "../layouts/Shell.astro";
import { COLOUR_GROUPS, COLOUR_PAIRS, primitive, swatchSpec } from "../lib/guide";
import { SECTIONS } from "../lib/sections";

const section = SECTIONS.find((item) => item.path === "/colour");
const ramps = ["grey", "blue", "green", "amber", "red"].map((hue) => ({
  hue,
  steps: (primitive.get("color") ?? []).filter((token) => token.path.startsWith(`color.${hue}.`)),
}));
const id = (title: string): string => `g-${title.toLowerCase().replaceAll(" ", "-")}`;
---

<Shell title="Colour" current="/colour">
  <div class="settings-view guide-page" data-settings data-ready data-colour>
    <PageHead title="Colour" note={section?.note ?? ""} />

    <label class="search-field">
      <Icon name="search" />
      <span class="sr-only">Filter colours by name, value or contrast</span>
      <input type="search" placeholder="Filter by name or value" autocomplete="off" data-filter />
    </label>

    {
      COLOUR_GROUPS.map((group) => (
        <section aria-labelledby={id(group.title)}>
          <h2 class="section-head" id={id(group.title)}>{group.title}</h2>
          <p class="guide-note">{group.note}</p>
          <ul class="guide-swatches" role="list">
            {group.names.map((name) => {
              const spec = swatchSpec(name);
              return (
                <li class="guide-swatch" id={name} data-filter-item data-name={name} data-fg={`--color-${spec.fg}`} data-bg={`--color-${spec.bg}`}>
                  <span class="guide-swatch-fill" style={`--swatch: var(--color-${spec.fill}); --ink: var(--color-${spec.ink ?? spec.fill})`}>
                    {spec.ink && <span class="guide-swatch-ink" aria-hidden="true">Aa</span>}
                  </span>
                  <span class="guide-swatch-name">{name}</span>
                  <span class="guide-swatch-value" data-oklch data-resolve={`--color-${name}`}>…</span>
                  <span class="guide-swatch-value" data-hex>…</span>
                  <span class="guide-swatch-contrast" data-contrast>…</span>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }

    <section aria-labelledby="pairs">
      <h2 class="section-head" id="pairs">Contrast</h2>
      <p class="guide-note">WCAG 2 ratios of the pairs the app sets, measured live in this theme: AAA from 7, AA from 4.5, and 3 for edges and large text.</p>
      <ul class="guide-pairs" role="list">
        {
          COLOUR_PAIRS.map((pair) => (
            <li class="guide-pair" data-filter-item data-name={`${pair.fg} ${pair.bg}`} data-pair data-fg={`--color-${pair.fg}`} data-bg={`--color-${pair.bg}`} data-min={pair.min}>
              <span class="guide-pair-sample" style={`--pair-fg: var(--color-${pair.fg}); --pair-bg: var(--color-${pair.bg})`}>
                <span>Aa</span>
                <span class="guide-pair-ratio" data-ratio data-min={pair.min}>…</span>
              </span>
              <span class="guide-swatch-note">{pair.note}</span>
              <span class="guide-swatch-note">{pair.fg} on {pair.bg} · needs {pair.min}:1</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="palette">
      <h2 class="section-head" id="palette">Palette</h2>
      <p class="guide-note">The ramps the roles are built from, in OKLCH. A component never reads one; it reads a role.</p>
      {
        ramps.map((ramp) => (
          <div>
            <h3 class="guide-group-name">{ramp.hue}</h3>
            <ul class="guide-ramp" role="list">
              {ramp.steps.map((token) => <li style={`--swatch: var(${token.name})`} title={`${token.name} ${token.value}`}><span>{token.path.split(".").at(-1)}</span></li>)}
            </ul>
          </div>
        ))
      }
    </section>

    <p class="guide-note" hidden data-filter-empty>Nothing matches. Try a role such as <code>surface</code>, or a value such as <code>oklch</code>.</p>
  </div>
</Shell>
<script>
  import "../scripts/filter";
  import "../scripts/colour";
</script>
