---
import Icon from "../../../web/src/components/Icon.astro";
import { ICON_PATHS, type IconName } from "../../../web/src/lib/icons";
import PageHead from "../components/PageHead.astro";
import Shell from "../layouts/Shell.astro";
import { component, primitive, semantic } from "../lib/guide";
import { SECTIONS } from "../lib/sections";

const section = SECTIONS.find((item) => item.path === "/tokens");
const pick = (tokens: ReturnType<typeof primitive.get>) => tokens ?? [];
const space = pick(primitive.get("space"));
const radius = pick(primitive.get("radius"));
const stroke = pick(primitive.get("stroke"));
const shadows = pick(semantic.get("shadow"));
const durations = pick(primitive.get("duration"));
const eases = pick(primitive.get("ease"));
const interaction = [
  ...pick(primitive.get("spring")),
  ...pick(primitive.get("scale")),
  ...pick(primitive.get("distance")),
  ...pick(primitive.get("state")),
  ...pick(primitive.get("opacity")),
  ...pick(primitive.get("blur")),
];
const layers = pick(primitive.get("z"));
const layout = [
  ...pick(semantic.get("layout")),
  ...pick(semantic.get("breakpoint")),
  ...pick(semantic.get("size")),
];
const groups = [...component.entries()];
const icons = Object.keys(ICON_PATHS) as IconName[];

const jumps = [
  ["space", "Space"],
  ["radius", "Radius"],
  ["shadow", "Shadow"],
  ["motion", "Motion"],
  ["layers", "Layers"],
  ["layout", "Layout"],
  ["components", "Components"],
  ["icons", "Icons"],
] as const;
---

<Shell title="Tokens" current="/tokens">
  <div class="settings-view guide-page" data-settings data-ready data-tokens>
    <PageHead title="Tokens" note={section?.note ?? ""} />

    <div class="guide-jump">
      <div class="tabs-bar">
        <nav class="tabs" aria-label="On this page">
          {jumps.map(([id, label]) => <a class="tab" href={`#${id}`}>{label}</a>)}
        </nav>
      </div>
    </div>
    <label class="search-field">
      <Icon name="search" />
      <span class="sr-only">Filter tokens and icons</span>
      <input type="search" placeholder="Filter tokens and icons" autocomplete="off" data-token-filter />
    </label>

    <section aria-labelledby="space">
      <h2 class="section-head" id="space">Space</h2>
      <p class="guide-note">The 8pt grid: 8, 16, 24, 32, 48, 64 and 96px. The 4px step only where the style rules name it (D131).</p>
      <div class="guide-table-wrap">
        <table class="guide-table">
          <tbody>
            {
              space.map((token) => (
                <tr data-token-row data-name={token.name}>
                  <td><code>{token.name}</code></td>
                  <td>{token.value}</td>
                  <td><span class="guide-bar" style={`--sample: var(${token.name})`} aria-hidden="true" /></td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="radius">
      <h2 class="section-head" id="radius">Radius and stroke</h2>
      <p class="guide-note">Concentric: an inner corner is the outer radius less the padding between them. Controls are pills; containers keep a step.</p>
      <div class="guide-table-wrap">
        <table class="guide-table">
          <tbody>
            {
              radius.map((token) => (
                <tr data-token-row data-name={token.name}>
                  <td><code>{token.name}</code></td>
                  <td>{token.value}</td>
                  <td><span class="guide-corner" style={`--sample: var(${token.name})`} aria-hidden="true" /></td>
                </tr>
              ))
            }
            {
              stroke.map((token) => (
                <tr data-token-row data-name={token.name}>
                  <td><code>{token.name}</code></td>
                  <td>{token.value}</td>
                  <td>{token.description ?? ""}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="shadow">
      <h2 class="section-head" id="shadow">Shadow</h2>
      <p class="guide-note">Five elevations, each a stack of layers that changes with the theme. A box on the page carries none: shadows belong to what floats.</p>
      <div class="guide-table-wrap">
        <table class="guide-table">
          <tbody>
            {
              shadows.map((token) => (
                <tr data-token-row data-name={token.name}>
                  <td><code>{token.name}</code></td>
                  <td><span class="guide-shadow" style={`--sample: var(${token.name})`} aria-hidden="true" /></td>
                  <td>{token.description ?? ""}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="motion">
      <h2 class="section-head" id="motion">Motion</h2>
      <p class="guide-note">Press a play button to run a token. Durations run on the out curve; curves run on the longest ordinary duration. Nothing in the app moves that the reader did not move.</p>

      <h3 class="guide-group-name">Durations</h3>
      <div class="guide-table-wrap">
        <table class="guide-table">
          <tbody>
            {
              durations.map((token) => (
                <tr data-token-row data-name={token.name}>
                  <td><code>{token.name}</code></td>
                  <td>{token.value}</td>
                  <td class="guide-motion-cell">
                    <div class="guide-motion">
                      <div class="guide-motion-track" data-run="false" style={`--run-duration: var(${token.name}); --run-ease: var(--ease-out)`}>
                        <span class="guide-motion-dot" />
                      </div>
                    </div>
                  </td>
                  <td><button class="icon-btn press" type="button" aria-label={`Run ${token.name}`} data-run-motion><Icon name="play" /></button></td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h3 class="guide-group-name">Curves</h3>
      <div class="guide-table-wrap">
        <table class="guide-table">
          <tbody>
            {
              eases.map((token) => (
                <tr data-token-row data-name={token.name}>
                  <td><code>{token.name}</code></td>
                  <td class="guide-motion-cell">
                    <div class="guide-motion">
                      <div class="guide-motion-track" data-run="false" style={`--run-duration: var(--duration-drawer-full); --run-ease: var(${token.name})`}>
                        <span class="guide-motion-dot" />
                      </div>
                    </div>
                  </td>
                  <td><button class="icon-btn press" type="button" aria-label={`Run ${token.name}`} data-run-motion><Icon name="play" /></button></td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h3 class="guide-group-name">Press, hover and enter</h3>
      <div class="guide-table-wrap">
        <table class="guide-table">
          <tbody>
            {
              interaction.map((token) => (
                <tr data-token-row data-name={token.name}>
                  <td><code>{token.name}</code></td>
                  <td>{token.value}</td>
                  <td>{token.description ?? ""}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="layers">
      <h2 class="section-head" id="layers">Layers</h2>
      <div class="guide-table-wrap">
        <table class="guide-table">
          <tbody>
            {layers.map((token) => <tr data-token-row data-name={token.name}><td><code>{token.name}</code></td><td>{token.value}</td><td>{token.description ?? ""}</td></tr>)}
          </tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="layout">
      <h2 class="section-head" id="layout">Layout and size</h2>
      <div class="guide-table-wrap">
        <table class="guide-table">
          <tbody>
            {layout.map((token) => <tr data-token-row data-name={token.name}><td><code>{token.name}</code></td><td>{token.value}</td><td>{token.description ?? ""}</td></tr>)}
          </tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="components">
      <h2 class="section-head" id="components">Component tokens</h2>
      <p class="guide-note">The sizes and bindings each component reads, by component.</p>
      {
        groups.map(([group, tokens]) => (
          <div>
            <h3 class="guide-group-name">{group}</h3>
            <div class="guide-table-wrap">
              <table class="guide-table">
                <tbody>
                  {tokens.map((token) => <tr data-token-row data-name={token.name}><td><code>{token.name}</code></td><td>{token.value}</td><td>{token.description ?? ""}</td></tr>)}
                </tbody>
              </table>
            </div>
          </div>
        ))
      }
    </section>

    <section aria-labelledby="icons">
      <h2 class="section-head" id="icons">Icons</h2>
      <p class="guide-note">One set, Phosphor, drawn by the Icon component. Each glyph carries its name in <code>data-icon</code> for the ink margins (D187).</p>
      <ul class="guide-icons" role="list">
        {icons.map((name) => <li class="guide-icon" data-token-row data-name={name}><Icon name={name} class="icon-lg" /><span>{name}</span></li>)}
      </ul>
    </section>
  </div>
</Shell>
<script>
  import "../scripts/tokens";
</script>
