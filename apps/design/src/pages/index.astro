---
import Icon from "../../../web/src/components/Icon.astro";
import { DESIGN_CATEGORIES, DESIGN_LEVELS } from "../../../web/src/lib/designSpec";
import PageHead from "../components/PageHead.astro";
import SpecCard from "../components/SpecCard.astro";
import Shell from "../layouts/Shell.astro";
import { designSpecs, LEVEL_NOTES, LEVEL_TITLES } from "../lib/guide";
import { href, SECTIONS } from "../lib/sections";

const section = SECTIONS[0];
const groups = DESIGN_LEVELS.map((level) => ({
  level,
  specs: designSpecs.filter((spec) => spec.level === level),
})).filter((group) => group.specs.length > 0);
const categories = DESIGN_CATEGORIES.filter((category) =>
  designSpecs.some((spec) => spec.category === category),
);
---

<Shell title="Components" current="">
  <div class="settings-view guide-page" data-settings data-ready data-index-url={href("/search-index.json")}>
    <PageHead title="Components" note={section?.note ?? ""} />

    <div class="guide-toolbar">
      <label class="search-field">
        <Icon name="search" />
        <span class="sr-only">Search components, colours and tokens</span>
        <input type="search" name="q" placeholder="Search components, colours and tokens" autocomplete="off" data-guide-search />
      </label>
      <fieldset class="segmented-choice" role="radiogroup" aria-label="Level" data-level-choice>
        <label class="segmented-choice-item"><input type="radio" name="level" value="" checked /><span>All</span></label>
        {
          DESIGN_LEVELS.map((level) => (
            <label class="segmented-choice-item"><input type="radio" name="level" value={level} /><span>{LEVEL_TITLES[level]}</span></label>
          ))
        }
      </fieldset>
      <fieldset class="filter-chips filter-chips-scroll" aria-label="Category" data-category-filter>
        {
          categories.map((category) => (
            <label class="filter-chip"><input type="checkbox" name="category" value={category} /><Icon name="check" class="filter-chip-check" /><span>{category}</span></label>
          ))
        }
      </fieldset>
      <p class="settings-hint" data-count aria-live="polite">{designSpecs.length} components</p>
    </div>

    {
      groups.map((group) => (
        <section aria-labelledby={`level-${group.level}`} data-group={group.level}>
          <h2 class="section-head" id={`level-${group.level}`}>{LEVEL_TITLES[group.level]}</h2>
          <p class="guide-note">{LEVEL_NOTES[group.level]}</p>
          <div class="guide-grid">
            {group.specs.map((spec) => <SpecCard spec={spec} />)}
          </div>
        </section>
      ))
    }

    <section hidden data-token-results aria-labelledby="also-found">
      <h2 class="section-head" id="also-found">Also found</h2>
      <div class="rows card-group" data-token-list></div>
    </section>

    <p class="guide-note" hidden data-empty>Nothing matches. Try a class name such as <code>btn</code>, or a token such as <code>duration</code>.</p>
  </div>
</Shell>
<script>
  import "../scripts/index";
</script>
