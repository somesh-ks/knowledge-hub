---
import PageHead from "../components/PageHead.astro";
import Shell from "../layouts/Shell.astro";
import { SECTIONS } from "../lib/sections";

const section = SECTIONS.find((item) => item.path === "/principles");

// Written from the product brief (apps/web/PRODUCT.md), the design-engineering ledger and the
// decisions it cites. The D-numbers are the repo's decisions; a principle changes there first.
const principles: { title: string; body: string[]; ref: string }[] = [
  {
    title: "A real app, not a generated page",
    body: [
      "The visual direction is a podcast app. Google Podcasts sets the language, YouTube Music sets how the player behaves, and Material 3 sets the tonal surfaces. A new screen starts from how the reference product does it, not from what would look nice.",
      "Surfaces are flat. A control sits on the page as a tonal fill with no outline; the only outline is on a text field, where the boundary has to be seen.",
    ],
    ref: "D31, D72",
  },
  {
    title: "Nothing moves that the reader did not move",
    body: [
      "A chip does not grow when its check appears. A panel does not shake when a menu opens. A page does not scroll itself. Controls hold one box across hover, press, checked and played; where a state changes the content, a hidden copy holds the room.",
      "Reduced motion means fewer and gentler animations, never none.",
    ],
    ref: "D94, D95",
  },
  {
    title: "Quiet and live",
    body: [
      "No waiting copy and no chatter about saving: the saved control is the confirmation. The interface speaks only when the reader can act on what it says, and a failure is told once, in one place.",
    ],
    ref: "D94, D115",
  },
  {
    title: "Show what a control does by how it looks",
    body: [
      "A control that explains itself is a control that is wrong. A glyph says what a press does; a field that opens a list looks like a select; a disabled control stays on its row, dimmed and named, never hidden. A decoration must never look pressable.",
    ],
    ref: "D92, D98",
  },
  {
    title: "Minimal, with high brevity",
    body: [
      "Fewer controls, fewer words, one way to say each thing. One noun for one thing. Labels are plain: Format, Custom, AI model. A status line is three or four words.",
      "One filled action per screen. Colour is information, not decoration: it says what is current, chosen or wrong.",
    ],
    ref: "D77, D84, D96",
  },
  {
    title: "Hierarchy by size and space, never by crowding",
    body: [
      "A secondary line goes under its title with a full spacing step, never above it. Two sizes that are nearly the same read as a mistake, so the scale keeps its steps wide. Headings are regular weight; nothing is bold.",
      "Spacing is the 8pt grid, with the 4px step only where the rules name it.",
    ],
    ref: "D31, D73, D125, D131",
  },
  {
    title: "Every control is complete",
    body: [
      "A touch target of at least 44px, a sound, a press state that never shrinks the words, and a focus ring that survives forced colours. A control missing any of the four is unfinished, however it looks.",
    ],
    ref: "D72, D101",
  },
  {
    title: "Accessible to the standard, not the checklist",
    body: [
      "WCAG 2.2 AA. Text is 4.5 to 1 on every surface it can sit on and a control's edge is 3 to 1; the Colour page measures both live. Colour is never the only signal: a word or a glyph says it too.",
    ],
    ref: "D54",
  },
  {
    title: "Tokens are the only source of values",
    body: [
      "No colour literal, no raw length, no private easing. A component reads a component token, which reads a semantic token, which reads a primitive. A change to a part is made in its shared class, component or token, never on one page only.",
    ],
    ref: "D131",
  },
  {
    title: "Fixes with a reason are not undone",
    body: [
      "Markup or a rule with a comment giving its date and decision is load-bearing: extend it or ask, do not rewrite it to make another task work. Look up the history of a shared rule before changing it.",
    ],
    ref: "",
  },
];

const bans = [
  "Boxed outlines and cards inside cards.",
  "Cream backgrounds, gradient washes, grey shadows, terracotta.",
  "Italic accent words, monospace eyebrows, all-caps labels, numbered labels.",
  "A chevron on the bar, a grabber on phone sheets, a drag handle on the player.",
  "A meta line above a headline, a vendor prefix or model id in a label.",
  "Em dashes.",
];
---

<Shell title="Principles" current="/principles">
  <div class="settings-view guide-page" data-settings data-ready>
    <PageHead title="Principles" note={section?.note ?? ""} />

    <section aria-labelledby="brief">
      <h2 class="section-head" id="brief">What it is for</h2>
      <p class="guide-prose">Singularity is a private briefing for one design engineer: the two days of tech and design-engineering news that matter, three minutes to read or eight to hear, usually on a phone with one hand. It is a curator's cut, not an aggregator's feed. The interface follows from that: quick, plain and out of the way.</p>
    </section>

    <section aria-labelledby="rules">
      <h2 class="section-head" id="rules">Principles</h2>
      <ol class="guide-principles" role="list">
        {
          principles.map((principle) => (
            <li class="guide-principle">
              <h3>{principle.title}</h3>
              {principle.body.map((paragraph) => <p>{paragraph}</p>)}
              {principle.ref && <p class="guide-note">{principle.ref}</p>}
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="bans">
      <h2 class="section-head" id="bans">Not here</h2>
      <p class="guide-note">Each was tried or refused, and the owner said no.</p>
      <ul class="guide-list">
        {bans.map((ban) => <li>{ban}</li>)}
      </ul>
    </section>

    <section aria-labelledby="kept">
      <h2 class="section-head" id="kept">How it is kept</h2>
      <p class="guide-prose">Three layers catch drift. A static check reads every stylesheet for literals, off-grid spacing and undefined tokens, and runs on each edit. A browser suite measures the rendered grid on every page. A design audit screenshots each page, light and dark, phone and desktop, before a change merges. This guide is the fourth: each component page here is drawn by a spec that lives beside the component, and a test fails when a shared class has no spec.</p>
    </section>
  </div>
</Shell>
