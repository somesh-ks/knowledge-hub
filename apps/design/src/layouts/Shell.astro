---
import BrandMark from "../../../web/src/components/BrandMark.astro";
import themeInit from "../../../web/src/scripts/themeInit.js?raw";
import Nav from "../components/Nav.astro";
import { href } from "../lib/sections";
import "../../../web/src/styles/tokens.css";
import "../../../web/src/styles/foundations.css";
import "../../../web/src/styles/fonts.css";
import "../../../web/src/styles/shell.css";
import "../../../web/src/styles/buttons.css";
import "../../../web/src/styles/primitives.css";
import "../../../web/src/styles/settings.css";
import "../../../web/src/styles/manage.css";
import "../../../web/src/styles/banner.css";
import "../../../web/src/styles/empty.css";
import "../../../web/src/styles/hero.css";
import "../../../web/src/styles/library.css";
import "../../../web/src/styles/cover.css";
import "../../../web/src/styles/briefing.css";
import "../../../web/src/styles/story-controls.css";
import "../../../web/src/styles/create-sheet.css";
import "../../../web/src/styles/episode-actions.css";
import "../../../web/src/styles/create.css";
import "../../../web/src/styles/multiselect.css";
import "../../../web/src/styles/topics.css";
import "../../../web/src/styles/sheets.css";
import "../../../web/src/styles/player.css";
import "../../../web/src/styles/reader.css";
import "../../../web/src/styles/health.css";
import "../../../web/src/styles/utilities.css";
import "../styles/guide.css";

interface Props {
  title: string;
  /** The section's path under the base; "" for the component index. */
  current: string;
}

const { title, current } = Astro.props;

// This tab's theme choice (themeChoice.ts), applied before first paint over the reader's saved one.
const tabTheme = `(() => { try { const t = sessionStorage.getItem("design:theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t; } catch {} })();`;
---

<!doctype html>
<html lang="en" data-view="settings" data-layout="single" data-player="closed" data-mini="hidden">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Singularity style guide</title>
    <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
    {/* The reader's own script: a theme chosen there (stored in this browser) shows here too. */}
    <script is:inline set:html={themeInit.trim()} />
    <script is:inline set:html={tabTheme} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to the content</a>
    <header class="app-bar">
      <div class="app-bar-inner page">
        <a class="wordmark" href={href("")} aria-label="Singularity style guide">
          <BrandMark />
          <span>Style guide</span>
        </a>
      </div>
    </header>
    <Nav current={current} />
    <div class="shell page">
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>
  </body>
</html>
