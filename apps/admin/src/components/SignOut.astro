---
import Button from "../../../web/src/design-system/Button.astro";
import { href } from "../lib/sections";

interface Props {
  /** For placing the control where it stands. */
  class?: string;
}

const { class: placement } = Astro.props;
---

{/* The gate (src/gate/gate.ts) answers this post: it clears the session and goes to the sign-in page. */}
<form method="post" action={href("/logout")} class={placement} data-sign-out>
  <Button variant="text" type="submit">Sign out</Button>
</form>

<script>
  import { forgetAnswers } from "../lib/kept";

  // The device forgets the owner's kept numbers (lib/kept.ts) along with the session.
  for (const form of document.querySelectorAll("form[data-sign-out]")) {
    form.addEventListener("submit", forgetAnswers);
  }
</script>
