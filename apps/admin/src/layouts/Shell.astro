---
import { SECTIONS } from "../lib/sections";
import "../../../web/src/styles/tokens.css";
import "../../../web/src/styles/fonts.css";
import "../styles/admin.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark" />
    <title>{title} · Singularity command center</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to the content</a>
    <div class="shell">
      <header class="rail">
        <a class="brand" href="/" aria-label="Command center, overview">
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-name">Command center</span>
        </a>
        <nav class="rail-nav" aria-label="Sections">
          <a class="rail-link" href="/" aria-current={path === "/" ? "page" : undefined}>Overview</a>
          {
            SECTIONS.map((section) => (
              <a class="rail-link" href={section.href} aria-current={path === section.href ? "page" : undefined}>
                {section.label}
              </a>
            ))
          }
        </nav>
        <p class="rail-foot">Singularity</p>
      </header>
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>
  </body>
</html>
