---
import Shell from "../layouts/Shell.astro";
import { SECTIONS, STATUS_LABEL } from "../lib/sections";

export function getStaticPaths() {
  return SECTIONS.map((section) => ({
    params: { section: section.href.slice(1) },
    props: { section },
  }));
}

const { section } = Astro.props;
---

<Shell title={section.label}>
  <div class="page-head">
    <p class="kicker">{section.label}</p>
    <h1 class="page-title">{section.label}</h1>
    <p class="page-note">{section.question}</p>
  </div>
  <div class="panels">
    <div class="panel">
      <div class="panel-head">
        <span>Status</span>
        <span class="status" data-status={section.status}>{STATUS_LABEL[section.status]}</span>
      </div>
      <div class="panel-body">
        <p class="panel-note">Nothing is drawn here yet.</p>
      </div>
    </div>
  </div>
</Shell>
