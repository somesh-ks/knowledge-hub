---
import AdminHead from "../components/AdminHead.astro";
import StatusGlyphs from "../components/StatusGlyphs.astro";
import Shell from "../layouts/Shell.astro";
---

<Shell title="Overview" current="">
  <div class="settings-view" data-overview>
    <AdminHead title="Overview" />

    {/* Static shells: each card is drawn here, and scripts/overview.ts fills them from the reader's
         /api/health and /api/costs, so nothing moves when the answers arrive. */}
    <StatusGlyphs />

    <section data-overview-health data-loading>
      <h2 class="section-head text-heading">Health</h2>
      <div class="card-group ov-card">
        {/* One arc a group, its name and state at its side; a press on either opens that group below.
             The ring's middle says which is open, and the arcs say how it all stands. */}
        <div class="ov-ring ov-data" data-ring aria-live="polite">
          <svg class="ov-ring-svg" viewBox="0 0 200 200" aria-hidden="true" data-ring-svg>
            <circle class="ov-ring-track" cx="100" cy="100" r="84"></circle>
          </svg>
          <div class="ov-ring-centre">
            <p class="ov-figure" data-quad-name>&nbsp;</p>
            <p class="ov-sub" data-quad-sub>&nbsp;</p>
          </div>
          <fieldset class="ov-quads" role="radiogroup" aria-label="Group" data-quads></fieldset>
        </div>
        <div class="ov-groups ov-data" data-health-groups></div>
        <p class="settings-note" data-health-note hidden></p>
      </div>
    </section>

    <section data-overview-spend data-loading>
      <h2 class="section-head text-heading">Spend</h2>
      <div class="card-group ov-card">
        <div class="ov-block ov-data">
          <div class="ov-answer">
            <p class="ov-figure"><span class="sr-only">Total spend </span><span data-spend-total>Loading</span></p>
            <p class="ov-sub" data-spend-sub>Last 30 days</p>
          </div>
          <p class="settings-note" data-spend-note hidden></p>
        </div>
        {/* A week of runs: a ring a day, filled by what the day cost. A press picks a day and its
             line below says what ran; the strip is radios, so the arrow keys walk it. */}
        <div class="ov-block ov-data">
          <fieldset class="ov-days" role="radiogroup" aria-label="Day" data-spend-days></fieldset>
          <div class="ov-day-detail" aria-live="polite" data-day-detail>
            <p class="ov-day-figure" data-day-figure>&nbsp;</p>
            <p class="ov-sub" data-day-sub>&nbsp;</p>
          </div>
        </div>
        <div class="ov-block ov-split ov-data">
          <div class="ov-share" role="img" data-spend-share></div>
          <ul class="ov-legend" role="list" data-spend-legend></ul>
        </div>
      </div>
    </section>
  </div>
</Shell>

<script>
  import "../scripts/overview";
</script>
