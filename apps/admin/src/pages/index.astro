---
import Icon from "../../../web/src/design-system/Icon.astro";
import { HEALTH_DEVICES, HEALTH_GROUPS, HEALTH_SPEED } from "../../../web/src/lib/healthRows";
import AdminHead from "../components/AdminHead.astro";
import Shell from "../layouts/Shell.astro";

// The ring's four pillars are the places to look, not the kinds of fault: a fault class (errors) cuts
// across them, so each error check sits with what it breaks. Content is what readers get, Pipeline
// is what makes it, Site is what the browser sees, Server is what answers it. Each row keeps the id
// the route answers by and a name that stands alone under its pillar.
const labelOf = new Map(
  HEALTH_GROUPS.flatMap((group) => group.rows.map((row) => [`${group.id}.${row.id}`, row.label])),
);
const rows = (...ids: string[]) =>
  ids.map((key) => ({ id: key.split(".")[1] ?? key, label: labelOf.get(key) ?? key }));
const groups = [
  {
    id: "content",
    title: "Content",
    rows: rows("briefings.daily", "briefings.weekly", "briefings.catch_up", "briefings.narration"),
  },
  {
    id: "pipeline",
    title: "Pipeline",
    rows: [
      ...rows(
        "jobs.job_run",
        "jobs.job_podcast",
        "jobs.job_audio",
        "jobs.job_content",
        "jobs.job_health",
      ).map((row) => ({ ...row, label: `Job: ${row.label}` })),
      ...rows("times.time_daily", "times.time_weekly").map((row) => ({
        ...row,
        label: `${row.label} run time`,
      })),
      ...rows("briefings.fallbacks", "services.sources"),
    ],
  },
  {
    id: "site",
    title: "Site",
    rows: [
      ...HEALTH_SPEED.flatMap((metric) =>
        HEALTH_DEVICES.map((device) => ({
          id: `${metric.id}.${device.id}`,
          label: `${metric.label} on ${device.label.toLowerCase()}`,
        })),
      ),
      ...rows("errors.page_errors", "errors.blocked_scripts"),
    ],
  },
  {
    id: "server",
    title: "Server",
    rows: rows("errors.server_errors", "errors.timeouts", "services.database", "services.content"),
  },
];
---

<Shell title="Overview" current="">
  <div class="settings-view" data-overview data-groups={JSON.stringify(groups)}>
    <AdminHead title="Overview" />

    {/* Static shells: each card is drawn here, and scripts/overview.ts fills them from the reader's
         /api/health and /api/costs, so nothing moves when the answers arrive. The three status
         glyphs wait here as templates, so the script draws no markup of its own. */}
    <template data-glyphs>
      <span data-glyph="good"><Icon name="checkCircle" /></span>
      <span data-glyph="warn"><Icon name="alert" /></span>
      <span data-glyph="bad"><Icon name="blocked" /></span>
      <span data-glyph="more"><Icon name="chevronDown" /></span>
    </template>

    <section data-overview-health data-loading>
      <h2 class="section-head text-heading">Health</h2>
      <div class="card-group ov-card">
        {/* One arc a group, its name and state at its side; a press on either opens that group below.
             The ring's middle says which is open, and the arcs say how it all stands. */}
        <div class="ov-ring ov-data" data-ring aria-live="polite">
          <svg class="ov-ring-svg" viewBox="0 0 200 200" aria-hidden="true" data-ring-svg>
            <circle class="ov-ring-track" cx="100" cy="100" r="84"></circle>
          </svg>
          <div class="ov-ring-centre">
            <p class="ov-figure" data-quad-name>&nbsp;</p>
            <p class="ov-sub" data-quad-sub>&nbsp;</p>
          </div>
          <fieldset class="ov-quads" role="radiogroup" aria-label="Group" data-quads></fieldset>
        </div>
        <div class="ov-groups ov-data" data-health-groups></div>
        <p class="settings-note" data-health-note hidden></p>
      </div>
    </section>

    <section data-overview-spend data-loading>
      <h2 class="section-head text-heading">Spend</h2>
      <div class="card-group ov-card">
        <div class="ov-block ov-data">
          <div class="ov-answer">
            <p class="ov-figure"><span class="sr-only">Total spend </span><span data-spend-total>Loading</span></p>
            <p class="ov-sub" data-spend-sub>Last 30 days</p>
          </div>
          <p class="settings-note" data-spend-note hidden></p>
        </div>
        {/* A week of runs: a ring a day, filled by what the day cost. A press picks a day and its
             line below says what ran; the strip is radios, so the arrow keys walk it. */}
        <div class="ov-block ov-data">
          <fieldset class="ov-days" role="radiogroup" aria-label="Day" data-spend-days></fieldset>
          <div class="ov-day-detail" aria-live="polite" data-day-detail>
            <p class="ov-day-figure" data-day-figure>&nbsp;</p>
            <p class="ov-sub" data-day-sub>&nbsp;</p>
          </div>
        </div>
        <div class="ov-block ov-split ov-data">
          <div class="ov-share" role="img" data-spend-share></div>
          <ul class="ov-legend" role="list" data-spend-legend></ul>
        </div>
      </div>
    </section>
  </div>
</Shell>

<script>
  import "../scripts/overview";
</script>
