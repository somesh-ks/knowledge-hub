---
import Icon from "../../../web/src/components/Icon.astro";
import AdminHead from "../components/AdminHead.astro";
import Shell from "../layouts/Shell.astro";
import { href, SECTIONS } from "../lib/sections";

const sections = SECTIONS.filter((section) => section.path !== "");
---

<Shell title="Overview" current="">
  <div class="settings-view" data-settings>
    <AdminHead title="Overview" note="How the app is doing, what it costs and how well the design system is used." />
    <section>
      <h2 class="section-head">Sections</h2>
      <div class="rows card-group">
        {
          sections.map((section) => (
            <a class="row-action" href={href(section.path)}>
              <span class="settings-text">
                <span class="settings-label">{section.label}</span>
                <span class="settings-hint">{section.status}</span>
              </span>
              <Icon name="chevronRight" />
            </a>
          ))
        }
      </div>
    </section>
  </div>
</Shell>
