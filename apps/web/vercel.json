{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && npm ci --ignore-scripts",
  "buildCommand": "npm run build",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ../../Digests ../../packages ../../tokens ../../scripts ../../state/last-run.json ../../state/source-stats.json ../../state/source-candidates.json ../../config ../../Podcasts ../../package.json ../../package-lock.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "*/*": false,
      "*/*/*": false,
      "main": true,
      "preview/*": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/run",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/run",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/run",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/run",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/run",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/run",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/run",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/run",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/run",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/run",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/run",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/run",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/run",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/run",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/run",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/run",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/run",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/run",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/run",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/run",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/run",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/run",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/run",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron/run",
      "schedule": "0 23 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "img-src 'self' data: https://queue.simpleanalyticscdn.com; font-src 'self'; media-src 'self' https://*.public.blob.vercel-storage.com; connect-src 'self' https://*.public.blob.vercel-storage.com https://queue.simpleanalyticscdn.com; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/covers/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "Content-Type",
          "value": "text/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/library",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/offline",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/404",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/d/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/latest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/build.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    }
  ]
}
