---
import type { IconName } from "../lib/icons";
import Icon from "./Icon.astro";

interface Props {
  tone: "info" | "warning" | "danger" | "success";
  icon: IconName;
  title: string;
  body?: string;
  /** A button that opens a sheet. The sheets island listens for data-open. */
  action?: { label: string; open: "generate" | "settings" };
}

const { tone, icon, title, body, action } = Astro.props;
---

<div class="banner" data-tone={tone} role={tone === "danger" ? "alert" : "status"}>
  <Icon name={icon} />
  <div>
    <p class="banner-title">{title}</p>
    {body && <p class="banner-body">{body}</p>}
  </div>
  {action && <button class="banner-action press" type="button" data-open={action.open}>{action.label}</button>}
</div>
