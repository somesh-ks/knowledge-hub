---
import { paletteAccent } from "@dispatch/cover";
import type { EpisodeEntry } from "../lib/episodes";
import { EPISODE_KIND } from "../lib/library";
import { episodeFacts } from "../lib/libraryCard";
import Cover from "./Cover.astro";
import Icon from "./Icon.astro";
import CoverPlay from "./CoverPlay.astro";

interface Props {
  entry: EpisodeEntry;
  /** The first row of a grid loads its covers at once; the rest wait until they are near. */
  priority?: boolean;
}

const { entry, priority = false } = Astro.props;
const { episode } = entry;
const facts = episodeFacts(entry);
---

{/* One episode as album art, like a briefing's card: the cover, its title and one quiet line that
     says the format and the length. The data attributes are what the Library's search, sort and
     filter read. An episode has no recording until someone presses play, so it is never "with audio". */}
<li
  class="card"
  data-card
  data-date={episode.date}
  data-id={entry.id}
  data-kind={EPISODE_KIND}
  data-stories={episode.sources.length}
  data-minutes={facts.minutes}
  data-search={facts.search}
  data-meta-lines={facts.metaLines}
>
  <a class="card-link" href={`/e/${entry.id}`} data-astro-prefetch="hover">
    <Cover
      digestId={entry.id}
      size="card"
      paletteBg={paletteAccent(entry.cover.palette).bg}
      weekly={false}
      priority={priority}
    />
    {/* A half-heard item: a bar under the art, on its own track, so it reads on any cover. */}
    <span class="card-progress" data-cover-progress aria-hidden="true" hidden></span>
    <span class="card-title">{episode.title}</span>
    <span class="card-sub">
      <span class="card-facts" data-card-facts data-rest={facts.line}>{facts.line}</span>
      <span class="card-played" data-card-played hidden><Icon name="check" />Played</span>
    </span>
  </a>
  <CoverPlay digestId={entry.id} href={`/e/${entry.id}`} title={episode.title} />
</li>
