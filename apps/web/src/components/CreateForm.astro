---
import { OPEN_PASSPHRASE, PASSPHRASE_REQUIRED } from "../lib/access";
import {
  AUDIENCES,
  DEFAULTS,
  FORMATS,
  LENGTHS,
  MAX_TITLE_CHARS,
  MORE_OPTIONS_TEMPLATE,
  moreOptionsSummary,
  submitLabel,
  TONES,
  topicOptions,
  WINDOWS,
} from "../lib/createForm";
import { loadManage } from "../lib/manage";
import { loadScheduleView } from "../lib/schedule";
import Icon from "./Icon.astro";
// The layout renders this form for the Create sheet on every page, so these styles are global. The
// build links them before the layout's own stylesheets, so their rules never rely on coming last:
// where one adjusts a shared rule, it does so with a more specific selector.
import "../styles/settings.css";
import "../styles/create.css";

const { sections, topics: allTopics } = await loadManage();
// What the panel starts from: the custom defaults in config/schedule.json (type, length, voices, and
// the topics out of the Custom scope, which it does not offer).
const { custom } = await loadScheduleView();
const topics = topicOptions(sections, allTopics, custom.skip_topics);
const startFormat = custom.format;
const startLength = custom.length_minutes;
// A readout's one select is "Voice"; in a discussion each select is a host's voice.
const VOICES = [
  {
    name: "voice",
    saved: custom.voice_id,
    label: "Voice",
    caption: "First host",
    hostLabel: "First host's voice",
  },
  {
    name: "voice_b",
    saved: custom.voice_id_b,
    label: "Second host's voice",
    caption: "Second host",
    hostLabel: "Second host's voice",
  },
] as const;
const labelOf = <T>(list: ReadonlyArray<{ value: T; label: string }>, value: T) =>
  list.find((item) => item.value === value)?.label ?? "";
// The More options line before the script runs: the same words the script writes (createPage.ts).
const moreSummary = moreOptionsSummary(
  labelOf(AUDIENCES, DEFAULTS.audience),
  labelOf(WINDOWS, DEFAULTS.window),
  labelOf(TONES, DEFAULTS.tone),
);

// Every sentence the form's script can show lives here, in the markup, not in the script. The
// script picks one by its key, which keeps it small. The run's own lines are in RunStatus.astro.
const COPY = {
  topics: "Pick at least one topic.",
  ...(PASSPHRASE_REQUIRED
    ? {
        passphrase: "Enter the passphrase to continue.",
        "401": "That passphrase does not match. Check it and try again.",
      }
    : {}),
  "400": "That request did not go through. Reload the page and try again.",
  cooldown: "Episodes need a short rest between them. Try again in",
  daily_cap: "The limit for today is reached. Try again in",
  "503": "Episodes are not available right now. Try again in a few minutes.",
  network: "The request did not go through. Check your connection, then try again.",
} as const;
---

{/* The one Create form. /create renders it in the page; the layout renders it into a template that
     the sheet clones on first open. A page never renders both, so its ids stay unique. */}
<div
  class="create-view"
  data-create
  data-open-passphrase={PASSPHRASE_REQUIRED ? undefined : OPEN_PASSPHRASE}
>
  <form data-create-form novalidate>
    {/* What the episode is about comes first and is the one question without an answer. Length and
         format follow; everything else has a default and waits under More options, whose line says
         what those defaults are. */}
    <section class="create-group create-group-primary" aria-labelledby="create-topics-label">
      <h2 class="section-head" id="create-topics-label">Topics</h2>
      <fieldset class="filter-chips" aria-labelledby="create-topics-label">
        {
          topics.map((topic) => (
            <label class="filter-chip">
              <input
                type="checkbox"
                name="topic"
                value={topic.value}
                data-ids={topic.ids.join(" ")}
                data-presets={topic.presets.join(" ")}
                checked={topic.presets.includes(DEFAULTS.audience)}
              />
              <Icon name="check" class="filter-chip-check" />
              <span>{topic.label}</span>
            </label>
          ))
        }
      </fieldset>
      <p class="create-error" role="alert" data-error="topics" hidden>
        <Icon name="alert" /><span></span>
      </p>
    </section>

    <section class="create-group" aria-labelledby="create-length-label">
      <h2 class="section-head" id="create-length-label">Length</h2>
      <fieldset class="settings-choice create-choice" role="radiogroup" aria-labelledby="create-length-label">
        {
          LENGTHS.map((length) => (
            <label class="settings-segment">
              <input type="radio" name="length" value={length.value} data-submit-label={submitLabel(length.value)} checked={length.value === startLength} />
              <span>{length.label}</span>
            </label>
          ))
        }
      </fieldset>
    </section>

    {/* The line under the format says who will be heard: one voice, or two hosts and which voices
         they have. The script fills in the names once the voices have loaded. */}
    <section class="create-group" aria-labelledby="create-format-label">
      <h2 class="section-head" id="create-format-label">Format</h2>
      <fieldset class="settings-choice create-choice" role="radiogroup" aria-labelledby="create-format-label" aria-describedby="create-format-hint">
        {
          FORMATS.map((format) => (
            <label class="settings-segment">
              <input type="radio" name="format" value={format.value} checked={format.value === startFormat} />
              <span>{format.label}</span>
            </label>
          ))
        }
      </fieldset>
      <p
        class="create-hint create-format-hint"
        id="create-format-hint"
        data-format-hint
        data-readout="Read in one voice."
        data-readout-named="Read by {a}."
        data-discussion="Two hosts talk it through, in two voices."
        data-discussion-named="Two hosts talk it through, voiced by {a} and {b}."
      >{startFormat === "discussion" ? "Two hosts talk it through, in two voices." : "Read in one voice."}</p>
    </section>

    {/* Everything with a sensible default, in place: one row that names the current choices and
         opens to show them. On a wide /create page it stays open beside the main questions. */}
    <details class="create-more" data-create-more>
      <summary class="create-more-summary">
        <span class="create-more-text">
          <span class="create-more-title">More options</span>
          <span class="create-more-values" data-more-values data-template={MORE_OPTIONS_TEMPLATE}>{moreSummary}</span>
        </span>
        <Icon name="chevronDown" class="create-more-chevron" />
      </summary>
      <div class="create-more-body">
        <section class="create-group" aria-labelledby="create-audience-label">
          <h2 class="section-head" id="create-audience-label">Written for</h2>
          <fieldset class="settings-choice create-choice" role="radiogroup" aria-labelledby="create-audience-label">
            {
              AUDIENCES.map((audience) => (
                <label class="settings-segment">
                  <input type="radio" name="audience" value={audience.value} data-label={audience.label} checked={audience.value === DEFAULTS.audience} />
                  <span>{audience.label}</span>
                </label>
              ))
            }
          </fieldset>
          {/* Switching the audience brings its suggested topics only while the topics are still the
               last suggestion. Picks made by hand stay, and this line says so and offers the swap. */}
          <p class="create-hint create-preset-note" data-preset-note hidden>
            <span>Your topic picks are kept.</span>
            <button class="btn create-inline-btn" type="button" data-preset-apply>Use suggested topics</button>
          </p>
        </section>

        {/* A readout has one voice; a discussion has two hosts, each with a voice. The options come
             from /api/voices when the form is first used, so the markup carries only the default and
             the saved voice. */}
        <section class="create-group" aria-labelledby="create-voice-label">
          <h2 class="section-head" id="create-voice-label" data-voice-heading data-one="Voice" data-two="Voices">{startFormat === "discussion" ? "Voices" : "Voice"}</h2>
          <div class="create-voices">
            {
              VOICES.map((voice, index) => (
                <div class="create-voice" data-voice={voice.name} hidden={index === 1 && startFormat !== "discussion"}>
                  <label class="create-voice-name" for={`create-${voice.name}`} data-voice-caption hidden={startFormat !== "discussion"}>{voice.caption}</label>
                  <span class="create-select">
                    <select
                      id={`create-${voice.name}`}
                      name={voice.name}
                      data-saved={voice.saved ?? ""}
                      data-one={voice.label}
                      data-two={voice.hostLabel}
                      aria-label={startFormat === "discussion" ? voice.hostLabel : voice.label}
                      autocomplete="off"
                    >
                      <option value="">Default</option>
                      {voice.saved && <option value={voice.saved} selected>Saved voice</option>}
                    </select>
                    <Icon name="chevronDown" />
                  </span>
                </div>
              ))
            }
          </div>
        </section>

        <section class="create-group" aria-labelledby="create-window-label">
          <h2 class="section-head" id="create-window-label">Look back</h2>
          <fieldset class="settings-choice create-choice" role="radiogroup" aria-labelledby="create-window-label">
            {
              WINDOWS.map((window) => (
                <label class="settings-segment">
                  <input type="radio" name="window" value={window.value} data-label={window.label} checked={window.value === DEFAULTS.window} />
                  <span>{window.label}</span>
                </label>
              ))
            }
          </fieldset>
        </section>

        <section class="create-group" aria-labelledby="create-tone-label">
          <h2 class="section-head" id="create-tone-label">Tone</h2>
          <fieldset class="settings-choice create-choice" role="radiogroup" aria-labelledby="create-tone-label">
            {
              TONES.map((tone) => (
                <label class="settings-segment">
                  <input type="radio" name="tone" value={tone.value} data-label={tone.label} checked={tone.value === DEFAULTS.tone} />
                  <span>{tone.label}</span>
                </label>
              ))
            }
          </fieldset>
        </section>

        <section class="create-group">
          <h2 class="section-head">
            <label for="create-title">Title <span class="create-optional">(optional)</span></label>
          </h2>
          <input
            class="sheet-input create-title"
            id="create-title"
            name="title"
            type="text"
            maxlength={MAX_TITLE_CHARS}
            autocomplete="off"
            enterkeyhint="done"
          />
        </section>
      </div>
    </details>

    {/* The words are in their own span, so the length can change them without removing the spinner
         that shows while the request is out. */}
    <div class="create-submit">
      <button class="btn-primary" type="submit" data-submit>
        <span class="spinner" aria-hidden="true"></span>
        <span data-submit-text>{submitLabel(startLength)}</span>
      </button>
      <p class="create-error" role="alert" data-error="form" hidden>
        <Icon name="alert" /><span></span>
      </p>
    </div>
  </form>

  {PASSPHRASE_REQUIRED && (
  <dialog class="sheet" data-dialog aria-labelledby="create-dialog-title">
    <div class="sheet-panel">
      <form class="sheet-form" data-dialog-form novalidate>
        <div class="sheet-head">
          <h2 class="sheet-title" id="create-dialog-title">Enter the passphrase</h2>
          <button class="icon-btn press" type="button" data-cancel aria-label="Close">
            <Icon name="close" class="icon-lg" />
          </button>
        </div>
        <p class="sheet-lede">Writing an episode spends from a daily allowance, so it asks for the passphrase.</p>
        <div class="sheet-field">
          <label class="sheet-field-label" for="create-passphrase">Passphrase</label>
          <input
            class="sheet-input"
            id="create-passphrase"
            name="passphrase"
            type="password"
            autocomplete="off"
            autocapitalize="none"
            spellcheck="false"
            enterkeyhint="go"
            autofocus
          />
          <p class="sheet-field-error" role="alert" data-error="dialog" hidden>
            <Icon name="alert" /><span></span>
          </p>
        </div>
        <label class="sheet-check">
          <input type="checkbox" name="remember" />
          <span>Remember on this device</span>
        </label>
        <div class="sheet-actions">
          <button class="btn-primary" type="submit" data-dialog-submit>
            <span class="spinner" aria-hidden="true"></span>
            Create episode
          </button>
        </div>
      </form>
    </div>
  </dialog>
  )}

  <div hidden data-copy>
    {Object.entries(COPY).map(([key, text]) => <p data-k={key}>{text}</p>)}
  </div>
</div>
