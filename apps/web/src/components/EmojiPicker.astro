---
import { menuListClass } from "../design-system/menu";
import Icon from "./Icon.astro";
import SheetHeader from "./SheetHeader.astro";

interface Props {
  id: string;
}

const { id } = Astro.props;
---

{/* The emoji picker (2026-10-21): the More menu's popover (menu.css), a bottom sheet on a
     phone and a popover under the emoji button from 40rem. Only the frame is here; emojiPicker.ts
     fills it when it first opens, with the list fetched then (public/emoji.json), so no page
     carries it. data-picker keeps heroMenu.ts's menu keys and focus rules off it. */}
<div class:list={[menuListClass(), "emoji-picker"]} id={id} popover role="dialog" aria-labelledby={`${id}-title`} data-picker>
  <SheetHeader title="Choose an emoji" titleId={`${id}-title`} close="data-menu-close" />
  <div class="search-wrap emoji-search">
    <label class="search-field">
      <Icon name="search" />
      <span class="sr-only">Search emoji</span>
      <input
        type="search"
        name="q"
        placeholder="Search emoji"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="search"
        data-emoji-q
      />
    </label>
    <button class="search-clear press press-subtle" type="button" aria-label="Clear text" data-emoji-clear hidden>
      <Icon name="close" />
    </button>
  </div>
  <div class="emoji-body" data-emoji-body></div>
</div>
