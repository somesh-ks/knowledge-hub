---
import { FORMAT_LABEL } from "../lib/sourceFilter";
import Icon from "./Icon.astro";
import MultiSelect from "./MultiSelect.astro";

interface Props {
  /** The topics a source can be filed under, in the order the page lists them. */
  topics: { id: string; name: string }[];
}

const { topics } = Astro.props;
---

{/* The Topics and sources panel, kept inert in a template until scripts/topicsPanel.ts clones it: Add
     opens it on Topic, a topic's Add source opens it on Source with that topic chosen, a topic's Edit
     topic opens it on that topic's details, and a source's row opens it to edit that source. It wears the Create sheet's looks (create-sheet.css) and is not
     that sheet: regen-sheet keeps createSheet.ts from taking it for the Create panel. A full-screen
     sheet on a phone and a side panel from 40rem. */}
<template id="topics-panel-template">
  <dialog class="create-sheet regen-sheet topics-panel" aria-labelledby="topics-panel-title" data-mode="topic">
    <div class="create-sheet-head">
      <button class="icon-btn press" type="button" data-panel-close aria-label="Close">
        <Icon name="close" class="icon-lg" />
      </button>
      <h2 class="sheet-title" id="topics-panel-title" data-panel-title>Add a topic</h2>
    </div>
    <div class="create-sheet-body">
      <div class="segmented-nav topics-panel-kind" role="tablist" aria-label="What to add" data-panel-kind>
        <button
          class="segmented-nav-tab"
          type="button"
          role="tab"
          id="topics-panel-tab-topic"
          aria-selected="true"
          aria-controls="topics-panel-pane-topic"
          data-value="topic"
        >
          Topic
        </button>
        <button
          class="segmented-nav-tab"
          type="button"
          role="tab"
          id="topics-panel-tab-source"
          aria-selected="false"
          aria-controls="topics-panel-pane-source"
          tabindex="-1"
          data-value="source"
        >
          Source
        </button>
      </div>

      {/* A topic: its name, what counts and where it plays (D71); its page then suggests sources.
           Adding starts it empty; editing starts it filled, and a built-in topic keeps what counts,
           as fixed questions judge it. */}
      <form class="manage-form topics-pane" id="topics-panel-pane-topic" data-pane="topic" aria-label="Add a topic" novalidate>
        <div class="topics-step">
          <p class="manage-quiet" data-fixed-note hidden>
            The app judges this topic by questions of its own, so what counts stays as it is. Its name
            can change.
          </p>
          <div class="manage-field">
            <label for="panel-topic-name">Name</label>
            <input
              class="manage-input"
              id="panel-topic-name"
              name="name"
              type="text"
              required
              maxlength="60"
              autocomplete="off"
              enterkeyhint="next"
              aria-describedby="panel-topic-name-error"
            />
            <p class="manage-error" id="panel-topic-name-error" role="alert" data-error="name" hidden>
              <Icon name="alert" /><span></span>
            </p>
          </div>
          <div class="manage-field">
            <label for="panel-topic-description">What should count as this topic</label>
            <textarea
              class="manage-input"
              id="panel-topic-description"
              name="description"
              required
              maxlength="400"
              rows="3"
              aria-describedby="panel-topic-description-error"></textarea>
            <p class="manage-error" id="panel-topic-description-error" role="alert" data-error="description" hidden>
              <Icon name="alert" /><span></span>
            </p>
          </div>
          {/* Where a new topic plays (D69); an existing topic sets it on its own page. */}
          <div class="manage-field topics-scope" data-scope>
            <span class="topics-scope-label" id="panel-topic-scope-label">Listen in</span>
            <MultiSelect
              id="panel-topic-scope"
              labelledby="panel-topic-scope-label"
              empty="In no podcast"
              all="All podcasts"
              options={[
                { value: "daily", label: "Daily", checked: true, name: "scope" },
                { value: "weekly", label: "Weekly", checked: true, name: "scope" },
                { value: "custom", label: "Catch up", checked: true, name: "scope" },
              ]}
            />
          </div>
        </div>
      </form>

      {/* A source by its address: looked up as you type, then filed under a topic. */}
      <div class="manage-form source-form topics-pane" id="topics-panel-pane-source" data-pane="source" hidden>
        <div class="manage-field">
          <label for="panel-source-url">Site or feed address</label>
          <input
            class="manage-input"
            id="panel-source-url"
            name="url"
            type="url"
            inputmode="url"
            maxlength="2048"
            autocomplete="off"
            autocapitalize="none"
            spellcheck="false"
            placeholder="example.com"
            aria-describedby="panel-source-url-error"
            data-source-url
          />
          <p class="manage-error" id="panel-source-url-error" role="alert" data-error="url" hidden>
            <Icon name="alert" /><span></span>
          </p>
        </div>
        <div class="manage-field">
          <label for="panel-source-topic">Topic</label>
          <div class="manage-select">
            <select class="manage-input" id="panel-source-topic" name="topic" data-source-topic>
              {topics.map((topic) => <option value={topic.id}>{topic.name}</option>)}
              <option value="" selected>Other</option>
            </select>
            <Icon name="chevronDown" />
          </div>
        </div>
        <div class="manage-field">
          <label for="panel-source-format">Type</label>
          <div class="manage-select">
            <select class="manage-input" id="panel-source-format" name="format" data-source-format>
              {Object.entries(FORMAT_LABEL).map(([value, label]) => <option value={value}>{label}</option>)}
            </select>
            <Icon name="chevronDown" />
          </div>
        </div>
        <div class="source-preview" aria-live="polite" data-source-preview data-state="idle"></div>
        {/* The catalogue's feeds that fit the topic chosen above (topicsPanel.ts), drawn as a topic page's
             Suggested sources are; each + adds it to that topic. Empty for Other, and the box then has nothing to show. */}
        <div class="panel-suggested" data-panel-suggested>
          <h3 class="panel-suggested-head">Suggested sources</h3>
          <ul class="topic-sources" role="list" data-panel-suggested-list></ul>
        </div>
      </div>

      {/* A source already in the list: its name and its topic, where it is, and what its score is made of. */}
      <div class="manage-form topics-pane" data-pane="edit" hidden>
        <div class="manage-field">
          <label for="panel-edit-name">Name</label>
          <input
            class="manage-input"
            id="panel-edit-name"
            name="name"
            type="text"
            maxlength="80"
            autocomplete="off"
            enterkeyhint="done"
            aria-describedby="panel-edit-name-error"
            data-edit-name
          />
          <p class="manage-error" id="panel-edit-name-error" role="alert" data-error="edit-name" hidden>
            <Icon name="alert" /><span>Enter a name.</span>
          </p>
        </div>
        <div class="manage-field">
          <label for="panel-edit-topic">Topic</label>
          <div class="manage-select">
            <select class="manage-input" id="panel-edit-topic" name="topic" data-edit-topic>
              {topics.map((topic) => <option value={topic.id}>{topic.name}</option>)}
              <option value="">Other</option>
            </select>
            <Icon name="chevronDown" />
          </div>
        </div>
        <div class="manage-field">
          <label for="panel-edit-format">Type</label>
          <div class="manage-select">
            <select class="manage-input" id="panel-edit-format" name="format" data-edit-format>
              {Object.entries(FORMAT_LABEL).map(([value, label]) => <option value={value}>{label}</option>)}
            </select>
            <Icon name="chevronDown" />
          </div>
        </div>
        <div class="manage-field" data-edit-lean-field hidden>
          <label for="panel-edit-lean">Political lean</label>
          <div class="manage-select">
            <select class="manage-input" id="panel-edit-lean" name="lean" data-edit-lean>
              <option value="">Unrated</option>
              <option value="-2">Left</option>
              <option value="-1">Centre-left</option>
              <option value="0">Centre</option>
              <option value="1">Centre-right</option>
              <option value="2">Right</option>
            </select>
            <Icon name="chevronDown" />
          </div>
        </div>
        <div class="edit-address">
          <span class="edit-address-label">Address</span>
          <a class="edit-address-link" href="" target="_blank" rel="noopener noreferrer" data-edit-open>
            <span data-edit-host></span>
            <Icon name="openInNew" class="edit-address-icon" />
          </a>
        </div>
        {/* The scorecard: its title and the rating on one line, then what the rating is made of. A
            source with too little history yet shows a quiet empty state instead. */}
        <section class="score-card" aria-labelledby="panel-edit-score" data-edit-score>
          <div class="score-card-head">
            <h3 class="score-card-title" id="panel-edit-score">Scorecard</h3>
            <p class="score-card-rating" data-edit-total></p>
          </div>
          <dl class="score-parts" data-edit-parts>
            <div data-part="health">
              <dt>Health</dt>
              <dd><span class="part-meter" aria-hidden="true"></span><span class="part-num"></span></dd>
            </div>
            <div data-part="quality">
              <dt>Quality</dt>
              <dd><span class="part-meter" aria-hidden="true"></span><span class="part-num"></span></dd>
            </div>
            <div data-part="trust">
              <dt>Trust</dt>
              <dd><span class="part-meter" aria-hidden="true"></span><span class="part-num"></span></dd>
            </div>
          </dl>
          <div class="score-card-empty" data-edit-empty hidden>
            <span class="score-card-empty-art" aria-hidden="true"><Icon name="star" /></span>
            <p class="score-card-empty-title">Not scored yet</p>
            <p class="score-card-empty-line">A score appears once enough of its stories are judged.</p>
          </div>
        </section>
      </div>
    </div>
    <div class="source-sheet-foot topics-panel-foot">
      <button class="btn confirm-delete" type="button" data-panel-delete hidden>Delete source</button>
      <button class="btn-primary" type="button" data-panel-go>Add topic</button>
    </div>
  </dialog>
</template>

{/* What Delete source asks before it deletes (topicsEditor.ts, removeSource): the topic's confirm
     dialog, worn again. It opens over the panel; Cancel returns to it. */}
<dialog class="confirm-dialog" aria-labelledby="source-delete-title" data-source-confirm>
  <div class="confirm-form">
    <h2 class="sheet-title" id="source-delete-title" data-source-confirm-title>Delete source?</h2>
    <div class="confirm-actions">
      <button class="btn" type="button" data-source-cancel autofocus>Cancel</button>
      <button class="btn confirm-delete" type="button" data-source-delete>Delete</button>
    </div>
  </div>
</dialog>

{/* Suggested sources for a topic added before the build gives it a page: scripts/savedView.ts ranks
     the catalogue in the browser, puts this section under the topic's row in the list and fills one
     row per feed, drawn as SuggestedSources.astro draws them on a topic's page. */}
<template id="suggested-template">
  <section class="queued-suggested">
    <h2 class="section-head">Suggested sources</h2>
    <ul class="topic-sources" role="list" data-suggested-sources></ul>
  </section>
  <li class="source-row is-suggested">
    <span class="source-main">
      <span class="source-icon"></span>
      <span class="source-text">
        <span class="source-name"></span>
        <span class="source-meta"><span class="source-host"></span></span>
        <span class="source-line"></span>
      </span>
    </span>
    <button class="source-plus-btn press" type="button">
      <Icon name="plus" class="suggested-plus" />
      <Icon name="check" class="suggested-check" />
    </button>
  </li>
</template>
