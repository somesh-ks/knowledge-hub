---
import { faviconOf } from "../lib/manage";
import { type CatalogSource, cadenceLabel, catalogHost } from "../lib/sourceCatalog";
import { sourceInitial } from "../lib/sourceInitial";
import type { SuggestedAdd } from "../lib/topicText";
import Icon from "./Icon.astro";

interface Props {
  /** The catalogue sources that fit the topic, best first (suggestSources). */
  offers: CatalogSource[];
  /** The topic's name, for what a screen reader says. */
  name: string;
  /** Where a source added here is filed: the topic's id, or a group's home topic. */
  topicId: string;
}

const { offers, name, topicId } = Astro.props;
// What each + button carries, and topicsEditor.ts reads (topicText.ts, SuggestedAdd): the feed it
// sends as source.add, the topic to file it under, and the icon its row shows until the build does.
const adding = (offer: CatalogSource): string =>
  JSON.stringify({
    name: offer.name,
    feed_url: offer.feed_url,
    favicon_url: faviconOf(offer.url ?? offer.feed_url),
    topic_id: topicId,
  } satisfies SuggestedAdd);
---

{/* Feeds from the catalogue that fit the topic, built into the page, so they are there when it is.
     Nothing that fits, no section. A row is a source's row with what is known before it is read: the
     site and what it covers in place of a score, and a button in place of the checkbox. The tile and
     the name are a source's own (SourceRow.astro). Pressing + adds the feed to the topic
     (topicsEditor.ts) and the button shows it is done, in the space it already has. */}
{
  offers.length > 0 && (
    <section class="topic-suggested" aria-labelledby="suggested-head">
      <h2 class="section-head" id="suggested-head">Suggested sources</h2>
      <ul class="topic-sources" role="list" data-suggested-sources aria-label={`Suggested sources for ${name}`}>
        {offers.map((offer) => {
          const icon = faviconOf(offer.url ?? offer.feed_url);
          const cadence = cadenceLabel(offer.cadence);
          return (
            <li class="source-row is-suggested">
              <span class="source-main">
                <span class="source-icon" aria-hidden="true">
                  <span class="source-initial">{sourceInitial(offer.name)}</span>
                  {
                    icon && (
                      <img
                        src={`/api/site-icon?url=${encodeURIComponent(icon)}`}
                        alt=""
                        width="20"
                        height="20"
                        loading="lazy"
                        decoding="async"
                        referrerpolicy="no-referrer"
                        data-favicon
                      />
                    )
                  }
                </span>
                <span class="source-text">
                  <span class="source-name">{offer.name}</span>
                  <span class="source-meta">
                    <span class="source-host">{catalogHost(offer)}</span>
                    {cadence && <span class="source-cadence">{cadence}</span>}
                  </span>
                  {offer.about && (
                    <span class="source-line">
                      <span class="source-about">{offer.about}</span>
                    </span>
                  )}
                </span>
              </span>
              <button
                class="source-plus-btn press"
                type="button"
                aria-label={`Add ${offer.name}`}
                data-suggested-add={adding(offer)}
                data-needs-js
              >
                <Icon name="plus" class="suggested-plus" />
                <Icon name="check" class="suggested-check" />
              </button>
            </li>
          );
        })}
      </ul>
    </section>
  )
}
