---
import { PASSPHRASE_REQUIRED } from "../lib/access";
import Icon from "./Icon.astro";
import "../styles/episode-actions.css";

interface Props {
  /** The episode these actions are about. */
  id: string;
}

const MAX_FEEDBACK_CHARS = 500;

// Every sentence the script can show is here, in the markup, not in the script.
const COPY = {
  empty: "Describe what should change.",
  left: "characters left",
  ...(PASSPHRASE_REQUIRED
    ? {
        passphrase: "Enter the passphrase to continue.",
        "401": "That passphrase does not match. Check it and try again.",
      }
    : {}),
  "400": "That request did not go through. Reload the page and try again.",
  cooldown: "You can do that again in",
  daily_cap: "That's today's limit. Try again in",
  "503": "That is not available right now. Try again in a few minutes.",
  network: "The request did not go through. Check your connection, then try again.",
} as const;
---

{/* The panel and the confirm the header's More menu opens (components/HeroMenu.astro), cloned from
     these templates on the first pick by scripts/episodeActions.ts. */}
{
  [
    ["regenerate", "episode-regenerate-template"],
    ["delete", "episode-delete-template"],
  ].map(([kind, templateId]) => (
    <template id={templateId}>
      {kind === "regenerate" ? (
        <dialog class="create-sheet regen-sheet" aria-labelledby="regen-title">
          <div class="create-sheet-head">
            <button class="icon-btn press" type="button" data-dialog-close aria-label="Close">
              <Icon name="close" class="icon-lg" />
            </button>
            <h2 class="sheet-title" id="regen-title">Regenerate this episode</h2>
          </div>
          <div class="create-sheet-body">
            <form class="regen-form" data-regen-form novalidate>
              <p class="create-hint regen-lede">
                This replaces the episode and keeps its topics, length and format.
              </p>
              <section class="create-group">
                {/* A form label, not a second title under the panel's own. */}
                <label class="sheet-field-label regen-label" for="regen-feedback">
                  What should change?
                </label>
                <textarea
                  class="sheet-input regen-feedback"
                  id="regen-feedback"
                  name="feedback"
                  rows="6"
                  maxlength={MAX_FEEDBACK_CHARS}
                  data-max={MAX_FEEDBACK_CHARS}
                  aria-describedby="regen-count"
                />
                <p class="create-hint regen-count" id="regen-count" data-count aria-live="polite" hidden />
                {PASSPHRASE_REQUIRED && (
                  <div class="sheet-field regen-pass">
                    <label class="sheet-field-label" for="regen-passphrase">Passphrase</label>
                    <input
                      class="sheet-input"
                      id="regen-passphrase"
                      name="passphrase"
                      type="password"
                      autocomplete="off"
                      autocapitalize="none"
                      spellcheck="false"
                    />
                  </div>
                )}
              </section>
              <div class="create-submit">
                <button class="btn-primary" type="submit" data-submit>
                  Regenerate episode
                </button>
                <p class="create-error" role="alert" data-error hidden>
                  <Icon name="alert" /><span />
                </p>
              </div>
            </form>
          </div>
          <div hidden data-copy>
            {Object.entries(COPY).map(([key, text]) => <p data-k={key}>{text}</p>)}
          </div>
        </dialog>
      ) : (
        <dialog class="confirm-dialog" aria-labelledby="delete-title" aria-describedby="delete-lede">
          <form class="confirm-form" data-delete-form novalidate>
            <h2 class="sheet-title" id="delete-title">Delete this episode?</h2>
            <p class="create-hint confirm-lede" id="delete-lede">
              It will be removed from the Library on every device. This cannot be undone.
            </p>
            {PASSPHRASE_REQUIRED && (
              <div class="sheet-field">
                <label class="sheet-field-label" for="delete-passphrase">Passphrase</label>
                <input
                  class="sheet-input"
                  id="delete-passphrase"
                  name="passphrase"
                  type="password"
                  autocomplete="off"
                  autocapitalize="none"
                  spellcheck="false"
                />
              </div>
            )}
            <p class="create-error" role="alert" data-error hidden>
              <Icon name="alert" /><span />
            </p>
            <div class="confirm-actions">
              <button class="btn" type="button" data-dialog-close autofocus>Cancel</button>
              <button class="btn confirm-delete" type="submit" data-submit>Delete</button>
            </div>
          </form>
          <div hidden data-copy>
            {Object.entries(COPY).map(([key, text]) => <p data-k={key}>{text}</p>)}
          </div>
        </dialog>
      )}
    </template>
  ))
}
