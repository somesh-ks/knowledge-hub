---
import Button from "../design-system/Button.astro";
import Dialog from "../design-system/Dialog.astro";
import DialogActions from "../design-system/DialogActions.astro";
import DialogTitle from "../design-system/DialogTitle.astro";
import Field from "../design-system/Field.astro";
import Icon from "../design-system/Icon.astro";
import Sheet from "../design-system/Sheet.astro";
import { briefingChips } from "../lib/briefingChips";
import { topicOptions } from "../lib/createForm";
import { loadManage } from "../lib/manage";
import { isChipOn, type RegenChip } from "../lib/regenTopics";
import "../styles/episode-actions.css";

interface Props {
  /** The episode or briefing these actions are about. */
  id: string;
  /** A briefing regenerates in the Generate sheet, so only its Delete confirm is here. */
  noun?: "episode" | "podcast";
  /** The topic ids the episode or briefing was made with: the chips start ticked from these. */
  selected?: readonly string[];
}

const { noun = "episode", selected = [] } = Astro.props;
// The chips Regenerate offers: the New episode form's list for an episode, the schedule's for a
// briefing, whose dialog (sheets/GenerateSheet.tsx) reads them from the JSON below.
const { sections, topics: manageTopics, sources } = await loadManage();
const chips: RegenChip[] =
  noun === "episode"
    ? topicOptions(sections, manageTopics).map(({ value, label, ids }) => ({ value, label, ids }))
    : briefingChips(manageTopics, sources);
const MAX_FEEDBACK_CHARS = 500;

// Every sentence the script can show is here, in the markup, not in the script.
const COPY = {
  topics: "Pick at least one category.",
  left: "characters left",
  "400": "The server turned that request down. Reload the page and try again.",
  regeneration_limit: "This podcast has been regenerated 3 times, the most it takes.",
  cooldown: "You can do that again in",
  daily_cap: "That's today's limit. Try again in",
  // 401: only the owner's session may do this (D307). A 503 while the sign-in is not set up is the server's problem.
  sign_in: "Sign in to the command center on this device, then try again.",
  // A 5xx: the server logged why, and the reference it sent is added to this (lib/errorRef.ts).
  "503": "The server ran into a problem, so nothing changed.",
  // A 5xx that is not the site's own answer: the function crashed (lib/errorRef.ts).
  crashed:
    "The server crashed before it could answer, so nothing changed. Its log on Vercel has the error.",
  network: "Couldn't reach the site. Check your connection, then try again.",
} as const;
---

{/* The panel and the confirm the header's More menu opens (components/HeroMenu.astro), cloned from
     these templates on the first pick by scripts/episodeActions.ts. */}
{
  [
    ["regenerate", "episode-regenerate-template"],
    ["delete", "episode-delete-template"],
  ]
    .filter(([kind]) => noun === "episode" || kind === "delete")
    .map(([kind, templateId]) => (
    <template id={templateId}>
      {kind === "regenerate" ? (
        <Sheet title="Regenerate this episode" titleId="regen-title" close="data-dialog-close">
            <form class="regen-form" data-regen-form novalidate>
              <p class="create-hint regen-lede">
                This replaces the episode and keeps its length and format.
              </p>
              <section class="create-group" aria-labelledby="regen-topics-label">
                {/* A field label, as Comments is: not a second title under the panel's own. */}
                <div class="sheet-field-label regen-label" id="regen-topics-label">Categories</div>
                <fieldset class="filter-chips" aria-labelledby="regen-topics-label" data-built-topics={manageTopics.map((topic) => topic.id).join(" ")}>
                  {chips.map((chip) => (
                    <label class="filter-chip">
                      <input
                        type="checkbox"
                        name="topic"
                        value={chip.value}
                        data-ids={chip.ids.join(" ")}
                        checked={isChipOn(chip, selected)}
                      />
                      <Icon name="check" class="filter-chip-check" />
                      <span>{chip.label}</span>
                    </label>
                  ))}
                </fieldset>
              </section>
              <section class="create-group">
                {/* A form label, not a second title under the panel's own. */}
                <label class="sheet-field-label regen-label" for="regen-feedback">
                  Comments (optional)
                </label>
                <Field
                  multiline
                  class="regen-feedback"
                  id="regen-feedback"
                  name="feedback"
                  rows="6"
                  maxlength={MAX_FEEDBACK_CHARS}
                  data-max={MAX_FEEDBACK_CHARS}
                  aria-describedby="regen-count"
                />
                <p class="create-hint regen-count" id="regen-count" data-count aria-live="polite" hidden />
              </section>
              <div class="create-submit">
                <Button variant="filled" type="submit" data-submit>
                  Regenerate episode
                </Button>
                <p class="create-error" role="alert" data-error hidden>
                  <Icon name="alert" /><span />
                </p>
              </div>
            </form>
          <div hidden data-copy slot="after">
            {Object.entries(COPY).map(([key, text]) => <p data-k={key}>{text}</p>)}
          </div>
        </Sheet>
      ) : (
        <Dialog aria-labelledby="delete-title" aria-describedby="delete-lede" form={{ "data-delete-form": "", novalidate: true }}>
            <DialogTitle id="delete-title">Delete this {noun}?</DialogTitle>
            <p class="create-hint confirm-lede" id="delete-lede">
              It will be removed from the Library on every device. This cannot be undone.
            </p>
            <p class="create-error" role="alert" data-error hidden>
              <Icon name="alert" /><span />
            </p>
            <DialogActions>
              <Button variant="text" data-dialog-close autofocus>Cancel</Button>
              <Button variant="text" tone="danger" type="submit" data-submit>Delete</Button>
            </DialogActions>
          <div slot="after" hidden data-copy>
            {Object.entries(COPY).map(([key, text]) => <p data-k={key}>{text}</p>)}
          </div>
        </Dialog>
      )}
    </template>
  ))
}

{
  noun === "podcast" && (
    <script
      type="application/json"
      id="regenerate-topics"
      set:html={JSON.stringify({ chips, selected }).replace(/</g, "\\u003c")}
    />
  )
}
