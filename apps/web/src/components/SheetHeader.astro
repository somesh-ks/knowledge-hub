---
import { type SheetClose, sheetHeadHtml } from "../lib/sheetHead";

interface Props {
  /** The sheet's name: an h2 whose id the dialog's aria-labelledby names. */
  title: string;
  titleId: string;
  /** The data attribute the sheet's script finds its Close button by. */
  close: SheetClose;
  /** Any data attribute the title carries for its script, such as data-panel-title. */
  titleData?: Record<`data-${string}`, string | boolean>;
}

const { title, titleId, close, titleData = {} } = Astro.props;
---

{/* The row's markup is sheetHead.ts, shared with the lists a script redraws (structureView.ts), so
     every sheet header is one markup: the title at the start, Close at the end (2026-10-20). */}
<Fragment set:html={sheetHeadHtml(title, titleId, close, titleData)} />
