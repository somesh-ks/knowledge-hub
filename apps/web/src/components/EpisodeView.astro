---
import { paletteAccent } from "@dispatch/cover";
import { episodeHighlights } from "../lib/episodeHighlights";
import { type EpisodeEntry, episodeLength, FORMAT_LABELS } from "../lib/episodes";
import { longDate } from "../lib/format";
import AmbientLight from "./AmbientLight.astro";
import Cover from "./Cover.astro";
import EpisodeActions from "./EpisodeActions.astro";
import HeroMenu from "./HeroMenu.astro";
import Icon from "./Icon.astro";
import PlayCta from "./PlayCta.astro";
import PlayerData from "./PlayerData.astro";
import "../styles/episode.css";

interface Props {
  entry: EpisodeEntry;
}

const { entry } = Astro.props;
const { episode } = entry;
const length = episodeLength(episode);
// "7 October": the long date without its weekday.
const day = longDate(episode.date).split(" ").slice(1).join(" ");
const highlights = episodeHighlights(episode);
---

<main
  id="main"
  tabindex="-1"
  data-digest-id={entry.id}
  data-digest-date={episode.date}
  data-latest="false"
>
  <header class="hero">
    <AmbientLight palette={entry.cover.palette} />
    <Cover
      digestId={entry.id}
      size="hero"
      paletteBg={paletteAccent(entry.cover.palette).bg}
      weekly={false}
      priority
    />
    <div class="hero-text">
      <h1 class="page-title" id="page-title" tabindex="-1">{episode.title}</h1>
      <p class="meta hero-facts"><span>{FORMAT_LABELS[episode.format]}</span><span>{day}</span></p>
    </div>
    <HeroMenu sharePath={`/e/${entry.id}`} noun="episode" episodeId={entry.id} />
    {/* The same path a briefing takes: audio is made when Play is pressed, one turn at a time. */}
    <PlayCta digestId={entry.id} mode="preparing" length={length} noun="episode" />
  </header>

  <EpisodeActions id={entry.id} />

  {/* The script is read in the player. The page is for the news itself: each story the episode
       covers, what was said about it, and the way to the source. */}
  {
    highlights.length > 0 && (
      <section class="episode-block" aria-labelledby="episode-highlights-title">
        <h2 class="section-head" id="episode-highlights-title">Highlights</h2>
        <ul class="rows episode-highlights" role="list">
          {highlights.map((highlight) => (
            <li class="episode-highlight">
              <h3 class="episode-highlight-title">{highlight.headline}</h3>
              {highlight.text && <p class="episode-highlight-text">{highlight.text}</p>}
              {/* Named as a story's source link is (Item.astro): the name starts with the host shown. */}
              {highlight.host && (
                <a
                  class="source-link episode-highlight-link"
                  href={highlight.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>{highlight.host}</span><span class="sr-only"> (opens in a new tab)</span>
                  <Icon name="openInNew" />
                </a>
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  }
  <PlayerData data={entry.player} />
</main>

<script>
  // Shared with the briefing pages: it shares the page's address.
  void import("../scripts/briefingPage");
  import { installEpisodeActions } from "../scripts/episodeActionsEntry";

  installEpisodeActions();
</script>
