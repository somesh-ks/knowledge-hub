---
import { OPEN_PASSPHRASE, PASSPHRASE_REQUIRED } from "../lib/access";
import Icon from "./Icon.astro";
import MenuSheet from "./MenuSheet.astro";

interface Props {
  /** Where Share points. A briefing's dated address, or the episode's own. */
  sharePath: string;
  /** Set on an episode page: Regenerate and Delete then act on this episode. */
  episodeId?: string;
  /** Set on a briefing page: Regenerate replaces this digest and Delete removes it. */
  briefingId?: string;
  /** False on a Daily or Weekly briefing: only on-demand briefings and episodes can be deleted. */
  deletable?: boolean;
}

const { sharePath, episodeId, briefingId, deletable = true } = Astro.props;
---

{/* One More button beside the title and the small menu it opens: Share, Regenerate and Delete, on a
     briefing and on an episode alike. The menu is a native popover, so light dismiss and Escape are
     the browser's; scripts/heroMenu.ts adds the arrow keys and focus. Share shares the dated
     address, so a link sent from today's page still opens this briefing next week. On an episode
     Regenerate opens the rewrite panel (scripts/episodeActionsEntry.ts); on a briefing it opens the
     Generate sheet, which sends this digest's id so the new one replaces it. Delete opens the
     confirm on both. The items wait, with a reason, while a run for this episode is going. */}
<div
  class="hero-menu"
  data-share-host
  data-episode-actions=""
  data-episode={episodeId}
  data-briefing={briefingId}
  data-open-passphrase={!PASSPHRASE_REQUIRED ? OPEN_PASSPHRASE : undefined}
>
  <button
    class="icon-btn hero-more press"
    type="button"
    aria-label="More actions"
    aria-haspopup="menu"
    popovertarget="hero-menu"
    data-hero-more
  >
    <Icon name="moreVert" class="more-icon" />
    <Icon name="check" class="more-done" />
  </button>
  <MenuSheet id="hero-menu" title="More actions">
    <button class="hero-menu-item" type="button" role="menuitem" data-share={sharePath}>
      <Icon name="shareArrow" />Share
    </button>
    {
      episodeId ? (
        <button
          class="hero-menu-item"
          type="button"
          role="menuitem"
          data-episode-action="regenerate"
        >
          <Icon name="refresh" />Regenerate
        </button>
      ) : (
        <button
          class="hero-menu-item"
          type="button"
          role="menuitem"
          data-open="generate"
          aria-haspopup="dialog"
        >
          <Icon name="refresh" />Regenerate
        </button>
      )
    }
    {
      deletable && (
        <button
          class="hero-menu-item hero-menu-delete"
          type="button"
          role="menuitem"
          data-episode-action="delete"
        >
          <Icon name="trash" />Delete
        </button>
      )
    }
  </MenuSheet>
  <span class="sr-only" role="status" data-share-status></span>
  {
    episodeId && (
      <span class="sr-only" id="episode-actions-busy" hidden>
        Unavailable while this episode is being updated.
      </span>
    )
  }
</div>
