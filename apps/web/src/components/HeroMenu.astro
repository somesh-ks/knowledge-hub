---
import { regenerationHint } from "../lib/regenerations";
import Icon from "./Icon.astro";
import MenuSheet from "./MenuSheet.astro";

interface Props {
  /** Set on an episode page: Regenerate and Delete then act on this episode. */
  episodeId?: string;
  /** Set on a briefing page: Regenerate replaces this digest and Delete removes it. */
  briefingId?: string;
  /** False on a Daily or Weekly briefing: only on-demand briefings and episodes can be deleted. */
  deletable?: boolean;
  /** Times this podcast was regenerated, for the Regenerate item's counter (D212). */
  regenerations?: number | undefined;
  /**
   * The page itself, so Download and Add to queue sit in the menu as they do in the Library row's
   * (LibraryItemMenu.astro; scripts/libraryMenu.ts wires them). `audio` is the file to download;
   * without it only Add to queue is offered.
   */
  page?: { id: string; title: string; path: string; audio?: string | undefined };
}

const { episodeId, briefingId, deletable = true, regenerations, page } = Astro.props;
const regen = regenerationHint(regenerations);
---

{/* One More button beside the title and the small menu it opens: Download, Add to queue, Regenerate
     and Delete, on a briefing and on an episode alike, in the order of the Library row's menu (Share
     sits beside Play, PlayCta.astro; Stop sharing is in the Library's row menu only). The menu is a native popover, so light dismiss and Escape are
     the browser's; scripts/heroMenu.ts adds the arrow keys and focus. On an episode
     Regenerate opens the rewrite panel (scripts/episodeActionsEntry.ts); on a briefing it opens the
     Generate sheet, which sends this digest's id so the new one replaces it. Delete opens the
     confirm on both. The items wait, with a reason, while a run for this episode is going. */}
<div
  class="hero-menu"
  data-share-host
  data-episode-actions=""
  data-episode={episodeId}
  data-briefing={briefingId}
  data-page-menu={page ? "" : undefined}
  data-id={page?.id}
  data-path={page?.path}
  data-title={page?.title}
  data-audio={page?.audio}
>
  <button
    class="icon-btn hero-more press"
    type="button"
    aria-label="More actions"
    aria-haspopup="menu"
    popovertarget="hero-menu"
    data-hero-more
  >
    <Icon name="moreVert" class="more-icon" />
    <Icon name="check" class="more-done" />
  </button>
  <MenuSheet id="hero-menu" title="More actions">
    {
      page?.audio && (
        <button class="hero-menu-item" type="button" role="menuitem" data-menu="download">
          <Icon name="download" class="dl-add" /><Icon name="downloadRemove" class="dl-remove" /><span data-menu-label>Download</span>
        </button>
      )
    }
    {
      page && (
        <button class="hero-menu-item" type="button" role="menuitem" data-menu="queue">
          <Icon name="queueAdd" />Add to queue
        </button>
      )
    }
    {
      episodeId ? (
        <button
          class="hero-menu-item"
          type="button"
          role="menuitem"
          data-episode-action="regenerate"
          title={regen.title}
          disabled={regen.exhausted}
        >
          <Icon name="refresh" />Regenerate
        </button>
      ) : (
        <button
          class="hero-menu-item"
          type="button"
          role="menuitem"
          data-open="generate"
          aria-haspopup="dialog"
          title={regen.title}
          disabled={regen.exhausted}
        >
          <Icon name="refresh" />Regenerate
        </button>
      )
    }
    {
      deletable && (
        <button
          class="hero-menu-item hero-menu-delete"
          type="button"
          role="menuitem"
          data-episode-action="delete"
        >
          <Icon name="trash" />Delete
        </button>
      )
    }
  </MenuSheet>
  <span class="sr-only" role="status" data-share-status></span>
  {
    episodeId && (
      <span class="sr-only" id="episode-actions-busy" hidden>
        Unavailable while this episode is being updated.
      </span>
    )
  }
</div>
