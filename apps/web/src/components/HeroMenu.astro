---
import Icon from "../design-system/Icon.astro";
import Menu from "../design-system/Menu.astro";
import PodcastMenuItems from "./PodcastMenuItems.astro";

interface Props {
  /** Set on an episode page: Regenerate and Delete then act on this episode. */
  episodeId?: string;
  /** Set on a briefing page: Regenerate replaces this digest and Delete removes it. */
  briefingId?: string;
  /** The minutes a briefing aired at: Regenerate starts on the nearest length (lib/regenLength.ts). */
  minutes?: number;
  /** False on a Daily or Weekly briefing: only on-demand briefings and episodes can be deleted. */
  deletable?: boolean;
  /** Times this podcast was regenerated, for the Regenerate item's counter (D212). */
  regenerations?: number | undefined;
  /**
   * The page's podcast: its sheet is the Library card's (PodcastMenuItems.astro, D369), headed by its
   * name and the card's facts line. `audio` is the file to download; without it Download is left out.
   */
  page: {
    id: string;
    title: string;
    subtitle?: string | undefined;
    path: string;
    audio?: string | undefined;
  };
}

const { episodeId, briefingId, minutes, deletable = true, regenerations, page } = Astro.props;
---

{/* One More button beside the title and the sheet it opens: the podcast's one sheet, the same a
     Library card's hold opens (PodcastMenuItems.astro, D369), headed by its name and facts. The menu
     is a native popover, so light dismiss and Escape are the browser's; scripts/heroMenu.ts adds the
     arrow keys and focus. On an episode Regenerate opens the rewrite panel
     (scripts/episodeActionsEntry.ts); on a briefing it opens the Generate sheet, which sends this
     digest's id so the new one replaces it. Delete opens the confirm on both. The items wait, with a
     reason, while a run for this episode is going. */}
<div
  class="hero-menu"
  data-share-host
  data-episode-actions=""
  data-episode={episodeId}
  data-briefing={briefingId}
  data-minutes={briefingId ? minutes : undefined}
  data-page-menu=""
  data-id={page.id}
  data-path={page.path}
  data-title={page.title}
  data-audio={page.audio}
>
  <button
    class="icon-btn hero-more press"
    type="button"
    aria-label="More actions"
    aria-haspopup="menu"
    popovertarget="hero-menu"
    data-hero-more
  >
    <Icon name="moreVert" class="more-icon" />
    <Icon name="check" class="more-done" />
  </button>
  <Menu id="hero-menu" title={page.title} subtitle={page.subtitle}>
    <PodcastMenuItems
      id={page.id}
      kind={episodeId ? "episode" : "briefing"}
      place="page"
      audio={page.audio}
      deletable={deletable}
      regenerations={regenerations}
    />
  </Menu>
  <span class="sr-only" role="status" data-share-status></span>
  {
    episodeId && (
      <span class="sr-only" id="episode-actions-busy" hidden>
        Unavailable while this episode is being updated.
      </span>
    )
  }
</div>
