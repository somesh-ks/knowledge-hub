---
import Icon from "./Icon.astro";
import MenuSheet from "./MenuSheet.astro";

interface Props {
  /** Set on an episode page: Regenerate and Delete then act on this episode. */
  episodeId?: string;
  /** Set on a briefing page: Regenerate replaces this digest and Delete removes it. */
  briefingId?: string;
  /** False on a Daily or Weekly briefing: only on-demand briefings and episodes can be deleted. */
  deletable?: boolean;
}

const { episodeId, briefingId, deletable = true } = Astro.props;
// Share sits beside Play (PlayCta.astro); Stop sharing shows here once this device made a link.
const shareId = episodeId ?? briefingId;
---

{/* One More button beside the title and the small menu it opens: Regenerate and Delete, on a
     briefing and on an episode alike, and Stop sharing once this device shared it (Share itself
     sits beside Play, PlayCta.astro). The menu is a native popover, so light dismiss and Escape are
     the browser's; scripts/heroMenu.ts adds the arrow keys and focus. On an episode
     Regenerate opens the rewrite panel (scripts/episodeActionsEntry.ts); on a briefing it opens the
     Generate sheet, which sends this digest's id so the new one replaces it. Delete opens the
     confirm on both. The items wait, with a reason, while a run for this episode is going. */}
<div
  class="hero-menu"
  data-share-host
  data-episode-actions=""
  data-episode={episodeId}
  data-briefing={briefingId}
>
  <button
    class="icon-btn hero-more press"
    type="button"
    aria-label="More actions"
    aria-haspopup="menu"
    popovertarget="hero-menu"
    data-hero-more
  >
    <Icon name="moreVert" class="more-icon" />
    <Icon name="check" class="more-done" />
  </button>
  <MenuSheet id="hero-menu" title="More actions">
    {
      shareId && (
        <template data-share-stop-template>
          <button class="hero-menu-item" type="button" role="menuitem" data-share-stop={shareId}>
            <Icon name="blocked" />Stop sharing
          </button>
        </template>
      )
    }
    {
      episodeId ? (
        <button
          class="hero-menu-item"
          type="button"
          role="menuitem"
          data-episode-action="regenerate"
        >
          <Icon name="refresh" />Regenerate
        </button>
      ) : (
        <button
          class="hero-menu-item"
          type="button"
          role="menuitem"
          data-open="generate"
          aria-haspopup="dialog"
        >
          <Icon name="refresh" />Regenerate
        </button>
      )
    }
    {
      deletable && (
        <button
          class="hero-menu-item hero-menu-delete"
          type="button"
          role="menuitem"
          data-episode-action="delete"
        >
          <Icon name="trash" />Delete
        </button>
      )
    }
  </MenuSheet>
  <span class="sr-only" role="status" data-share-status></span>
  {
    episodeId && (
      <span class="sr-only" id="episode-actions-busy" hidden>
        Unavailable while this episode is being updated.
      </span>
    )
  }
</div>
