---
import type { SectionView } from "../lib/digestView";
import Chapter from "./Chapter.astro";
import Item from "./Item.astro";
import SectionTabs from "./SectionTabs.astro";

interface Props {
  sections: SectionView[];
  hasAudio: boolean;
}

const { sections, hasAudio } = Astro.props;
---

{/* The tabs live inside this wrapper so they stay stuck for the sections and let go after the last
     one (SectionTabs.astro). */}
<div class="briefing" id="briefing">
  <SectionTabs sections={sections} />
  {
    sections.map((section) => (
      <Chapter section={section}>
        {section.items.map(({ item, index: itemIndex, length }) => (
          <Item item={item} index={itemIndex} length={length} hasAudio={hasAudio} />
        ))}
      </Chapter>
    ))
  }
</div>
