---
import type { SectionView } from "../lib/digestView";
import Chapter from "./Chapter.astro";
import Item from "./Item.astro";

interface Props {
  sections: SectionView[];
  hasAudio: boolean;
}

const { sections, hasAudio } = Astro.props;
---

{/* The tabs live inside this wrapper so they stay stuck for the sections and let go after the last
     one. Server-rendered and complete without script: the tabs are plain links to the sections, and
     briefingPage.ts only moves the mark to the section in view. */}
<div class="briefing" id="briefing">
  <nav class="tabs" aria-label="Sections" data-section-tabs>
    {
      sections.map((section, index) => (
        <a
          class="tab"
          href={`#c-${section.slug}`}
          data-section={section.slug}
          aria-current={index === 0 ? "true" : undefined}
        >
          {section.title}
        </a>
      ))
    }
  </nav>
  {
    sections.map((section, index) => (
      <Chapter section={section} isFirst={index === 0}>
        {section.items.map(({ item, index: itemIndex, length }) => (
          <Item item={item} index={itemIndex} length={length} hasAudio={hasAudio} />
        ))}
      </Chapter>
    ))
  }
</div>
