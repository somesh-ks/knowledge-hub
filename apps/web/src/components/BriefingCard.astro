---
import type { DigestEntry } from "../lib/digests";
import { longDate, longDateTitle } from "../lib/format";
import { FACT_SEPARATOR } from "../lib/library";
import { cardFacts } from "../lib/libraryCard";
import Cover from "./Cover.astro";
import CoverPlay from "./CoverPlay.astro";

interface Props {
  entry: DigestEntry;
  /** The first row of a grid loads its covers at once; the rest wait until they are near. */
  priority?: boolean;
}

const { entry, priority = false } = Astro.props;
const { digest } = entry;
const facts = cardFacts(entry);
// Kind, story count, length: the count is its own span, so the narrow shelf on Today can leave it out,
// and the length is its own, so "Played" can take its place without touching the kind.
const segments = facts.line.split(FACT_SEPARATOR);
const length = segments.length > 1 ? segments.at(-1) : undefined;
const [kind, count] = segments.slice(0, -1);
const hasCount = segments.length > 2;
---

{/* One briefing as album art: the cover, its date, and one quiet line. The whole card is the link.
     The data attributes are what the Library's search, sort and filter read. A weekly briefing's
     kind is a part of its own in the quiet line, so the list, whose meta line names the kind, can
     leave it out; search rewrites only the rest. */}
<li
  class="card"
  data-card
  data-date={digest.date}
  data-id={entry.id}
  data-kind={digest.kind}
  data-stories={digest.items.length}
  data-minutes={facts.minutes}
  data-audio={entry.audioMode === "ready" ? "" : undefined}
  data-search={facts.search}
  data-meta-lines={facts.metaLines}
>
  <a class="card-link" href={`/d/${entry.id}`} data-astro-prefetch="hover">
    <Cover
      digestId={entry.id}
      size="card"
      source={digest}
      weekly={digest.kind === "weekly"}
      priority={priority}
    />
    {/* A half-heard item: a bar along the bottom of the art, on its own track, so it reads on any cover. */}
    <span class="card-progress" data-cover-progress aria-hidden="true" hidden></span>
    <span class="card-title">{longDateTitle(digest.date)}</span>
    <span class="card-sub">
      <span class="card-facts" data-card-facts data-rest={facts.line}>{length === undefined ? facts.line : <Fragment>{kind}{hasCount && <span class="card-count">{FACT_SEPARATOR}{count}</span>}{FACT_SEPARATOR}<span data-card-length>{length}</span></Fragment>}</span>
    </span>
  </a>
  <CoverPlay digestId={entry.id} href={`/d/${entry.id}`} title={longDate(digest.date)} />
</li>
