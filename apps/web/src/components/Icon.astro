---
import { ICON_PATHS, ICON_VIEW_BOX, type IconName } from "../lib/icons";

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = "" } = Astro.props;
const classes = ["icon", className].filter(Boolean).join(" ");
---

<svg class={classes} data-icon={name} viewBox={ICON_VIEW_BOX} aria-hidden="true" focusable="false"><path d={ICON_PATHS[name]}></path></svg>
