{/* The one primary action below 64rem: a floating button above the bottom bar and the player bar.
     A link to /create, so it works without script; the shell turns it into the sheet. From 64rem
     the side column carries the same action as a button, and this one is not shown. */}
<a class="create-fab press" href="/create" aria-label="Create a podcast" data-create-open>
  <Icon name="plus" class="icon-lg" />
</a>
