---
import type { SectionRef } from "../lib/sectionLabel";

interface Props {
  sections: readonly SectionRef[];
}

const { sections } = Astro.props;
---

{/* The section tabs of a briefing or an episode, drawn only for two sections or more: one would only
     name the heading under it (owner, 2026-10-24). Plain links to the sections, complete without
     script; briefingPage.ts moves the mark to the section in view. The bar sticks and draws the
     surface; the strip inside it scrolls and fades its ends (primitives.css). Placed inside the
     wrapper of the sections (.briefing), so it lets go after the last one. */}
{
  sections.length > 1 && (
    <div class="tabs-bar" data-tabs-bar>
      <nav class="tabs" aria-label="Sections" data-section-tabs>
        {sections.map((section, index) => (
          <a
            class="tab"
            href={`#c-${section.slug}`}
            data-astro-history="replace"
            data-section={section.slug}
            aria-current={index === 0 ? "true" : undefined}
          >
            {section.title}
          </a>
        ))}
      </nav>
    </div>
  )
}
