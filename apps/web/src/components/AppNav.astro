---
import { buildDay } from "../lib/buildDay";
import type { IconName } from "../lib/icons";
import { getSite } from "../lib/site";
import BrandMark from "./BrandMark.astro";
import Icon from "./Icon.astro";
import QueueRing from "./QueueRing.astro";

export type Destination = "today" | "library" | "settings";

interface Props {
  /** The destination this page belongs to, or null when it belongs to none of them. */
  current: Destination | null;
}

const { current } = Astro.props;
// The wordmark goes to Today: it names the briefing only when there is one.
const homeLabel =
  (await getSite()).entries.length > 0 ? "Singularity, latest podcast" : "Singularity, Latest";
// On the Create page the New episode button is the place you are on, not an action to take.
const onCreate = Astro.url.pathname.replace(/\/$/, "") === "/create";

const destinations: Array<{
  id: Destination;
  href: string;
  label: string;
  icon: IconName;
  iconCurrent: IconName;
}> = [
  // A bolt, not a flame (owner, 2026-10-23): Latest is what is new now.
  { id: "today", href: "/", label: "Latest", icon: "lightning", iconCurrent: "lightningFill" },
  {
    id: "library",
    href: "/library",
    label: "Library",
    icon: "library",
    iconCurrent: "libraryFill",
  },
  {
    id: "settings",
    href: "/settings",
    label: "Settings",
    icon: "settings",
    iconCurrent: "settingsFill",
  },
];
---

{/* One navigation, two shapes: a bottom bar below 64rem and a side column from 64rem. The player
     slides the bottom bar away as it opens; it finds it by data-bottom-nav. Create is not a
     destination but the one action: a tonal button that hugs its words in the column here, a floating button (see
     CreateFab.astro) below 64rem. Both are links to /create that the shell turns into the sheet. */}
<nav class="app-nav" aria-label="Primary" data-bottom-nav>
  <a class="app-nav-brand wordmark" href="/" aria-label={homeLabel} data-astro-prefetch="hover">
    <BrandMark />
    <span>Singularity</span>
  </a>
  <a class="app-nav-create btn-action-tonal" href="/create" data-create-open data-sound="open" aria-current={onCreate ? "page" : undefined}>
    <Icon name="plus" class="icon-lg" />
    <span>Catch up</span>
  </a>
  <ul class="app-nav-list" role="list">
    {
      destinations.map((destination) => {
        const isCurrent = destination.id === current;
        return (
          <li>
            <a
              class="app-nav-item"
              href={destination.href}
              aria-current={isCurrent ? "page" : undefined}
              data-astro-prefetch="hover"
            >
              {/* Both drawings are in the page, so the item can light up on the press, before its page arrives.
                   The indicator is the pill behind the icon in the bottom bar; the side column draws the row itself. */}
              <span class="app-nav-indicator">
                <Icon name={destination.icon} class="icon-lg app-nav-icon-rest" />
                <Icon name={destination.iconCurrent} class="icon-lg app-nav-icon-current" />
              </span>
              <span>{destination.label}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
  {/* The foot of the side column; a phone shows the build's day on Settings instead, and the queue as
       a dock above the bar (Queue.astro). The row shows once something has been made today, and
       opens the podcast queue beside the column: a ring while it goes, a check once it is done. */}
  <div class="app-nav-foot">
    <p class="app-nav-updated">Updated {buildDay()}</p>
    <button class="app-nav-item app-nav-queue" type="button" popovertarget="queue-pop" aria-haspopup="dialog" data-queue-trigger hidden>
      <span class="app-nav-indicator">
        <QueueRing class="queue-ring-nav" data-queue-trigger-ring>
          <span class="queue-stage-icon" data-queue-stage-icon="nav"></span>
        </QueueRing>
      </span>
      <span class="app-nav-queue-title queue-word" data-queue-trigger-title></span>
    </button>
  </div>
</nav>
