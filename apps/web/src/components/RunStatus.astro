---
import { UPDATING_LABEL } from "../lib/runStages";
import Icon from "./Icon.astro";

// Every line the indicator shows. scripts/runStatus.ts reads them from the element's data
// attributes, so the script carries no copy.
const lines = {
  "data-queued": "Episode queued",
  "data-running": "Writing your episode",
  "data-done": "Episode ready",
  "data-started": "Still being made. It will appear in your Library.",
  "data-failed": "Couldn't make the episode",
  // The stage names come from the status route (lib/runStages.ts); these are the sentences around them.
  "data-failed-stage": "Stopped while {label}",
  "data-updating": UPDATING_LABEL,
  "data-open": "Open episode",
  // A rewrite or a removal of an episode that exists: data-<kind>-<state>.
  "data-regenerate-queued": "Rewrite queued",
  "data-regenerate-running": "Rewriting your episode",
  // The workflow has published; the site is redeployed about a minute later, so the page still shows
  // the old version until then.
  "data-regenerate-done": "Rewritten. Live in about a minute.",
  "data-regenerate-started": "Still being rewritten. The new version will replace it.",
  "data-regenerate-failed": "Couldn't rewrite the episode",
  "data-delete-queued": "Removal queued",
  "data-delete-running": "Removing the episode",
  "data-delete-done": "Episode removed",
  "data-delete-started": "Still being removed. It will leave your Library.",
  "data-delete-failed": "Couldn't remove the episode",
  // Try again: on the button while the request is out, and what a refusal of it says instead of the
  // failure ({wait} is the server's own wait).
  "data-starting": "Starting…",
  "data-retry-cooldown": "You can make another episode in {wait}.",
  "data-retry-daily_cap": "That's today's limit. Try again in {wait}.",
  "data-retry-503": "Episodes are not available right now. Try again in a few minutes.",
  "data-retry-400": "That request did not go through. Reload the page and try again.",
  "data-retry-network": "The request did not go through. Check your connection, then try again.",
  // The Create form and the New episode buttons say this while a run is still going (createPage.ts).
  "data-busy-create": "An episode is still being made. You can start another when it's ready.",
};
---

{/* The progress of a Create run, out of the way: at the foot of the side column from 64rem, above the
     player bar below it. Persisted across navigations, so what the script put in it is still there on
     the next page. The card inside appears with the first run. The status region is a hidden node of
     its own that holds only the line, so a change of a button's words is not read with it. */}
<div class="run-status" data-run-status transition:persist="run-status" {...lines}>
  <span class="sr-only" role="status" data-run-announce></span>
  <div class="run-card" data-run-card hidden>
    <p class="run-text">
      <Icon name="alert" class="run-alert" />
      <Icon name="check" class="run-ok" />
      <span class="run-message" data-run-text></span>
    </p>
    <a class="run-link" href="/library" data-run-library hidden>Open Library</a>
    <button class="btn run-retry" type="button" data-run-retry hidden>Try again</button>
    <button class="icon-btn run-dismiss press" type="button" data-run-dismiss aria-label="Dismiss" hidden>
      <Icon name="close" class="icon-lg" />
    </button>
    <span class="run-bar" aria-hidden="true"><span class="run-fill"></span></span>
  </div>
</div>
