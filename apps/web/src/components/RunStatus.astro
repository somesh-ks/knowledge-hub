---
import { UPDATING_LABEL } from "../lib/runStages";
import Icon from "./Icon.astro";

// Every line the indicator shows. scripts/runStatus.ts reads them from the element's data
// attributes, so the script carries no copy.
const lines = {
  "data-queued": "Episode queued",
  "data-running": "Writing your episode",
  "data-done": "Episode ready",
  // Polling ran out: the page cannot tell where the run is. Check again asks once more.
  "data-started": "Lost track of this run",
  // Time left, from the status route's stage estimates ({n} is whole minutes); with none, the stage name stands alone.
  "data-eta": "About {n} min left",
  "data-slow": "Taking longer than usual",
  "data-failed": "Couldn't make the episode",
  // A run the person stopped from the generations list: not an error, so it only says so.
  "data-cancelled": "Cancelled",
  // On the strip's Cancel: while the request is out, and after a refusal.
  "data-cancelling": "Cancelling\u2026",
  "data-cancel-failed": "Couldn't cancel. Try again.",
  // The stage names come from the status route (lib/runStages.ts); these are the sentences around them.
  "data-failed-stage": "Stopped while {label}",
  "data-updating": UPDATING_LABEL,
  "data-open": "Open episode",
  // A rewrite or a removal of an episode that exists: data-<kind>-<state>.
  "data-regenerate-queued": "Rewrite queued",
  "data-regenerate-running": "Rewriting your episode",
  // The workflow has published; the site is redeployed about a minute later, so the page still shows
  // the old version until then.
  "data-regenerate-done": "Rewritten. Live in about a minute.",
  "data-regenerate-started": "Lost track of this rewrite",
  "data-regenerate-failed": "Couldn't rewrite the episode",
  "data-delete-queued": "Removal queued",
  "data-delete-running": "Removing the episode",
  "data-delete-done": "Episode removed",
  "data-delete-started": "Lost track of this removal",
  "data-delete-failed": "Couldn't remove the episode",
  // Try again: on the button while the request is out, and what a refusal of it says instead of the
  // failure ({wait} is the server's own wait).
  "data-starting": "Starting…",
  "data-retry-cooldown": "You can make another episode in {wait}.",
  "data-retry-briefing-cooldown": "You can make another podcast in {wait}.",
  "data-retry-429": "Too many requests just now. Try again in {wait}.",
  "data-retry-daily_cap": "That's today's limit. Try again in {wait}.",
  // A 5xx: the server logged why, and the reference it sent is added to this (lib/errorRef.ts).
  "data-retry-503": "The server ran into a problem, so nothing was started.",
  "data-retry-crashed":
    "The server crashed before it could answer, so nothing changed. Its log on Vercel has the error.",
  "data-retry-400": "The server turned that request down. Reload the page and try again.",
  "data-retry-network": "Couldn't reach the site. Check your connection, then try again.",
  // A briefing (Regenerate) rides the same card: data-briefing-<state>, and its stage names come
  // from the status route like an episode's (lib/runStages.ts). A nothing or a gated run is a done
  // one with its own sentence; a failed one names its step (briefingFailureLine).
  "data-briefing-queued": "Waiting for a slot",
  "data-briefing-running": "Making your podcast",
  "data-briefing-done": "Podcast ready",
  "data-briefing-nothing": "Nothing cleared the bar, so the podcast stays as it was.",
  "data-briefing-gated": "The schedule held this run back.",
  "data-briefing-failed": "Couldn't make the podcast",
  "data-open-briefing": "Open podcast",
  // The Create form and the New episode buttons say this while a run is still going (createPage.ts).
  "data-busy-create": "An episode is still being made. You can start another when it's ready.",
  "data-busy-briefing": "A podcast is still being made. You can start another when it's ready.",
};
---

{/* The progress of a Create run, out of the way: at the foot of the side column from 64rem, above the
     player bar below it. Persisted across navigations, so what the script put in it is still there on
     the next page. The card inside appears with the first run. The status region is a hidden node of
     its own that holds only the line, so a change of a button's words is not read with it. */}
<div class="run-status" data-run-status transition:persist="run-status" {...lines}>
  <span class="sr-only" role="status" data-run-announce></span>
  <div class="run-card" data-run-card hidden>
    <p class="run-text">
      <Icon name="alert" class="run-alert" />
      <Icon name="check" class="run-ok" />
      <span class="run-lines">
        <span class="run-message" data-run-text></span>
        <span class="run-eta" data-run-eta hidden></span>
      </span>
    </p>
    {/* Below 64rem the strip is one slim line; this opens it to the whole status. */}
    <button class="icon-btn run-expand press" type="button" data-run-expand aria-expanded="false" aria-label="Show the whole status">
      <Icon name="chevronDown" class="icon-lg" />
    </button>
    <a class="run-link" href="/library" data-run-library hidden>Open Library</a>
    <a class="text-link run-details" href="#" data-run-log target="_blank" rel="noopener noreferrer" hidden>Details</a>
    <button class="btn run-retry" type="button" data-run-retry hidden>Try again</button>
    <button class="btn run-check" type="button" data-run-check hidden>Check again</button>
    {/* A run that is going can be stopped here, and the strip opens the whole list when more than one is
         going (scripts/generations.ts shows them). */}
    <button class="btn run-cancel" type="button" data-run-cancel hidden>Cancel</button>
    <button class="btn run-queue" type="button" popovertarget="generations" data-run-queue hidden>All generations</button>
    <button class="btn-primary run-play" type="button" data-run-play hidden>Listen now</button>
    <button class="icon-btn run-dismiss press" type="button" data-run-dismiss aria-label="Dismiss" hidden>
      <Icon name="close" class="icon-lg" />
    </button>
    <span class="run-bar" aria-hidden="true"><span class="run-fill"></span></span>
  </div>
</div>
