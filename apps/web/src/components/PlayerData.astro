---
import { serializeJsonForScript } from "../lib/serializeJson";
import type { PlayerDigestData } from "../types/contracts";

interface Props {
  data: PlayerDigestData;
}

const { data } = Astro.props;
---

{/* The player reads this on astro:page-load. A data block, not executable script, so the
     Content-Security-Policy does not need to allow it. */}
<script is:inline type="application/json" id="singularity-digest-data" set:html={serializeJsonForScript(data)}></script>
