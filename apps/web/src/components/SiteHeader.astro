---
import BrandMark from "./BrandMark.astro";
---

{/* The top app bar, shown below 64rem. The wordmark sits in the middle, which also keeps the
     top-leading corner free: iPadOS windowed apps draw their window controls there. From 64rem the
     side navigation carries the wordmark and this bar is not rendered at all. */}
<header class="app-bar">
  <div class="app-bar-inner page">
    <a class="wordmark press press-subtle" href="/" aria-label="Singularity, today's briefing" data-astro-prefetch="hover">
      <BrandMark />
      <span>Singularity</span>
    </a>
  </div>
</header>
