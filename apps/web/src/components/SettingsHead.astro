---
interface Props {
  /** The page's own name, which is its heading. Left out, the head is the crumb alone (a category's page, whose card holds the name). */
  title?: string;
  /** One quiet line under the title: what the page is for. */
  note?: string;
  /** Show the "Settings /" crumb on a page reached from Settings outside /settings/. */
  crumb?: boolean;
  /** Where the crumb leads: Settings, or the Profile for Downloads and Favorites. */
  up?: { href: string; label: string };
}

// A settings subpage says where it sits (owner, 2026-10-25); Settings itself and the pages outside it do
// not, unless Settings links to them (Costs once lived at /analytics and lost its crumb, 2026-10-27; it is in the
// admin app now).
const {
  title,
  note,
  crumb = Astro.url.pathname.startsWith("/settings/"),
  up = { href: "/settings", label: "Settings" },
} = Astro.props;
---

{/* A small "Settings /" (or "Profile /") line above the name of a settings subpage, linking up (.settings-crumb). */}
<header class="settings-head">
  {
    crumb && (
      <nav class="settings-crumb" aria-label="Breadcrumb">
        <a class="text-link" href={up.href}>
          {up.label}
        </a>
        <span aria-hidden="true"> /</span>
      </nav>
    )
  }
  {
    title &&
      (Astro.slots.has("end") ? (
        <div class="settings-head-row">
          <h1 class="page-title text-display" id="page-title" tabindex="-1">{title}</h1>
          <slot name="end" />
        </div>
      ) : (
        <h1 class="page-title text-display" id="page-title" tabindex="-1">{title}</h1>
      ))
  }
  {note && <p class="settings-note">{note}</p>}
</header>
