---
import Icon from "./Icon.astro";

interface Props {
  /** The page's own name, which is its heading. */
  title: string;
  /** The page one level up: Settings, or Topics for a topic. */
  up?: { href: string; label: string };
  /** One quiet line under the title: what the page is for, or when it next runs. */
  note?: string;
  /** Marks the note as the "next run" line. */
  next?: boolean;
  /** Said in the next run's place while the profile is off, so the line, and the switch under it,
      hold still. */
  off?: string;
  /** What the browser works the next run line out from again (lib/nextRun.ts): the last runs, and
      the weekly episode's day while it is on. */
  runs?: { lastRegularAt: string | null; lastWeeklyAt: string | null; weeklyDay: number | null };
}

const {
  title,
  up = { href: "/settings", label: "Settings" },
  note,
  next = false,
  off,
  runs,
} = Astro.props;
---

{/* Where the page sits, at the title's own size and on its line: the way up is the first word,
     muted, and names the page one level up. It stands in for a back button and puts no small text
     above the title. */}
<header
  class="settings-head"
  data-last-regular={runs?.lastRegularAt ?? undefined}
  data-last-weekly={runs?.lastWeeklyAt ?? undefined}
  data-weekly-day={runs?.weeklyDay ?? undefined}
>
  <div class="settings-crumbs">
    <nav aria-label="Breadcrumb">
      <a class="settings-up" href={up.href}>{up.label}</a>
    </nav>
    <Icon name="chevronRight" class="settings-crumb-gap" />
    <h1 class="page-title" id="page-title" tabindex="-1">{title}</h1>
  </div>
  {
    note && (
      <p class="settings-note">
        <span data-next={next ? "" : undefined}>{note}</span>
        {off && <span data-off>{off}</span>}
      </p>
    )
  }
</header>
