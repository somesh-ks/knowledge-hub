---
interface Props {
  /** The page's own name, which is its heading. */
  title: string;
  /** One quiet line under the title: what the page is for. */
  note?: string;
}

// A settings subpage says where it sits (owner, 2026-10-25), and so does an admin page: Admin and the
// pages under it (D218). Settings itself does not.
const { title, note } = Astro.props;
const { pathname } = Astro.url;
const up = pathname.startsWith("/admin/")
  ? { label: "Admin", href: "/admin" }
  : pathname === "/admin" || pathname.startsWith("/settings/")
    ? { label: "Settings", href: "/settings" }
    : undefined;
---

{/* A small "Settings /" line above the name of a settings subpage, linking up (.settings-crumb). */}
<header class="settings-head">
  {
    up && (
      <nav class="settings-crumb" aria-label="Breadcrumb">
        <a class="text-link" href={up.href}>
          {up.label}
        </a>
        <span aria-hidden="true"> /</span>
      </nav>
    )
  }
  <h1 class="page-title" id="page-title" tabindex="-1">{title}</h1>
  {note && <p class="settings-note">{note}</p>}
</header>
