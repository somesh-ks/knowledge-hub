---
import Icon from "../design-system/Icon.astro";
import MenuItem from "../design-system/MenuItem.astro";
import type { PodcastAction } from "../lib/podcastActions";
import { regenerationHint } from "../lib/regenerations";

interface Props {
  action: PodcastAction;
  id: string;
  kind: "briefing" | "episode";
  /** On Settings > Downloads, Download is the row's way out: Remove download, in the danger tone. */
  removeOnly?: boolean;
  regenerations?: number | undefined;
  /** "true" while a page waits for libraryMenu.ts to wire its items. */
  pending?: "true" | undefined;
}

const { action, id, kind, removeOnly = false, regenerations, pending } = Astro.props;
const regen = regenerationHint(regenerations);
---

{/* One action of a podcast's sheet (PodcastMenuItems.astro). A toggle carries both glyphs and its
     holder's data-saved or data-downloaded picks one (library.css, hero.css); libraryMenu.ts sets the
     words. Remove download is the bin everywhere (owner, 2026-11-04). */}
{
  action === "favorite" ? (
    <MenuItem data-menu="favorite" aria-disabled={pending}>
      <Icon name="heartOutline" class="fav-add" /><Icon name="heart" class="fav-remove" /><span data-menu-label>Add to favorites</span>
    </MenuItem>
  ) : action === "queue" ? (
    <MenuItem data-menu="queue" aria-disabled={pending}>
      <Icon name="queueAdd" />Add to queue
    </MenuItem>
  ) : action === "share" ? (
    <MenuItem data-menu="share" data-share-item={id} aria-disabled={pending}>
      <Icon name="shareFat" />Share
    </MenuItem>
  ) : action === "download" && removeOnly ? (
    <MenuItem tone="danger" data-menu="download">
      <Icon name="trash" /><span data-menu-label>Remove download</span>
    </MenuItem>
  ) : action === "download" ? (
    <MenuItem data-menu="download" aria-disabled={pending}>
      <Icon name="download" class="dl-add" /><Icon name="trash" class="dl-remove" /><span data-menu-label>Download</span>
    </MenuItem>
  ) : action === "regenerate" && kind === "episode" ? (
    <MenuItem data-episode-action="regenerate" title={regen.title} disabled={regen.exhausted}>
      <Icon name="refresh" />Regenerate
    </MenuItem>
  ) : action === "regenerate" ? (
    <MenuItem data-open="generate" aria-haspopup="dialog" title={regen.title} disabled={regen.exhausted}>
      <Icon name="refresh" />Regenerate
    </MenuItem>
  ) : action === "unshare" ? (
    /* Put in by scripts/shareLink.ts once this device made the item's listen link (D153). */
    <template data-share-stop-template>
      <MenuItem data-menu="unshare" data-share-stop={id}>
        <Icon name="blocked" />Stop sharing
      </MenuItem>
    </template>
  ) : action === "delete" ? (
    <MenuItem tone="danger" data-episode-action="delete">
      <Icon name="trash" />Delete
    </MenuItem>
  ) : null
}
