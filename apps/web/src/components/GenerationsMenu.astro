---
import Button from "../design-system/Button.astro";
import EmptyArt from "./EmptyArt.astro";
import Icon from "./Icon.astro";
import SheetHeader from "./SheetHeader.astro";

// Every line the list shows. scripts/generations.ts reads them from the panel's data-word-* attributes,
// so the script carries no copy ({n} is a number, {title} a generation's name). The prefix matters: a
// bare data-briefing or data-episode is what the Regenerate form reads off the page (episodeActions.ts).
const words = {
  "data-word-waiting": "Waiting to start",
  "data-word-left": "About {n} min left",
  "data-word-slow": "Taking longer than usual",
  "data-word-episode": "Catch up",
  "data-word-briefing": "Podcast",
  "data-word-regenerate": "Regenerate",
  "data-word-cancelling": "Cancelling…",
  "data-word-cancel-failed": "Couldn't cancel. Try again.",
  "data-word-cancel-label": "Cancel {title}",
  "data-word-progress-label": "{title}, progress",
  "data-word-listen": "Listen now",
  "data-word-label": "Generations",
  "data-word-label-busy": "Generations, {n} in progress",
  "data-word-unavailable": "Couldn't check what is being made. Try again in a moment.",
};
---

{/* What is being made, in the manner of a browser's downloads: an icon whose ring fills with the
     run's progress, and a list under it with a thumbnail, the stage and time left, a bar and Cancel
     for each generation. From 64rem the icon sits at the top of the side column; below it the strip
     above the bottom bar opens the same list as a bottom sheet (RunStatus.astro). Nothing a reader
     needs often sits at the top of a phone (design ledger, thumb's reach). The panel is a popover,
     so light dismiss and Escape are the browser's; it is the More menu's own surface (hero.css,
     .menu-sheet) with its own size (generations.css). scripts/generations.ts fills it. */}
<div class="gen-root" transition:persist="generations">
  <button
    class="icon-btn gen-trigger press"
    type="button"
    popovertarget="generations"
    aria-haspopup="dialog"
    aria-label={words["data-word-label"]}
    data-gen-trigger
  >
    <svg class="gen-ring" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
      <circle class="gen-ring-track" cx="16" cy="16" r="14" pathLength="100"></circle>
      <circle class="gen-ring-fill" cx="16" cy="16" r="14" pathLength="100"></circle>
    </svg>
    <Icon name="waveform" class="gen-glyph" />
  </button>

  <div
    class="hero-menu-list menu-sheet gen-pop"
    id="generations"
    popover
    role="dialog"
    aria-labelledby="generations-title"
    data-picker
    data-generations
    {...words}
  >
    <SheetHeader title="Generations" titleId="generations-title" close="data-menu-close" />
    <div class="gen-body">
      <span class="sr-only" role="status" data-gen-announce></span>
      <ul class="gen-list" role="list" data-gen-list></ul>
      <p class="gen-note" data-gen-note hidden></p>
      <p class="gen-checking" data-gen-checking>Checking…</p>
      {/* The compact empty state the Settings lists use (empty.css), with the action it offers. */}
    <div class="gen-empty empty" data-compact data-gen-empty hidden>
      <EmptyArt art="library" size="compact" />
      <p class="empty-title">Nothing in the works</p>
      <p class="empty-body">Start a Catch up and you can follow it here.</p>
      <div class="empty-actions">
        <Button variant="filled" href="/create" data-create-open data-sound="open">Catch up</Button>
      </div>
    </div>
    </div>
    <template data-gen-row>
      <li class="gen-row" data-gen>
        <span class="gen-thumb" aria-hidden="true">
          <Icon name="waveform" class="gen-thumb-glyph" />
          <img class="gen-thumb-img" alt="" width="44" height="44" decoding="async" hidden />
        </span>
        <div class="gen-main">
          <p class="gen-title" data-gen-title></p>
          <p class="gen-meta" data-gen-meta></p>
          <span class="gen-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" data-gen-bar>
            <span class="gen-fill"></span>
          </span>
        </div>
        <button class="icon-btn gen-cancel press" type="button" data-gen-cancel>
          <Icon name="close" class="icon-lg" />
        </button>
        <Button variant="text" class="gen-listen" data-gen-listen hidden>Listen now</Button>
      </li>
    </template>
  </div>
</div>
