---
import { menuTilesClass } from "../design-system/menu";
import { inPodcastOrder, type PodcastAction, TILE_COUNT, TILES_MIN } from "../lib/podcastActions";
import PodcastMenuItem from "./PodcastMenuItem.astro";

interface Props {
  id: string;
  kind: "briefing" | "episode";
  /** Where the sheet opens: a Library card, a podcast page, Settings > Downloads or > Favorites. */
  place: "library" | "page" | "downloads" | "saved";
  /** The file to download: without it Download is not offered. */
  audio?: string | undefined;
  /** False on a Daily or Weekly briefing: only on-demand briefings and episodes can be deleted. */
  deletable?: boolean;
  /** Times this podcast was regenerated, for the Regenerate item's counter (D212). */
  regenerations?: number | undefined;
}

const { id, kind, place, audio, deletable = true, regenerations } = Astro.props;
const full = place === "library" || place === "page";

const wanted: PodcastAction[] = ["favorite", "queue", "share"];
if (place === "downloads" || (full && audio)) wanted.push("download");
if (full) wanted.push("regenerate", "unshare");
if (full && deletable) wanted.push("delete");
const actions = inPodcastOrder(wanted);
// Stop sharing is put in only once this device shared the item, so it never counts toward tiles.
const counted = actions.filter((action) => action !== "unshare");
const tiles: PodcastAction[] = counted.length >= TILES_MIN ? counted.slice(0, TILE_COUNT) : [];
const rows = actions.filter((action) => !tiles.includes(action));
const item = {
  id,
  kind,
  regenerations,
  removeOnly: place === "downloads",
  // A page serves its items dimmed until libraryMenu.ts wires them (it lifts aria-disabled).
  pending: place === "page" ? ("true" as const) : undefined,
};
---

{/* One podcast's actions, in the one order every podcast sheet keeps (lib/podcastActions.ts, D369).
     With enough of them the first three are the quick actions: tiles over the list on a phone's sheet,
     rows from 40rem (menu.css); a short sheet is a plain list. scripts/libraryMenu.ts wires the
     data-menu items; Regenerate and Delete are the episode and briefing pages' own dialogs. */}
{
  tiles.length > 0 && (
    <div class={menuTilesClass()} data-fold role="presentation">
      {tiles.map((action) => <PodcastMenuItem action={action} {...item} />)}
    </div>
  )
}
{rows.map((action) => <PodcastMenuItem action={action} {...item} />)}
