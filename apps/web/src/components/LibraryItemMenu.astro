---
import Icon from "../design-system/Icon.astro";
import Menu from "../design-system/Menu.astro";
import PodcastMenuItems from "./PodcastMenuItems.astro";

interface Props {
  /** The digest id ("2026-10-07") or episode id ("ep-20261007-1930"). */
  id: string;
  /** The row's name, for the button's label and the share sheet. */
  title: string;
  /** The row's quiet line (its facts), shown under the title on a phone's sheet. */
  subtitle?: string;
  /** The page the row opens, which Share points at and a download keeps. */
  path: string;
  kind: "briefing" | "episode";
  /** The audio file, or an episode's lookup of its turns' files: only then can it be downloaded. */
  audio?: string;
  /** False on a Daily or Weekly briefing: only on-demand briefings and episodes can be deleted. */
  deletable?: boolean;
  /** An episode's topic ids, so Regenerate starts with the ones it was made with. */
  topics?: readonly string[];
  /** A briefing's aired minutes: its Regenerate starts on the nearest length (lib/regenLength.ts). */
  minutes?: number;
  /** Times this podcast was regenerated, for the Regenerate item's counter (D212). */
  regenerations?: number | undefined;
}

const {
  id,
  title,
  subtitle,
  path,
  kind,
  audio,
  deletable = true,
  topics,
  minutes,
  regenerations,
} = Astro.props;
const menuId = `card-menu-${id}`;
---

{/* The ⋮ at the end of a row's text, in the gallery and the list, and the sheet a hold on the card
     opens (cardHold.ts). The sheet is every podcast's one sheet (PodcastMenuItems.astro, D369), the
     same as the podcast page's ⋮ (HeroMenu.astro); the items are wired by scripts/libraryMenu.ts. A
     sibling of the card's link, never inside it, so a press here cannot open the card. */}
<div
  class="card-menu"
  style={`--card-anchor: --cm-${id}`}
  data-library-menu
  data-id={id}
  data-path={path}
  data-title={title}
  data-audio={audio}
  data-episode-actions=""
  data-episode={kind === "episode" ? id : undefined}
  data-library-briefing={kind === "briefing" ? id : undefined}
  data-minutes={kind === "briefing" ? minutes : undefined}
  data-topics={topics?.join(" ")}
>
  <button
    class="icon-btn card-more press"
    type="button"
    aria-label={`More actions for ${title}`}
    aria-haspopup="menu"
    popovertarget={menuId}
    data-hero-more
  >
    <Icon name="moreVert" />
  </button>
  <Menu id={menuId} title={title} subtitle={subtitle} class="card-menu-list">
    <PodcastMenuItems
      id={id}
      kind={kind}
      audio={audio}
      deletable={deletable}
      regenerations={regenerations}
    />
  </Menu>
</div>
