---
import Icon from "../design-system/Icon.astro";
import Menu from "../design-system/Menu.astro";
import MenuItem from "../design-system/MenuItem.astro";
import { regenerationHint } from "../lib/regenerations";

interface Props {
  /** The digest id ("2026-10-07") or episode id ("ep-20261007-1930"). */
  id: string;
  /** The row's name, for the button's label and the share sheet. */
  title: string;
  /** The row's quiet line (its facts), shown under the title on a phone's sheet. */
  subtitle?: string;
  /** The page the row opens, which Share points at and a download keeps. */
  path: string;
  kind: "briefing" | "episode";
  /** The audio file, or an episode's lookup of its turns' files: only then can it be downloaded. */
  audio?: string;
  /** False on a Daily or Weekly briefing: only on-demand briefings and episodes can be deleted. */
  deletable?: boolean;
  /** An episode's topic ids, so Regenerate starts with the ones it was made with. */
  topics?: readonly string[];
  /** Times this podcast was regenerated, for the Regenerate item's counter (D212). */
  regenerations?: number | undefined;
  /** On Settings > Downloads: only what applies to a saved copy (Add to queue, Share, Remove download). */
  downloads?: boolean;
}

const {
  id,
  title,
  subtitle,
  path,
  kind,
  audio,
  deletable = true,
  topics,
  regenerations,
  downloads = false,
} = Astro.props;
const regen = regenerationHint(regenerations);
const menuId = `card-menu-${id}`;
---

{/* The ⋮ at the end of a row's text, in the gallery and the list. It is the header More menu's
     pattern (HeroMenu.astro, scripts/heroMenu.ts) with a menu per row; the items are wired by
     scripts/libraryMenu.ts. Regenerate and Delete are the episode page's own (EpisodeActions.astro,
     one set of dialogs for the whole Library) and a briefing's (the Generate sheet). Download is
     only offered where the item already has an audio file. A sibling of the card's link, never inside
     it, so a press here cannot open the card. The template is the downloaded mark, which
     scripts/libraryMenu.ts puts at the start of the quiet line while the item is downloaded. */}
<template data-downloaded-mark>
  <span class="card-downloaded"><Icon name="checkCircle" /><span class="sr-only">Downloaded</span></span>
</template>
<div
  class="card-menu"
  style={`--card-anchor: --cm-${id}`}
  data-library-menu
  data-manage-downloads={downloads ? "" : undefined}
  data-id={id}
  data-path={path}
  data-title={title}
  data-audio={audio}
  data-episode-actions=""
  data-episode={kind === "episode" ? id : undefined}
  data-library-briefing={kind === "briefing" ? id : undefined}
  data-topics={topics?.join(" ")}
>
  <button
    class="icon-btn card-more press"
    type="button"
    aria-label={`More actions for ${title}`}
    aria-haspopup="menu"
    popovertarget={menuId}
    data-hero-more
  >
    <Icon name="moreVert" />
  </button>
  <Menu id={menuId} title={title} subtitle={subtitle} class="card-menu-list">
    {
      audio && !downloads && (
        <MenuItem data-menu="download">
          <Icon name="download" class="dl-add" /><Icon name="downloadRemove" class="dl-remove" /><span data-menu-label>Download</span>
        </MenuItem>
      )
    }
    <MenuItem data-menu="queue">
      <Icon name="queueAdd" />Add to queue
    </MenuItem>
    {
      downloads ? null : kind === "episode" ? (
        <MenuItem
          data-episode-action="regenerate"
          title={regen.title}
          disabled={regen.exhausted}>
          <Icon name="refresh" />Regenerate
        </MenuItem>
      ) : (
        <MenuItem
          data-open="generate"
          aria-haspopup="dialog"
          title={regen.title}
          disabled={regen.exhausted}>
          <Icon name="refresh" />Regenerate
        </MenuItem>
      )
    }
    <MenuItem data-menu="share" data-share-item={id}>
      <Icon name="shareFat" />Share
    </MenuItem>
    {/* Put in by scripts/shareLink.ts once this device made the row's listen link (D153). */}
    {/* Not on the Downloads page, whose row menu is Add to queue, Share and Remove download (D281). */}
    {
      !downloads && (
        <template data-share-stop-template>
          <MenuItem
            data-menu="unshare"
            data-share-stop={id}>
            <Icon name="blocked" />Stop sharing
          </MenuItem>
        </template>
      )
    }
    {
      downloads && (
        <MenuItem tone="danger" data-menu="download">
          <Icon name="download" class="dl-add" /><Icon name="downloadRemove" class="dl-remove" /><span data-menu-label>Remove download</span>
        </MenuItem>
      )
    }
    {
      deletable && !downloads && (
        <MenuItem tone="danger"
          data-episode-action="delete">
          <Icon name="trash" />Delete
        </MenuItem>
      )
    }
  </Menu>
</div>
