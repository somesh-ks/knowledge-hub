---
interface Props {
  /** 0 to 5, one decimal. Null while a source is new: no stars, no number. */
  score: number | null;
  /** "Excellent", "Good", "Fair", "Poor" or "New". */
  label: string;
}

const { score, label } = Astro.props;
---

{/* A source's quality: five small stars filled to the score, the number, and the label. The stars
     are decoration; the number and the label say the same thing in words, so colour is never alone. */}
<span class="score" data-label={label}>
  {score !== null && <span class="stars" aria-hidden="true" style={`--score: ${score}`} />}
  {score !== null && <span class="score-num">{score.toFixed(1)}</span>}
  <span class="score-label">{label}</span>
</span>
