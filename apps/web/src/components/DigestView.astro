---
import { digestSections } from "@singularity/core";
import type { DigestEntry } from "../lib/digests";
import { buildHero, buildSections } from "../lib/digestView";
import { sharedPlayer } from "../lib/share";
import Briefing from "./Briefing.astro";
import ChapterAside from "./ChapterAside.astro";
import DigestHero from "./DigestHero.astro";
import EarlierList from "./EarlierList.astro";
import EpisodeActions from "./EpisodeActions.astro";
import PlayerData from "./PlayerData.astro";

interface Props {
  entry: DigestEntry;
  /** The digests shown under "Earlier briefings": the three before this one. */
  earlier: DigestEntry[];
  /** True for the latest briefing, which the navigation marks as Today. */
  isLatest: boolean;
  /** Set on a shared page, /s/<token> (D153): no owner actions, and Play goes through the link. */
  shareToken?: string;
}

const { entry, earlier, isLatest, shareToken } = Astro.props;
const sections = buildSections(entry);
const hero = buildHero(entry, entry.player.title);
const hasAudio = entry.audioMode === "ready";
---

<main
  id="main"
  tabindex="-1"
  data-digest-id={entry.id}
  data-digest-date={entry.digest.date}
  data-latest={isLatest ? "true" : "false"}
  data-shared={shareToken ? "" : undefined}
>
  <DigestHero entry={entry} hero={hero} shareToken={shareToken} />
  {
    !shareToken && (
      <EpisodeActions
        id={entry.id}
        noun="briefing"
        selected={digestSections(entry.digest).map((section) => section.id)}
      />
    )
  }
  <Briefing sections={sections} hasAudio={hasAudio} />
  <EarlierList entries={earlier} />
  {/* The end of what the page shows. Once it is on screen the reader is at the end, and
       briefingPage.ts marks the last section, which may be too short to reach the reading line. */}
  <div data-page-end></div>
  <PlayerData data={sharedPlayer(entry.player, shareToken)} />
</main>
{/* After main in the document, as on the page: the contents column sits past the reading column. */}
<ChapterAside sections={sections} />

<script>
  // Loaded on demand, so it stays one shared module. A script this small is otherwise inlined into
  // the page, and an inline module runs again on every visit to a briefing, doubling its listeners.
  void import("../scripts/briefingPage");
  import { installEpisodeActions } from "../scripts/episodeActionsEntry";

  installEpisodeActions();
</script>
