---
import Icon from "./Icon.astro";

interface Props {
  /** Prefix of the ids inside. */
  id: string;
  /** The group's name, an H2. */
  title: string;
}

const { id, title } = Astro.props;
---

{/* A group of sliders folded under its heading, closed until opened (2026-10-20): Topic weightage,
     Formats and Perspective on a topic's page, the same on a phone and a wide screen. A native
     details, so it opens without script and the browser finds a slider inside it. The section
     names the region by its heading. */}
<section class="topic-weights" aria-labelledby={`${id}-head`}>
  <details class="accordion">
    <summary class="accordion-summary">
      <h2 class="section-head" id={`${id}-head`}>{title}</h2>
      <Icon name="chevronDown" class="accordion-icon" />
    </summary>
    <div class="rows topic-controls">
      <slot />
    </div>
  </details>
</section>
