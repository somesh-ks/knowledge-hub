---
import { paletteAccent } from "@dispatch/cover";
import type { DigestEntry } from "../lib/digests";
import { listenLength, storyCount } from "../lib/digestView";
import { longDate } from "../lib/format";
import Cover from "./Cover.astro";
import Icon from "./Icon.astro";

interface Props {
  entry: DigestEntry;
}

const { entry } = Astro.props;
const { digest } = entry;
const kindLabel =
  digest.kind === "weekly"
    ? "Weekly deep dive"
    : digest.kind === "on-demand"
      ? "Generated on request"
      : null;
---

{/* One briefing as a row: the whole row is the link, and its fill runs edge to edge. */}
<li>
  <a class="row-action archive-row" href={`/d/${entry.id}`} data-astro-prefetch="hover">
    <Cover
      digestId={entry.id}
      size="row"
      paletteBg={paletteAccent(digest.cover.palette).bg}
      weekly={digest.kind === "weekly"}
    />
    <span class="archive-text">
      <span class="archive-date">{longDate(digest.date)}</span>
      <span class="meta meta-wrap">
        <span>{storyCount(digest.items.length)}</span>
        <span>{listenLength(entry)}</span>
        {kindLabel && <span>{kindLabel}</span>}
      </span>
    </span>
    <Icon name="chevronRight" />
  </a>
</li>
