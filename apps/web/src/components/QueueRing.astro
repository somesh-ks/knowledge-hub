---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"span">;

const { class: className = "", ...attributes } = Astro.props;
---

{/* A drawn arc: 100 units round, the fill a share of them (queue.css, --queue-p). What sits inside it
     (a percent, a stage icon) is the slot. The queue's rows, the dock's folded row and the side column's
     row each hold one, in their own size (--queue-ring-size). */}
<span class:list={["queue-ring", className]} {...attributes}>
  <svg viewBox="0 0 44 44" aria-hidden="true" focusable="false">
    <circle class="queue-ring-track" cx="22" cy="22" r="19" pathLength="100"></circle>
    <circle class="queue-ring-fill" cx="22" cy="22" r="19" pathLength="100"></circle>
  </svg>
  <slot />
</span>
