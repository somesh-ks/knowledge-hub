---
import { paletteAccent } from "@dispatch/cover";
import type { DigestEntry } from "../lib/digests";
import type { HeroView } from "../lib/digestView";
import Cover from "./Cover.astro";
import PlayCta from "./PlayCta.astro";

interface Props {
  entry: DigestEntry;
  hero: HeroView;
}

const { entry, hero } = Astro.props;
---

{/* The briefing header: the cover beside the date, one line of facts, then the play chip and share. */}
<header class="hero">
  <Cover
    digestId={entry.id}
    size="hero"
    paletteBg={paletteAccent(entry.digest.cover.palette).bg}
    weekly={entry.digest.kind === "weekly"}
    priority
  />
  <div class="hero-text">
    <h1 class="page-title" id="page-title" tabindex="-1">{hero.title}</h1>
    {/* The space after each part is for a screen reader and a copied line; the layout ignores it. */}
    <p class="meta meta-wrap">
      {
        hero.meta.map((part) => (
          <Fragment>
            <span>{part}</span>{" "}
          </Fragment>
        ))
      }
    </p>
  </div>
  <PlayCta digestId={entry.id} mode={entry.audioMode} length={hero.length} />
</header>
