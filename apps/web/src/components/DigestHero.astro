---
import type { DigestEntry } from "../lib/digests";
import type { HeroView } from "../lib/digestView";
import { sharedTarget } from "../lib/share";
import AmbientLight from "./AmbientLight.astro";
import Cover from "./Cover.astro";
import HeroDownloaded from "./HeroDownloaded.astro";
import HeroMenu from "./HeroMenu.astro";
import PlayCta from "./PlayCta.astro";

interface Props {
  entry: DigestEntry;
  hero: HeroView;
  /** Set on a shared page (D153): no More menu, and Share sends the shared link on. */
  shareToken?: string;
}

const { entry, hero, shareToken } = Astro.props;
// The day and the month stay on one line: a narrow title wraps "Monday / 5 October", never
// "Monday 5 / October".
const title = hero.title.replace(/(\d+) /, "$1 ");
---

{/* The briefing header (hero.css): the cover and the More menu, the date with its facts under it,
     then Play and Share. */}
<header class="hero">
  <AmbientLight cover={entry.digest} />
  <Cover
    digestId={entry.id}
    size="hero"
    source={entry.digest}
    weekly={entry.digest.kind === "weekly"}
  />
  <div class="hero-text">
    <h1 class="page-title text-display" id="page-title" tabindex="-1">{title}</h1>
    <p class="meta hero-facts">{hero.meta.map((part) => <span>{part}</span>)}<HeroDownloaded /></p>
  </div>
  {
    !shareToken && (
      <HeroMenu
        briefingId={entry.id}
        deletable={entry.digest.kind === "on-demand"}
        regenerations={entry.digest.regenerations}
        page={{
          id: entry.id,
          title,
          path: `/d/${entry.id}`,
          audio: entry.audioMode === "ready" ? entry.player.audio?.url : undefined,
        }}
      />
    )
  }
  <PlayCta
    digestId={entry.id}
    mode={entry.audioMode}
    length={hero.length}
    share={sharedTarget(entry.id, "briefing", shareToken)}
  />
</header>
