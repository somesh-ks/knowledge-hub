---
import { paletteAccent } from "@dispatch/cover";
import type { DigestEntry } from "../lib/digests";
import type { HeroView } from "../lib/digestView";
import AmbientLight from "./AmbientLight.astro";
import Cover from "./Cover.astro";
import HeroMenu from "./HeroMenu.astro";
import PlayCta from "./PlayCta.astro";

interface Props {
  entry: DigestEntry;
  hero: HeroView;
}

const { entry, hero } = Astro.props;
---

{/* The briefing header: the cover beside the date and the More menu, then the play chip with the
     number of stories at its side. */}
<header class="hero">
  <AmbientLight palette={entry.digest.cover.palette} />
  <Cover
    digestId={entry.id}
    size="hero"
    paletteBg={paletteAccent(entry.digest.cover.palette).bg}
    weekly={entry.digest.kind === "weekly"}
    priority
  />
  <div class="hero-text">
    <div class="hero-title-row">
      <h1 class="page-title" id="page-title" tabindex="-1">{hero.title}</h1>
      <HeroMenu sharePath={`/d/${entry.id}`} noun="briefing" />
    </div>
  </div>
  <PlayCta digestId={entry.id} mode={entry.audioMode} length={hero.length} facts={hero.meta} />
</header>
