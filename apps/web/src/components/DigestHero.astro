---
import { paletteAccent } from "@dispatch/cover";
import type { DigestEntry } from "../lib/digests";
import type { HeroView } from "../lib/digestView";
import AmbientLight from "./AmbientLight.astro";
import Cover from "./Cover.astro";
import HeroMenu from "./HeroMenu.astro";
import PlayCta from "./PlayCta.astro";

interface Props {
  entry: DigestEntry;
  hero: HeroView;
  /** The latest briefing offers New briefing in its menu; an older one only Share. */
  isLatest: boolean;
}

const { entry, hero, isLatest } = Astro.props;
// The day and the month stay on one line: a narrow title wraps "Monday / 5 October", never
// "Monday 5 / October".
const title = hero.title.replace(/(\d+) /, "$1 ");
---

{/* The briefing header (hero.css): the cover and the More menu, the date with its facts under it,
     then Play. */}
<header class="hero">
  <AmbientLight palette={entry.digest.cover.palette} />
  <Cover
    digestId={entry.id}
    size="hero"
    paletteBg={paletteAccent(entry.digest.cover.palette).bg}
    weekly={entry.digest.kind === "weekly"}
    priority
  />
  <div class="hero-text">
    <h1 class="page-title" id="page-title" tabindex="-1">{title}</h1>
    <p class="meta hero-facts">{hero.meta.map((part) => <span>{part}</span>)}</p>
  </div>
  <HeroMenu
    sharePath={`/d/${entry.id}`}
    noun="briefing"
    newBriefingSince={isLatest ? entry.digest.window.to : undefined}
  />
  <PlayCta digestId={entry.id} mode={entry.audioMode} length={hero.length} />
</header>
