---
import { FORMATS, LENGTHS } from "../lib/createForm";
import { CADENCES, hourLabel, type TopicChoice, WEEKDAYS } from "../lib/schedule";
import Icon from "./Icon.astro";

interface Props {
  /** The profile: its fields are named and identified by it, as the engine's schedule file names them. */
  id: "daily" | "weekly";
  /** The saved values. A field the profile has no row for is ignored. */
  values: {
    enabled?: boolean;
    hour?: number;
    day?: number;
    cadenceDays?: number;
    /** Section ids the episode covers, or null for every topic. */
    sections: readonly string[] | null;
    format: string;
    lengthMinutes: number;
    voiceId: string | null;
    voiceIdB: string | null;
  };
  /** The topics the episode can be narrowed to, by name. */
  topics: readonly TopicChoice[];
}

const { id, values, topics } = Astro.props;
const covered = (section: string): boolean =>
  values.sections === null || values.sections.includes(section);
const hours = Array.from({ length: 24 }, (_, value) => value);
const discussion = values.format === "discussion";
// A stored Headlines schedule has no radio to show; the first change picks one of the two.
const VOICES = [
  { key: "voice", saved: values.voiceId, name: "Ada" },
  { key: "voice_b", saved: values.voiceIdB, name: "Leo" },
] as const;
---

<div class="podcast-profile" data-profile={id}>
  <div class="rows">
    {
      id === "weekly" && (
        <div class="settings-row">
          <label class="settings-label" for="weekly-enabled">Weekly podcast</label>
          <input
            class="settings-switch"
            id="weekly-enabled"
            type="checkbox"
            role="switch"
            data-f="weekly.enabled"
            checked={values.enabled}
            autocomplete="off"
          />
        </div>
      )
    }

    <div class="settings-row daily-when">
      <div class="settings-text">
        <span class="settings-label">When</span>
        <span class="settings-hint" id={`${id}-when-hint`}>Stockholm time</span>
      </div>
      <div class="daily-selects">
        {id === "weekly" && (
          <>
            <label class="sr-only" for="weekly-day">Day</label>
            <span class="manage-select">
              <select class="manage-input" id="weekly-day" data-f="weekly.day" autocomplete="off">
                {WEEKDAYS.map((name, value) => (
                  <option value={value} selected={value === values.day}>{name}</option>
                ))}
              </select>
              <Icon name="chevronDown" />
            </span>
          </>
        )}
        <label class="sr-only" for={`${id}-hour`}>Time</label>
        <span class="manage-select">
          <select
            class="manage-input"
            id={`${id}-hour`}
            data-f={`${id}.hour`}
            autocomplete="off"
            aria-describedby={`${id}-when-hint`}
          >
            {hours.map((value) => (
              <option value={value} selected={value === values.hour}>{hourLabel(value)}</option>
            ))}
          </select>
          <Icon name="chevronDown" />
        </span>
        {id === "daily" && (
          <>
            <label class="sr-only" for="daily-cadence">How often</label>
            <span class="manage-select">
              <select class="manage-input" id="daily-cadence" data-f="daily.cadence" autocomplete="off">
                {CADENCES.map((cadence) => (
                  <option value={cadence.days} selected={cadence.days === values.cadenceDays}>
                    {cadence.label}
                  </option>
                ))}
              </select>
              <Icon name="chevronDown" />
            </span>
          </>
        )}
      </div>
    </div>

    {/* Every topic ticked is stored as "all of them", so a topic added later is covered too. One
         stays ticked: an episode with no topic would have only Top picks to tell. */}
    <div class="settings-row podcast-topics-row">
      <div class="settings-text">
        <span class="settings-label" id={`${id}-topics-label`}>Topics</span>
        <span class="settings-hint" id={`${id}-topics-hint`}>Top picks are always in</span>
      </div>
      <fieldset
        class="create-chips podcast-topics"
        aria-labelledby={`${id}-topics-label`}
        aria-describedby={`${id}-topics-hint`}
      >
        {
          topics.map((topic) => (
            <label class="create-chip">
              <input
                type="checkbox"
                value={topic.id}
                data-f={`${id}.sections`}
                checked={covered(topic.id)}
                autocomplete="off"
              />
              <Icon name="check" class="create-chip-check" />
              <span>{topic.title}</span>
            </label>
          ))
        }
      </fieldset>
    </div>

    <div class="settings-row" data-layout="choice">
      <div class="settings-text">
        <span class="settings-label" id={`${id}-format-label`}>Type</span>
      </div>
      <fieldset class="settings-choice" role="radiogroup" aria-labelledby={`${id}-format-label`}>
        {
          FORMATS.map((entry) => (
            <label class="settings-segment">
              <input
                type="radio"
                name={`${id}-format`}
                value={entry.value}
                data-f={`${id}.format`}
                checked={entry.value === values.format}
                autocomplete="off"
              />
              <span>{entry.label}</span>
            </label>
          ))
        }
      </fieldset>
    </div>

    <div class="settings-row" data-layout="choice">
      <div class="settings-text">
        <span class="settings-label" id={`${id}-length-label`}>Length</span>
      </div>
      <fieldset class="settings-choice" role="radiogroup" aria-labelledby={`${id}-length-label`}>
        {
          LENGTHS.map((entry) => (
            <label class="settings-segment">
              <input
                type="radio"
                name={`${id}-length`}
                value={String(entry.value)}
                data-f={`${id}.length`}
                checked={entry.value === values.lengthMinutes}
                autocomplete="off"
              />
              <span class="num">{entry.label}</span>
            </label>
          ))
        }
      </fieldset>
    </div>

    {
      VOICES.map((voice, index) => (
        <div class="settings-row" data-voice-row={voice.key} hidden={index === 1 && !discussion}>
          <div class="settings-text">
            <label class="settings-label" for={`${id}-${voice.key}`} data-voice-label data-name={voice.name}>
              {discussion ? voice.name : `Voice (${voice.name})`}
            </label>
          </div>
          <div class="daily-selects daily-selects-one podcast-voice">
            <span class="manage-select">
              <select
                class="manage-input"
                id={`${id}-${voice.key}`}
                data-f={`${id}.${voice.key}`}
                data-saved={voice.saved ?? ""}
                autocomplete="off"
              >
                <option value="">Default</option>
                {voice.saved && <option value={voice.saved} selected>Saved voice</option>}
              </select>
              <Icon name="chevronDown" />
            </span>
            {/* The play chip, as every play control in the app is drawn. Choosing a voice plays its
                 sample too, so a list can be heard one voice at a time. */}
            <button
              class="chip podcast-sample"
              type="button"
              data-preview
              hidden
              aria-pressed="false"
              aria-label={`Play a sample of the ${voice.name} voice`}
            >
              <span class="chip-glyph" aria-hidden="true">
                <Icon name="play" class="sample-play" />
                <Icon name="pause" class="sample-pause" />
              </span>
              <span aria-hidden="true">Sample</span>
            </button>
          </div>
        </div>
      ))
    }
  </div>
</div>
