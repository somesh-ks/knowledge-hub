---
import Select from "../design-system/Select.astro";
import "../styles/field.css";
import { SUPPORTED_TIMEZONES, zoneLabel } from "@singularity/core";
import Switch from "../design-system/Switch.astro";
import { LENGTHS } from "../lib/createForm";
import { CADENCES, hourLabel, WEEKDAYS } from "../lib/schedule";
import Icon from "./Icon.astro";
import "../styles/picker.css";

interface Props {
  /** The profile: its fields are named and identified by it, as the engine's schedule file names them. */
  id: "daily" | "weekly";
  /** The saved values. A field the profile has no row for is ignored. */
  values: {
    /** The schedule's time zone, one setting both profiles show. */
    timezone: string;
    /** Whether the podcast is made at all; off, the rest of the page is disabled and dimmed. */
    enabled: boolean;
    hour?: number;
    day?: number;
    cadenceDays?: number;
    /** Topic ids the episode leaves out. */
    skipTopics: readonly string[];
    lengthMinutes: number;
  };
  /**
   * Every topic. A person can put Design, AI and Technology, and their own, in or out of this
   * podcast; `ids` are the topics each one stands for, which is what the schedule's skip list holds.
   */
  topics?: readonly { id: string; name: string; ids: readonly string[] }[];
  /** Every topic id the build knew, chip or not: a topic saved since then gets a chip (savedView.ts). */
  builtTopics?: readonly string[];
}

const { id, values, topics = [], builtTopics = [] } = Astro.props;
const label = id === "daily" ? "Daily" : "Weekly";

const hours = Array.from({ length: 24 }, (_, value) => value);
// The offset a zone has today. The page is built once, so the script works it out again in the
// browser (scripts/picker.ts reads the options as they are), and a change of clocks since the build
// shows at once.
const builtAt = new Date();
const zones = SUPPORTED_TIMEZONES.map((zone) => ({
  value: zone.value,
  label: zoneLabel(zone, builtAt),
}));
// A topic is in the podcast unless every topic it stands for is on the skip list.
const inScope = (ids: readonly string[]): boolean =>
  !ids.every((topic) => values.skipTopics.includes(topic));
---

<div class="podcast-profile" data-profile={id}>
  {/* The on/off switch (2026-10-26, Q16). Off, the controls below are disabled and dimmed, not
       hidden, and a quiet line says why; the page script keeps the fieldset in step (podcastPage.ts). */}
  <section class="podcast-section" aria-label={`${label} podcast`}>
    <div class="rows card-group">
      <div class="settings-row">
        <label class="settings-label" for={`${id}-enabled`}>{label} podcast</label>
        <Switch
          id={`${id}-enabled`}
          data-f={`${id}.enabled`}
          checked={values.enabled}
          autocomplete="off"
        />
      </div>
    </div>
    <p class="settings-hint podcast-hint" data-off-note hidden={values.enabled}>
      Off: no {label.toLowerCase()} podcast is made
    </p>
  </section>

  <fieldset class="manage-fields podcast-body" data-body disabled={!values.enabled}>
  <section class="podcast-section" aria-labelledby={`${id}-episode-head`}>
    <h2 class="section-head" id={`${id}-episode-head`}>Episode</h2>
    <div class="rows card-group">
      <div class="settings-row">
        <label class="settings-label" for={`${id}-length`}>Max length</label>
        <Select class="value-select" id={`${id}-length`} data-f={`${id}.length`} autocomplete="off">
          {LENGTHS.map((entry) => (
            <option value={String(entry.value)} selected={entry.value === values.lengthMinutes}>
              {entry.label}
            </option>
          ))}
        </Select>
      </div>
    </div>
  </section>

  <section class="podcast-section" aria-labelledby={`${id}-schedule-head`}>
    <h2 class="section-head" id={`${id}-schedule-head`}>Schedule</h2>
    <div class="rows card-group">
      {/* One setting for both podcasts: the cron route, the gate and the next line count on its clock. */}
      <div class="settings-row">
        <label class="settings-label" for={`${id}-timezone`}>Time zone</label>
        <Select class="value-select"
            id={`${id}-timezone`}
            data-f={`${id}.timezone`}
            data-picker="time zone"
            autocomplete="off">
          {zones.map((zone, index) => (
            <option
              value={zone.value}
              data-place={SUPPORTED_TIMEZONES[index]?.label}
              data-keywords={zone.value.replaceAll("_", " ")}
              selected={zone.value === values.timezone}
            >
              {zone.label}
            </option>
          ))}
        </Select>
      </div>
      {
        id === "weekly" && (
          <div class="settings-row">
            <label class="settings-label" for="weekly-day">Day</label>
            <Select class="value-select" id="weekly-day" data-f="weekly.day" autocomplete="off">
              {WEEKDAYS.map((name, value) => (
                <option value={value} selected={value === values.day}>{name}</option>
              ))}
            </Select>
          </div>
        )
      }
      <div class="settings-row">
        <label class="settings-label" for={`${id}-hour`}>Time</label>
        <Select class="value-select" id={`${id}-hour`} data-f={`${id}.hour`} data-wheel autocomplete="off">
          {hours.map((value) => (
            <option value={value} selected={value === values.hour}>{hourLabel(value)}</option>
          ))}
        </Select>
      </div>
      {
        id === "daily" && (
          <div class="settings-row">
            <div class="settings-text">
              <label class="settings-label" for="daily-cadence">Repeat</label>
            </div>
            <Select class="value-select"
                id="daily-cadence"
                data-f="daily.cadence"
                autocomplete="off">
              {CADENCES.map((cadence) => (
                <option value={cadence.days} selected={cadence.days === values.cadenceDays}>
                  {cadence.label}
                </option>
              ))}
            </Select>
          </div>
        )
      }
    </div>
  </section>

  <section class="podcast-section" aria-labelledby={`${id}-topics-head`}>
    <h2 class="section-head" id={`${id}-topics-head`}>Categories</h2>
    {
      topics.length > 0 ? (
        <fieldset class="filter-chips podcast-topics card-group" aria-labelledby={`${id}-topics-head`} data-scope-chips data-built-topics={builtTopics.join(" ")}>
          {topics.map((topic) => (
            <label class="filter-chip">
              <input
                type="checkbox"
                data-scope={id}
                data-scope-ids={topic.ids.join(" ")}
                checked={inScope(topic.ids)}
                autocomplete="off"
              />
              <Icon name="check" class="filter-chip-check" />
              <span>{topic.name}</span>
            </label>
          ))}
        </fieldset>
      ) : (
        <p class="manage-quiet">No categories yet.</p>
      )
    }
    {
      topics.length > 0 && (
        <p class="settings-hint podcast-hint" data-no-topics hidden={topics.some((topic) => inScope(topic.ids))}>
          No categories chosen, so {label} episodes have nothing to cover.
        </p>
      )
    }
  </section>
  </fieldset>
</div>
