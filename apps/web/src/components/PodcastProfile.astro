---
import { FORMATS, LENGTHS } from "../lib/createForm";
import { CADENCES, hourLabel, WEEKDAYS } from "../lib/schedule";
import { weeklyNote } from "../lib/settingsSummary";
import Icon from "./Icon.astro";

interface Props {
  /** The profile: its fields are named and identified by it, as the engine's schedule file names them. */
  id: "daily" | "weekly";
  /** The saved values. A field the profile has no row for is ignored. */
  values: {
    enabled?: boolean;
    hour?: number;
    day?: number;
    cadenceDays?: number;
    /** Topic ids the episode leaves out. */
    skipTopics: readonly string[];
    format: string;
    lengthMinutes: number;
    voiceId: string | null;
    voiceIdB: string | null;
  };
  /**
   * The topics a person can put in or out of this podcast: Design, AI and Technology, and their own.
   * `ids` are the topics each one stands for, which is what the schedule's skip list holds.
   */
  topics?: readonly { id: string; name: string; ids: readonly string[] }[];
  /** Daily only: the weekly podcast, whose day (0 = Sunday) has no daily episode while it is on. */
  weekly?: { enabled: boolean; day: number };
}

const { id, values, topics = [], weekly } = Astro.props;
const label = id === "daily" ? "Daily" : "Weekly";
// Worked out again in the browser from the data on it when a weekly edit is saved (savedView.ts).
const sundayNote = weekly ? weeklyNote(weekly) : null;

const hours = Array.from({ length: 24 }, (_, value) => value);
// A topic is in the podcast unless every topic it stands for is on the skip list.
const inScope = (ids: readonly string[]): boolean =>
  !ids.every((topic) => values.skipTopics.includes(topic));

// A stored Headlines schedule has no radio to show; the first change picks one of the two.
const VOICES = [
  {
    key: "voice",
    saved: values.voiceId,
    name: "Voice",
    hint: "Reads the episode, or leads a discussion",
  },
  { key: "voice_b", saved: values.voiceIdB, name: "Second voice", hint: "Joins in discussions" },
] as const;
---

<div class="podcast-profile" data-profile={id}>
  {
    id === "weekly" && (
      <div class="rows podcast-enable">
        <div class="settings-row">
          <label class="settings-label" for="weekly-enabled">Weekly podcast</label>
          <input
            class="settings-switch"
            id="weekly-enabled"
            type="checkbox"
            role="switch"
            data-f="weekly.enabled"
            checked={values.enabled}
            autocomplete="off"
          />
        </div>
      </div>
    )
  }

  <section class="podcast-section" aria-labelledby={`${id}-schedule-head`}>
    <h2 class="section-head" id={`${id}-schedule-head`}>Schedule</h2>
    <div class="rows">
      {
        id === "weekly" && (
          <div class="settings-row">
            <label class="settings-label" for="weekly-day">Day</label>
            <span class="manage-select value-select">
              <select class="manage-input" id="weekly-day" data-f="weekly.day" autocomplete="off">
                {WEEKDAYS.map((name, value) => (
                  <option value={value} selected={value === values.day}>{name}</option>
                ))}
              </select>
              <Icon name="chevronDown" />
            </span>
          </div>
        )
      }
      <div class="settings-row">
        <div class="settings-text">
          <label class="settings-label" for={`${id}-hour`}>Time</label>
          {/* Every schedule counts in Stockholm time: the cron route, the gate and the next line. */}
          <span class="settings-hint" id={`${id}-hour-zone`}>Stockholm time</span>
        </div>
        <span class="manage-select value-select">
          <select
            class="manage-input"
            id={`${id}-hour`}
            data-f={`${id}.hour`}
            aria-describedby={`${id}-hour-zone`}
            autocomplete="off"
          >
            {hours.map((value) => (
              <option value={value} selected={value === values.hour}>{hourLabel(value)}</option>
            ))}
          </select>
          <Icon name="chevronDown" />
        </span>
      </div>
      {
        id === "daily" && (
          <div class="settings-row">
            <div class="settings-text">
              <label class="settings-label" for="daily-cadence">Repeat</label>
              <span
                class="settings-hint"
                id="daily-cadence-note"
                data-weekly-note
                data-weekly-enabled={String(weekly?.enabled ?? false)}
                data-weekly-day={weekly?.day ?? 0}
                hidden={!sundayNote}
              >
                {sundayNote}
              </span>
            </div>
            <span class="manage-select value-select">
              <select
                class="manage-input"
                id="daily-cadence"
                data-f="daily.cadence"
                aria-describedby="daily-cadence-note"
                autocomplete="off"
              >
                {CADENCES.map((cadence) => (
                  <option value={cadence.days} selected={cadence.days === values.cadenceDays}>
                    {cadence.label}
                  </option>
                ))}
              </select>
              <Icon name="chevronDown" />
            </span>
          </div>
        )
      }
    </div>
  </section>

  <section class="podcast-section" aria-labelledby={`${id}-topics-head`}>
    <h2 class="section-head" id={`${id}-topics-head`}>Topics</h2>
    <p class="settings-hint podcast-hint" id={`${id}-topics-hint`}>Choose what {label} episodes cover.</p>
    {
      topics.length > 0 ? (
        <fieldset class="filter-chips podcast-topics" aria-labelledby={`${id}-topics-head`} aria-describedby={`${id}-topics-hint`} data-scope-chips>
          {topics.map((topic) => (
            <label class="filter-chip">
              <input
                type="checkbox"
                data-scope={id}
                data-scope-ids={topic.ids.join(" ")}
                checked={inScope(topic.ids)}
                autocomplete="off"
              />
              <Icon name="check" class="filter-chip-check" />
              <span>{topic.name}</span>
            </label>
          ))}
        </fieldset>
      ) : (
        <p class="manage-quiet">No topics yet.</p>
      )
    }
    {
      topics.length > 0 && (
        <p class="settings-hint podcast-hint" data-no-topics hidden={topics.some((topic) => inScope(topic.ids))}>
          No topics chosen, so {label} episodes have nothing to cover.
        </p>
      )
    }
    <div class="rows">
      <a class="row-action" href="/settings/topics">
        <span class="settings-text">
          <span class="settings-label">Topics and sources</span>
          <span class="settings-hint">Add topics and choose their sources</span>
        </span>
        <Icon name="chevronRight" />
      </a>
    </div>
  </section>

  <section class="podcast-section" aria-labelledby={`${id}-episode-head`}>
    <h2 class="section-head" id={`${id}-episode-head`}>Episode</h2>
    <div class="rows">
      <div class="settings-row" data-layout="choice">
        <div class="settings-text">
          <span class="settings-label" id={`${id}-format-label`}>Format</span>
        </div>
        <fieldset class="settings-choice" role="radiogroup" aria-labelledby={`${id}-format-label`}>
          {
            FORMATS.map((entry) => (
              <label class="settings-segment">
                <input
                  type="radio"
                  name={`${id}-format`}
                  value={entry.value}
                  data-f={`${id}.format`}
                  checked={entry.value === values.format}
                  autocomplete="off"
                />
                <span>{entry.label}</span>
              </label>
            ))
          }
        </fieldset>
      </div>

      <div class="settings-row" data-layout="choice">
        <div class="settings-text">
          <span class="settings-label" id={`${id}-length-label`}>Length</span>
        </div>
        <fieldset class="settings-choice" role="radiogroup" aria-labelledby={`${id}-length-label`}>
          {
            LENGTHS.map((entry) => (
              <label class="settings-segment">
                <input
                  type="radio"
                  name={`${id}-length`}
                  value={String(entry.value)}
                  data-f={`${id}.length`}
                  checked={entry.value === values.lengthMinutes}
                  autocomplete="off"
                />
                <span class="num">{entry.label}</span>
              </label>
            ))
          }
        </fieldset>
      </div>
    </div>
  </section>

  <section class="podcast-section" aria-labelledby={`${id}-voices-head`}>
    <h2 class="section-head" id={`${id}-voices-head`}>Voices</h2>
    <div class="rows">
      {
        VOICES.map((voice) => (
          <div class="settings-row" data-voice-row={voice.key}>
            <div class="settings-text">
              <label class="settings-label" for={`${id}-${voice.key}`}>{voice.name}</label>
              <span class="settings-hint">{voice.hint}</span>
            </div>
            <div class="podcast-voice">
              <span class="manage-select value-select">
                <select
                  class="manage-input"
                  id={`${id}-${voice.key}`}
                  data-f={`${id}.${voice.key}`}
                  data-saved={voice.saved ?? ""}
                  autocomplete="off"
                >
                  <option value="">Default</option>
                  {voice.saved && <option value={voice.saved} selected>Saved voice</option>}
                </select>
                <Icon name="chevronDown" />
              </span>
              {/* A round play button, as every play control in the app is drawn. Choosing a voice plays
                   its sample too, so a list can be heard one voice at a time. It keeps its room while
                   the voice has no sample, so the select never moves when the list arrives. */}
              <button
                class="podcast-sample"
                type="button"
                data-preview
                hidden
                aria-pressed="false"
                aria-label={`Play a sample of the ${voice.name.toLowerCase()}`}
              >
                <Icon name="play" class="sample-play" />
                <Icon name="pause" class="sample-pause" />
              </button>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</div>
