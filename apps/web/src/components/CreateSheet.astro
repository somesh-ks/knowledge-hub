---
import CreateForm from "./CreateForm.astro";
import SheetHeader from "./SheetHeader.astro";
---

{/* The Create sheet, kept inert in a template: nothing in it is on the page, so its ids and fields
     cost nothing until scripts/createSheet.ts clones it on the first press of a Create button. A
     full-screen dialog on a phone and a side panel on the right from 40rem. One header row
     (SheetHeader.astro): the title at its start, Close at its end; the form scrolls under it and its button stays at the foot of the sheet. */}
<template id="create-sheet-template">
  <dialog class="create-sheet" aria-labelledby="create-sheet-title">
    <SheetHeader title="Catch up" titleId="create-sheet-title" close="data-create-close" />
    <div class="create-sheet-body">
      <CreateForm />
    </div>
  </dialog>
</template>
