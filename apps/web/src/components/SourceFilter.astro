---
import Button from "../design-system/Button.astro";
import type { ManageSource } from "../lib/manage";
import { FORMAT_LABEL } from "../lib/sourceFilter";
import Icon from "./Icon.astro";

interface Props {
  /** Every source the filter covers: the page's own list, or all of them on the index. */
  sources: ManageSource[];
  /** Tabs for the formats the sources use, All first (a category's page). The index has none. */
  chips?: boolean;
}

const { sources, chips = false } = Astro.props;
const formats = Object.entries(FORMAT_LABEL)
  .filter(([format]) => sources.some((source) => source.format === format))
  .map(([format, label]) => ({ format, label }));
// One format has nothing to tell apart: no tab would change the list.
const shownChips = chips && formats.length > 1;
---

{/* One search field over a list of source rows and, on a category's page, the formats as tabs: All,
     then one per format the sources use, one chosen at a time (2026-10-25, replacing the chips; the
     strip is primitives.css .tabs). The field is the Library's (.search-field). The state is read
     and written by sourceFilter.ts from the rows' data-text and data-format.
     Whole static HTML without the script: the list simply stays unfiltered. */}
{/* With tabs the block sticks under the app bar (topics.css) at every width, so it pins the bar
     (SiteHeader.astro, data-pins-bar): a bar that slid away and back moved the block by its height. */}
<div
  class="source-filter"
  data-filter
  data-chips={shownChips ? "" : undefined}
  data-pins-bar={shownChips ? "" : undefined}
  data-needs-js
>
  <div class="filter-row">
    <div class="search-wrap filter-field">
      <label class="search-field">
        <Icon name="search" />
        <span class="sr-only">Search sources</span>
        <input
          type="search"
          name="q"
          placeholder="Search sources"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          enterkeyhint="search"
          data-filter-q
        />
      </label>
      <button class="search-clear press press-subtle" type="button" aria-label="Clear text" data-filter-clear-text hidden>
        <Icon name="close" />
      </button>
    </div>
    {/* The page's add action beside the field, where the wide layout has no floating button. */}
    <slot name="action" />
  </div>
  {
    shownChips && (
      <div class="tabs tabs-in-card scroll-fade-inline" role="tablist" aria-label="Type">
        <button class="tab" type="button" role="tab" aria-selected="true" data-tab="">
          All
        </button>
        {formats.map((tab) => (
          <button class="tab" type="button" role="tab" aria-selected="false" data-tab={tab.format}>
            {tab.label}
          </button>
        ))}
      </div>
    )
  }
  <p class="filter-none" role="status" hidden data-filter-none>
    <span>No sources match.</span>
    <Button variant="text" data-filter-clear>Clear</Button>
  </p>
</div>
