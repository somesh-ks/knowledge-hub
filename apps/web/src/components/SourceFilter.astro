---
import type { ManageSource } from "../lib/manage";
import { FORMAT_LABEL } from "../lib/sourceFilter";
import Icon from "./Icon.astro";

interface Props {
  /** Every source the filter covers: the page's own list, or all of them on the index. */
  sources: ManageSource[];
  /** Chips for the formats the sources use (a topic's page). The index has none. */
  chips?: boolean;
}

const { sources, chips = false } = Astro.props;
const formats = Object.entries(FORMAT_LABEL)
  .filter(([format]) => sources.some((source) => source.format === format))
  .map(([format, label]) => ({ format, label }));
// One format has nothing to tell apart: no chip would change the list.
const shownChips = chips && formats.length > 1;
---

{/* One search field over a list of source rows and, on a topic's page, the formats as chips. Both are
     the Library's (primitives.css: .search-field, .filter-chip), so a search and a chip look the same
     on every page (2026-10-21). Any number of chips may be chosen and none means everything. The state
     is read and written by sourceFilter.ts from the rows' data-text and data-format.
     Whole static HTML without the script: the list simply stays unfiltered. */}
{/* With chips the block sticks under the app bar (topics.css), so it pins the bar (SiteHeader.astro,
     data-pins-bar): a bar that slid away and back moved the block by its height each time. */}
<div
  class="source-filter"
  data-filter
  data-chips={shownChips ? "" : undefined}
  data-pins-bar={shownChips ? "" : undefined}
  data-needs-js
>
  <div class="filter-row">
    <div class="search-wrap filter-field">
      <label class="search-field">
        <Icon name="search" />
        <span class="sr-only">Search sources</span>
        <input
          type="search"
          name="q"
          placeholder="Search sources"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          enterkeyhint="search"
          data-filter-q
        />
      </label>
      <button class="search-clear press press-subtle" type="button" aria-label="Clear text" data-filter-clear-text hidden>
        <Icon name="close" />
      </button>
    </div>
    {/* The page's add action beside the field, where the wide layout has no floating button. */}
    <slot name="action" />
  </div>
  {
    shownChips && (
      <fieldset class="filter-chips filter-chips-scroll" aria-label="Type">
        {formats.map((chip) => (
          <label class="filter-chip">
            <input type="checkbox" name="type" value={chip.format} data-chip={chip.format} />
            <Icon name="check" class="filter-chip-check" />
            <span>{chip.label}</span>
          </label>
        ))}
      </fieldset>
    )
  }
  <p class="filter-none" role="status" hidden data-filter-none>
    <span>No sources match.</span>
    <button class="btn" type="button" data-filter-clear>Clear</button>
  </p>
</div>
