---
import type { IconName } from "../lib/icons";
import Icon from "./Icon.astro";

interface Action {
  label: string;
  href: string;
  /** Loads the address from the network instead of swapping the page in place. */
  reload?: boolean;
}

interface Props {
  icon?: IconName;
  title?: string;
  body?: string;
  primary?: Action;
  /** A second way on, as a text button. null for none. */
  secondary?: Action | null;
}

// With no props this is the page for a site that has no briefings yet. It offers what any reader
// can do: look again, or open settings. Generating a briefing is an owner tool and lives there.
const {
  icon = "today",
  title = "No briefings yet",
  body = "The first one arrives within two days.",
  primary = { label: "Check again", href: "/", reload: true },
  secondary = { label: "Settings", href: "/settings" },
} = Astro.props;
---

{/* A page with nothing to list: a quiet icon, a title, one sentence and one way on. */}
<section class="empty" aria-labelledby="page-title">
  <Icon name={icon} class="empty-icon" />
  <h1 class="page-title" id="page-title" tabindex="-1">{title}</h1>
  <p>{body}</p>
  <div class="empty-actions">
    <a class="btn-secondary" href={primary.href} data-astro-reload={primary.reload}>
      {primary.label}
    </a>
    {secondary && <a class="btn" href={secondary.href}>{secondary.label}</a>}
  </div>
</section>
