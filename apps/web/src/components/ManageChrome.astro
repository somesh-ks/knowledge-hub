---
import { PASSPHRASE_REQUIRED } from "../lib/access";
import Icon from "./Icon.astro";
---

{/* What the settings pages share besides their rows: the live regions the script writes to (one
     polite, one for errors), the row it copies for a topic added on the page, the toast that says how
     saving goes (scripts/autosave.ts; it looks and sits like every toast, and leaves speaking to the
     regions), and the dialog that asks for the passphrase once. All of it is inert until the page's
     script mounts. */}
<p class="sr-only" role="status" data-live></p>
<p class="sr-only" role="alert" data-alert></p>

<template>
  <li class="manage-row" data-queued-row>
    <div class="manage-main">
      <div class="manage-text">
        <span class="manage-name" data-q-name></span>
        <span class="manage-quiet">Adding</span>
      </div>
      <button class="icon-btn press" type="button" data-act="cancel">
        <Icon name="close" />
      </button>
    </div>
  </li>
</template>

<div class="toast manage-bar" popover="manual" data-bar data-state="saving">
  <span class="spinner manage-bar-busy" aria-hidden="true"></span>
  <Icon name="check" class="toast-icon manage-bar-done" />
  <Icon name="alert" class="toast-icon manage-bar-error" />
  <span class="toast-text" data-bar-text></span>
  <button class="toast-action" type="button" data-act="undo">Undo</button>
  <button class="toast-action" type="button" data-act="retry">Retry</button>
  <button class="toast-dismiss press" type="button" data-act="dismiss" aria-label="Dismiss">
    <Icon name="close" />
  </button>
</div>

{PASSPHRASE_REQUIRED && (
<dialog class="manage-dialog" aria-labelledby="manage-dialog-title">
  <form method="dialog" class="manage-dialog-form">
    <h2 id="manage-dialog-title">Save changes</h2>
    <div class="manage-field">
      <label for="manage-passphrase">Passphrase</label>
      <input
        class="manage-input"
        id="manage-passphrase"
        type="password"
        required
        autocomplete="current-password"
        data-passphrase
      />
    </div>
    <label class="manage-check">
      <input type="checkbox" data-remember />
      <span>Remember on this device</span>
    </label>
    <div class="manage-dialog-actions">
      <button class="btn press press-subtle" type="button" data-act="close">Cancel</button>
      <button class="btn-primary press press-subtle" type="submit" value="ok">Continue</button>
    </div>
  </form>
</dialog>
)}
