---
import type { DigestEntry } from "../lib/digests";
import ArchiveRow from "./ArchiveRow.astro";
import Icon from "./Icon.astro";

interface Props {
  entries: DigestEntry[];
}

const { entries } = Astro.props;
---

<section class="earlier" aria-labelledby="earlier-title">
  <h2 class="section-title" id="earlier-title">Earlier</h2>
  {
    entries.length > 0 && (
      <ul class="archive-list" role="list">
        {entries.map((entry) => <ArchiveRow entry={entry} />)}
      </ul>
    )
  }
  <a class="btn-secondary earlier-all press press-subtle" href="/archive">All briefings<Icon name="chevronRight" /></a>
</section>
