---
import type { DigestEntry } from "../lib/digests";
import BriefingCard from "./BriefingCard.astro";

interface Props {
  entries: DigestEntry[];
}

const { entries } = Astro.props;
---

{/* The oldest briefing has nothing before it, and the Library is one tap away in the navigation,
     so the shelf is left out there instead of standing empty. */}
{
  entries.length > 0 && (
    <section class="earlier rule-above" aria-labelledby="earlier-title">
      <div class="shelf-head">
        <h2 id="earlier-title">Other episodes</h2>
        <a class="btn" href="/library" data-astro-prefetch="hover">
          See all
        </a>
      </div>
      <ul class="shelf" role="list">
        {entries.map((entry) => <BriefingCard entry={entry} />)}
      </ul>
    </section>
  )
}
