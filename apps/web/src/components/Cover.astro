---
import CoverPlay from "./CoverPlay.astro";

interface Props {
  digestId: string;
  size: "thumb" | "row" | "card" | "hero" | "aside" | "player";
  /** Box color shown before the image decodes, from the cover palette. */
  paletteBg: string;
  /** Weekly digests carry a framing rule so a deep dive reads as a different record. */
  weekly: boolean;
  /** The one cover that is the page's largest paint loads eagerly and first. */
  priority?: boolean;
}

const { digestId, size, paletteBg, weekly, priority = false } = Astro.props;

// Display width of each size, so the browser picks the 512 or the 1024 image for the screen's density.
const SIZES: Record<Props["size"], string> = {
  thumb: "2.75rem",
  row: "2.5rem",
  card: "(min-width: 40rem) 11rem, 45vw",
  hero: "(min-width: 40rem) 11rem, 8.5rem",
  aside: "14rem",
  player: "22rem",
};
---

<span class="cover" data-size={size} data-weekly={weekly ? "" : undefined} style={`--cover-bg:${paletteBg}`}>
  <img
    class="cover-image"
    src={`/covers/${digestId}-512.webp`}
    srcset={`/covers/${digestId}-512.webp 512w, /covers/${digestId}-1024.webp 1024w`}
    sizes={SIZES[size]}
    width="512"
    height="512"
    alt=""
    draggable="false"
    decoding="async"
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : undefined}
  />
  {weekly && <span class="cover-frame" aria-hidden="true"></span>}
  {/* The cover on an item's own page plays it in place. A list's card adds its own button beside the link. */}
  {size === "hero" && <CoverPlay digestId={digestId} pointerOnly />}
</span>
