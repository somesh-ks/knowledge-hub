---
import { COVER_MODES, COVER_STYLES, type CoverMode } from "@singularity/cover";
import { type CoverSize, type CoverSource, coverEdge, themedCoverSrc } from "../lib/covers";
import CoverPlay from "./CoverPlay.astro";

interface Props {
  digestId: string;
  size: "thumb" | "row" | "card" | "hero" | "aside" | "player";
  /** What the cover is drawn from; it is drawn once for each theme and the page shows its own. */
  source: CoverSource;
  /** Weekly digests carry a framing rule so a deep dive reads as a different record. */
  weekly: boolean;
  /** The one cover that is the page's largest paint loads eagerly and first. */
  priority?: boolean;
}

const { digestId, size, source, weekly, priority = false } = Astro.props;
// The colour at the cover's edge in each theme, shown before the image decodes (cover.css picks one).
const edgeLight = coverEdge(source, "light");
const edgeDark = coverEdge(source, "dark");
// One image for each theme in each style (D311); the page shows the one that matches both (cover.css).
const looks = COVER_STYLES.flatMap((style) => COVER_MODES.map((mode) => ({ mode, style })));

/**
 * A pale ground needs a hairline to hold its edge on the light page; a deep one has its own edge, and
 * on the dark page every cover does. Relative luminance of the palette's ground, from its hex.
 */
function isPale(hex: string): boolean {
  const match = /^#?([0-9a-f]{6})$/i.exec(hex.trim());
  if (!match?.[1]) return false;
  const value = Number.parseInt(match[1], 16);
  const channel = (shift: number) => {
    const c = ((value >> shift) & 255) / 255;
    return c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
  };
  return 0.2126 * channel(16) + 0.7152 * channel(8) + 0.0722 * channel(0) > 0.6;
}

// The 1024 carries the Singularity signature (it is the player's own artwork), and at the size of a card,
// a row or a hero the signature is a few pixels of noise: only the player's cover offers it. The rest
// offer the 512, which never carries it, so a cover looks the same at every density and on every visit.
const widths: CoverSize[] = size === "player" ? [512, 1024] : [512];
const srcset = (mode: CoverMode, style: string) =>
  widths.map((width) => `${themedCoverSrc(digestId, mode, width, style)} ${width}w`).join(", ");

// Display width of each size, so the browser picks the 512 or the 1024 image for the screen's density.
const SIZES: Record<Props["size"], string> = {
  thumb: "2.75rem",
  row: "2.5rem",
  card: "(min-width: 40rem) 11rem, 45vw",
  hero: "(min-width: 40rem) 11rem, 8.5rem",
  aside: "14rem",
  player: "22rem",
};
---

<span
  class="cover"
  data-size={size}
  data-cover-id={digestId}
  data-weekly={weekly ? "" : undefined}
  data-pale={isPale(edgeLight) ? "" : undefined}
  style={`--cover-bg-light:${edgeLight};--cover-bg-dark:${edgeDark}`}
>
  {/* One image per theme and style. The others are display: none, so a lazy one is never fetched; only
      Default's priority image loads eagerly, a style's loads as soon as it is shown. */}
  {looks.map(({ mode, style }) => (
    <img
      class="cover-image"
      data-mode={mode}
      data-cover-skin={style === "default" ? undefined : style}
      src={themedCoverSrc(digestId, mode, 512, style)}
      srcset={srcset(mode, style)}
      sizes={SIZES[size]}
      width="512"
      height="512"
      alt=""
      draggable="false"
      decoding="async"
      loading={priority && style === "default" ? "eager" : "lazy"}
      fetchpriority={priority && style === "default" ? "high" : undefined}
    />
  ))}
  {weekly && <span class="cover-frame" aria-hidden="true"></span>}
  {/* The cover on an item's own page plays it in place. A list's card adds its own button beside the link. */}
  {size === "hero" && <CoverPlay digestId={digestId} pointerOnly />}
</span>

<script>
  // A cover that is missing or fails to load shows the branded fallback (cover.css). The error does
  // not bubble, so it is caught on the way down; an image that failed before this ran is found by
  // its size, now and once the document is parsed. Only an image with a source that finished empty
  // counts: a lazy or hidden one has no source yet, so it is never mistaken for a failure. A failure
  // counts for the theme it belongs to: a priority cover loads both, and the one the page is not
  // showing may fail while the other is fine, so the fallback follows the shown theme, and the shown
  // style (D311).
  const shownMode = () => {
    const theme = document.documentElement.dataset.theme;
    if (theme === "light" || theme === "dark") return theme;
    return matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  };
  const shownStyle = () => document.documentElement.dataset.style;
  const sync = (cover: Element) => {
    const style = shownStyle();
    const mode = shownMode();
    const failedHere = cover.querySelector(
      `.cover-image[data-mode="${mode}"]${style ? `[data-cover-skin="${style}"]` : ":not([data-cover-skin])"}[data-failed]`,
    );
    cover.toggleAttribute("data-fallback", failedHere !== null);
  };
  const syncAll = () => {
    for (const cover of document.querySelectorAll(".cover")) sync(cover);
  };
  const failed = (image: Element) => {
    image.setAttribute("data-failed", "");
    const cover = image.closest(".cover");
    if (cover) sync(cover);
  };
  const scan = () => {
    for (const image of document.querySelectorAll<HTMLImageElement>(".cover-image")) {
      if (image.complete && image.currentSrc && image.naturalWidth === 0) failed(image);
    }
  };
  document.addEventListener(
    "error",
    (event) => {
      if (event.target instanceof HTMLImageElement && event.target.matches(".cover-image")) {
        failed(event.target);
      }
    },
    true,
  );
  scan();
  document.addEventListener("DOMContentLoaded", scan);
  new MutationObserver(syncAll).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme", "data-style"],
  });
  matchMedia("(prefers-color-scheme: dark)").addEventListener("change", syncAll);
</script>
