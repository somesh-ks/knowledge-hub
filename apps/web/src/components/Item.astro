---
import type { DigestItem } from "@dispatch/core";
import { sourceHost, sourceLinkLabel } from "../lib/sourceLabel";
import { idleStoryChip } from "../player/core/readerMath";
import Icon from "./Icon.astro";
import PlayChip from "./PlayChip.astro";

interface Props {
  item: DigestItem;
  /** Reading-order index. The same number the player uses and the one in data-play-item. */
  index: number;
  /** The story's length as "m:ss", or "" while the briefing has no audio. */
  length: string;
  hasAudio: boolean;
}

const { item, index, length, hasAudio } = Astro.props;
const titleId = `t-${item.id}`;
const chip = idleStoryChip(length, item.headline);
// Null for anything that is not an http or https address: such a story gets no link at all.
const host = sourceHost(item.url);
---

<article class="story" data-item-id={item.id} data-index={index} aria-labelledby={titleId}>
  <p class="meta meta-wrap">
    <span>{item.source}</span>
    {item.author && <span><span class="sr-only">by </span>{item.author}</span>}
  </p>
  <h3 class="story-title" id={titleId}>{item.headline}</h3>
  <p class="story-summary">{item.summary}</p>
  {item.why && <p class="story-why"><span class="story-why-label">Why</span>{" "}{item.why}</p>}
  <div class="story-actions">
    {/* Always in the page. Hidden while the briefing has no audio timeline, so audio that arrives
         later only has to reveal it. */}
    <PlayChip label={chip.label} aria-label={chip.name} data-play-item={index} hidden={!hasAudio} />
    {
      host && (
        <a
          class="source-link"
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={sourceLinkLabel(host)}
        >
          <span>{host}</span>
          <Icon name="openInNew" />
        </a>
      )
    }
  </div>
</article>
