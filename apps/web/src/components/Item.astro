---
import type { DigestItem } from "@singularity/core";
import { publisherOf } from "../lib/episodeHighlights";
import { headlineParts } from "../lib/format";
import { sourceHost } from "../lib/sourceLabel";
import { idleStoryChip } from "../player/core/readerMath";
import PlayChip from "./PlayChip.astro";
import StoryControls from "./StoryControls.astro";

interface Props {
  item: DigestItem;
  /** Reading-order index. The same number the player uses and the one in data-play-item. */
  index: number;
  /** The story's length as "m:ss", or "" while the briefing has no audio. */
  length: string;
  hasAudio: boolean;
}

const { item, index, length, hasAudio } = Astro.props;
const titleId = `t-${item.id}`;
// Hyphenated words stay whole when the balanced headline wraps (briefing.css).
const words = headlineParts(item.headline);
const chip = idleStoryChip(length, item.headline);
// Null for anything that is not an http or https address: such a story gets no link at all.
const host = sourceHost(item.url);
// The link names the publisher, or the host for an aggregator (episodeHighlights.ts).
const publisher = publisherOf(item.source, host);
---

<article
  class="story"
  data-item-id={item.id}
  data-index={index}
  aria-labelledby={host ? `${titleId}-text` : titleId}
>
  {/* The publisher, above the headline as a news list puts it: a quiet link to the page the
       headline opens. It is a second way to one place, so it stays out of the tab order and the
       accessibility tree, and the headline is the link a keyboard or a screen reader meets. */}
  {
    host && (
      <a
        class="source-link story-source"
        href={item.url}
        target="_blank"
        rel="noopener noreferrer"
        tabindex="-1"
        aria-hidden="true"
        title={publisher}
      >
        <span>{publisher}</span>
      </a>
    )
  }
  {/* The headline is the way to the story, as in any news list: a link to the source in a new tab.
       Its name starts with the words it shows, so a reader using voice control can say them; the
       new tab is said, not shown. The story is named by the headline's words alone. A story whose
       address must not become a link keeps a plain headline. */}
  <h3 class="story-title" id={titleId}>
    {
      host ? (
        <a class="story-link" href={item.url} target="_blank" rel="noopener noreferrer">
          {/* One line: a break inside the span would read as a space before the words. */}
          <span id={`${titleId}-text`}>{words.map((part) => (part.nowrap ? <span class="no-break">{part.text}</span> : part.text))}</span>
          <span class="sr-only">(opens in a new tab)</span>
        </a>
      ) : (
        words.map((part) => (part.nowrap ? <span class="no-break">{part.text}</span> : part.text))
      )
    }
  </h3>
  <p class="story-summary">{item.summary}</p>
  <div class="story-actions">
    {/* Always in the page. Hidden while the briefing has no audio timeline, so audio that arrives
         later only has to reveal it. */}
    <PlayChip label={chip.label} aria-label={chip.name} data-play-item={index} hidden={!hasAudio} />
    <StoryControls
      id={item.id}
      url={item.url}
      headline={item.headline}
      topic={item.category}
      source={item.source}
      outlet={publisher}
      canBlock={host !== null}
    />
  </div>
</article>
