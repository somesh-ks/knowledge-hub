---
interface Props {
  /** "Excellent", "Good", "Fair", "Poor" or "New". */
  label: string;
}

const { label } = Astro.props;
---

{/* A source's score as one word, on the line under its name (scoreNode in topicsView.ts draws the
     same). A new source says it is not scored yet; Poor is told apart by its weight as well as its
     colour, so colour is never alone. */}
<span class="score" data-label={label}>{label === "New" ? "Not scored yet" : label}</span>
