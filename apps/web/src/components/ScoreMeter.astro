---
import Icon from "../design-system/Icon.astro";

interface Props {
  /** "Excellent", "Good", "Fair", "Poor" or "New". */
  label: string;
  /** The score out of 5. */
  score?: number | null;
}

const { label, score = null } = Astro.props;
---

{/* A source's rating before its checkbox: a star and the score out of 5, "4.5" (D103). The word
     is for a screen reader and the row's tooltip; Poor is told apart by its weight as well as its
     colour, so colour is never alone. A new source reads New. */}
<span class="score" data-label={label} title={score === null ? "Not scored yet" : `${score.toFixed(1)} of 5, ${label}`}>
  {
    label === "New" || score === null ? (
      <span class="score-new">New</span>
    ) : (
      <>
        <Icon name="star" class="score-star" />
        <span class="score-number" aria-hidden="true">{score.toFixed(1)}</span>
        <span class="sr-only">{`Rated ${score.toFixed(1)} of 5, ${label}`}</span>
      </>
    )
  }
</span>
