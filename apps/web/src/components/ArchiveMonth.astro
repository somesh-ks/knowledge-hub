---
import type { ArchiveMonth } from "../lib/archive";
import { pluralize } from "../lib/format";
import ArchiveRow from "./ArchiveRow.astro";
import Icon from "./Icon.astro";

interface Props {
  month: ArchiveMonth;
  open: boolean;
}

const { month, open } = Astro.props;
---

<details class="month-group" open={open}>
  <summary>
    <span>{month.label}</span>
    <span class="month-count">{pluralize(month.entries.length, "briefing")}<Icon name="chevronDown" /></span>
  </summary>
  <ul class="month-body archive-list" role="list">
    {month.entries.map((entry) => <ArchiveRow entry={entry} />)}
  </ul>
</details>
