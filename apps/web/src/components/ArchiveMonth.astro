---
import type { ArchiveMonth } from "../lib/archive";
import ArchiveRow from "./ArchiveRow.astro";

interface Props {
  month: ArchiveMonth;
  year: string;
  /** Every month but the first on the page is ruled off from the one above it. */
  isFirst: boolean;
}

const { month, year, isFirst } = Astro.props;
const headingId = `m-${month.key}`;
---

<section class:list={["archive-month", { "rule-above": !isFirst }]} aria-labelledby={headingId}>
  <h2 class="section-head" id={headingId}>{month.label} {year}</h2>
  <ul class="rows archive-list" role="list">
    {month.entries.map((entry) => <ArchiveRow entry={entry} />)}
  </ul>
</section>
