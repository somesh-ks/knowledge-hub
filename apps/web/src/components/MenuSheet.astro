---
import SheetHeader from "./SheetHeader.astro";

interface Props {
  id: string;
  /** The sheet's header on a phone, and the menu's name for a screen reader. */
  title: string;
  /** Any class that places the popover under its own button (the anchor of a row or a story). */
  class?: string;
}

const { id, title, class: className = "" } = Astro.props;
---

{/* Every ⋮ menu (2026-10-21): the header More menu's popover, which a phone shows as a bottom sheet
     with this header and a scrim, and from 40rem as the small menu under its button (hero.css,
     .menu-sheet). The items are .hero-menu-item buttons, each with its icon at the start; the keys,
     focus and Close are scripts/heroMenu.ts. */}
<div class:list={["hero-menu-list menu-sheet", className]} id={id} popover>
  <SheetHeader title={title} titleId={`${id}-title`} close="data-menu-close" />
  <div class="menu-sheet-items" role="menu" aria-label={title}>
    <slot />
  </div>
</div>
