---
/**
 * The Halloween style's scene for an empty state (D306): the same six places as EmptyArt, drawn with
 * their own subjects. It sits beside the Default svg; empty.css shows the one the chosen style names.
 * Colours are classes that empty.css maps to the `scene` tokens, as in EmptyArt. Decorative.
 */
import type { ArtName } from "./EmptyArt.astro";
import { batOffline, batOnline, cauldron, ghost, pumpkin, tombstone } from "./halloweenArt";

interface Props {
  art: ArtName;
  size?: "regular" | "compact";
}

const { art, size = "regular" } = Astro.props;

/** One scale for every scene (240 units across); each box is cropped to its drawing. */
const SCENES: Record<ArtName, { view: string; draw: () => string }> = {
  today: { view: "0 14 240 146", draw: pumpkin },
  library: { view: "0 14 240 146", draw: cauldron },
  results: { view: "0 14 240 146", draw: ghost },
  offline: { view: "0 8 240 146", draw: batOffline },
  online: { view: "0 8 240 156", draw: batOnline },
  notfound: { view: "0 14 240 146", draw: tombstone },
};
const scene = SCENES[art];
---

<svg
  class="empty-art"
  data-scene={art}
  data-look="halloween"
  data-size={size}
  viewBox={scene.view}
  aria-hidden="true"
  focusable="false"
  set:html={scene.draw()}
/>
