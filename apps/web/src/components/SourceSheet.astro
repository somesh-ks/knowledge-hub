---
import Icon from "./Icon.astro";

interface Props {
  /** The topics a source can be filed under, in the order the page lists them. */
  topics: { id: string; name: string }[];
}

const { topics } = Astro.props;
---

{/* The Add source panel, kept inert in a template until scripts/topicsSheet.ts clones it on the first
     press of Add source. It wears the Create sheet's looks (create-sheet.css) and is not that sheet:
     regen-sheet keeps createSheet.ts from taking it for the Create panel. A full-screen sheet on a
     phone and a side panel from 40rem. The preview card has a fixed height, so nothing moves while it
     loads. */}
<template id="source-sheet-template">
  <dialog class="create-sheet regen-sheet source-sheet" aria-labelledby="source-sheet-title">
    <div class="create-sheet-head">
      <h2 class="sheet-title" id="source-sheet-title">Add a source</h2>
      <button class="icon-btn press" type="button" data-sheet-close aria-label="Close">
        <Icon name="close" class="icon-lg" />
      </button>
    </div>
    <div class="create-sheet-body">
      <div class="manage-form source-form">
        <div class="manage-field">
          <label for="source-url">Site or feed address</label>
          <input
            class="manage-input"
            id="source-url"
            name="url"
            type="url"
            inputmode="url"
            maxlength="2048"
            autocomplete="off"
            autocapitalize="none"
            spellcheck="false"
            placeholder="example.com"
            data-sheet-url
          />
        </div>
        <div class="manage-field">
          <label for="source-topic">Topic</label>
          <div class="manage-select">
            <select class="manage-input" id="source-topic" name="topic" data-sheet-topic>
              {topics.map((topic) => <option value={topic.id}>{topic.name}</option>)}
              <option value="" selected>Other</option>
            </select>
            <Icon name="chevronDown" />
          </div>
        </div>
        <div class="source-preview" aria-live="polite" data-sheet-preview data-state="idle"></div>
      </div>
    </div>
    <div class="source-sheet-foot">
      <button class="btn-primary press press-subtle" type="button" disabled data-sheet-add>
        <Icon name="plus" />
        <span>Add source</span>
      </button>
    </div>
  </dialog>
</template>
