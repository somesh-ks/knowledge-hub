---
import { isGeneralTopicId } from "@dispatch/core";
import type { ManageSource } from "../lib/manage";
import { readableUrl } from "../lib/manage";
import { FORMAT_LABEL, searchText, statusesOf } from "../lib/sourceFilter";
import { sourceInitial } from "../lib/sourceInitial";
import ScoreMeter from "./ScoreMeter.astro";

interface Props {
  source: ManageSource;
  /** The name of the topic the source is filed under; empty for Other. */
  topicName?: string;
  /**
   * The topic the edit panel shows as the source's own, when the page stands for several (one of
   * the owner's three topics): the group's home, so choosing the same group moves nothing.
   */
  shownTopic?: { id: string; name: string } | undefined;
  /** On the index's flat list, the line that says what the source is and where it is filed. */
  labelled?: boolean;
}

const { source, topicName = "", shownTopic, labelled = false } = Astro.props;
// The address as a person reads it; the row's title holds all of it.
const address = readableUrl(source.url) || source.host;
// The bands of a score out of 5: Good is 3.5 and up, Fair 2.5 to 3.5, Poor under 2.5, New has none.
const band =
  source.score === null
    ? "new"
    : source.score >= 3.5
      ? "good"
      : source.score >= 2.5
        ? "fair"
        : "poor";
// What the edit panel shows about the source (topicsPanel.ts, SourceFacts).
const facts = {
  id: source.id,
  name: source.name,
  topic_id: shownTopic?.id ?? source.topic_id ?? "",
  topic_name: shownTopic?.name ?? topicName,
  url: source.url,
  host: source.host,
  score: source.score,
  label: source.score_label,
  parts: source.score_parts,
  format: source.format,
  /** A general news source can be rated; "" is unrated. */
  general: source.topic_ids.some((id) => isGeneralTopicId(id)),
  lean: source.lean === null ? "" : String(source.lean),
};
---

{/* One source under its topic. The row opens the source to edit: one button behind everything,
     the row's own size, so no part of it is a dead zone. Over it sit the tile, the name, a line with
     the site, the rating (a star and the score out of 5) and the checkbox, which says whether the source is read. The name is
     plain words: the edit panel links to the site. Everything else lets a press through to the button. The tile shows the name's
     first letter, and the site's own icon covers it once it loads (topicsPage.ts marks it loaded),
     so a site without an icon still has a face. An off row keeps its place and its score, quieter. */}
<li
  class="source-row"
  data-id={source.id}
  data-band={band}
  data-score={source.score ?? -1}
  data-name={source.name.toLowerCase()}
  data-text={searchText(source, shownTopic?.name ?? topicName)}
  data-format={source.format}
  data-statuses={statusesOf(source).join(" ")}
  title={source.url ?? undefined}
>
  <button
    class="source-edit"
    type="button"
    aria-label={`Edit ${source.name}`}
    data-edit-source={JSON.stringify(facts)}
  ></button>
  <span class="source-main">
    <span class="source-icon" aria-hidden="true">
      <span class="source-initial">{sourceInitial(source.name)}</span>
      {
        source.favicon_url && (
          <img
            src={`/api/site-icon?url=${encodeURIComponent(source.favicon_url)}`}
            alt=""
            width="20"
            height="20"
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
            data-favicon
          />
        )
      }
    </span>
    <span class="source-text">
      <span class="source-name" id={`source-${source.id}`}>{source.name}</span>
      <span class="source-meta">
        <span class="source-url">{address}</span>
      </span>
      {
        labelled && (
          <span class="source-meta source-kind">
            {`${FORMAT_LABEL[source.format]} · ${shownTopic?.name ?? (topicName || "Other")}`}
          </span>
        )
      }
    </span>
  </span>
  <ScoreMeter label={source.score_label} score={source.score} />
  <label class="source-check">
    <input
      type="checkbox"
      autocomplete="off"
      checked={source.enabled}
      aria-label={`Read ${source.name}`}
      data-op={JSON.stringify({ op: "source.set", id: source.id, enabled: source.enabled })}
      data-field="enabled"
    />
    <span class="suggest-box" aria-hidden="true"></span>
  </label>
  {/* Delete, pressed from the edit panel's Delete source (topicsEditor.ts): it waits with an Undo in
       the toast, as a topic's removal does, and the row is gone once it is saved. */}
  <button
    class="source-remove"
    type="button"
    hidden
    data-remove
    data-name={source.name}
    data-label={`Delete ${source.name}`}
    data-label-undo={`Undo deleting ${source.name}`}
    data-op={JSON.stringify({ op: "source.remove", id: source.id })}
  ></button>
</li>
