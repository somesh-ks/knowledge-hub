---
import type { ManageSource } from "../lib/manage";
import { sourceInitial } from "../lib/sourceInitial";
import ScoreMeter from "./ScoreMeter.astro";

interface Props {
  source: ManageSource;
  /** The name of the topic the source is filed under; empty for Other. */
  topicName?: string;
  /**
   * The topic the edit panel shows as the source's own, when the page stands for several (one of
   * the owner's three topics): the group's home, so choosing the same group moves nothing.
   */
  shownTopic?: { id: string; name: string } | undefined;
}

const { source, topicName = "", shownTopic } = Astro.props;
// The bands of a score out of 3: Good is 2.1 and up, Fair 1.5 to 2.1, Poor under 1.5, New has none.
const band =
  source.score === null
    ? "new"
    : source.score >= 2.1
      ? "good"
      : source.score >= 1.5
        ? "fair"
        : "poor";
// What the edit panel shows about the source (topicsPanel.ts, SourceFacts).
const facts = {
  id: source.id,
  name: source.name,
  topic_id: shownTopic?.id ?? source.topic_id ?? "",
  topic_name: shownTopic?.name ?? topicName,
  url: source.url,
  host: source.host,
  score: source.score,
  label: source.score_label,
  parts: source.score_parts,
  reason: source.score_reason,
};
---

{/* One source under its topic. The row opens the source to edit: one button behind everything,
     the row's own size, so no part of it is a dead zone. Over it sit the tile, the name, the score
     and the checkbox; the name is a link to the site, in a new tab, and the checkbox says whether the
     source is read. Everything else lets a press through to the button. The tile shows the name's
     first letter, and the site's own icon covers it once it loads (topicsPage.ts marks it loaded),
     so a site without an icon still has a face. An off row keeps its place and its score, quieter. */}
<li
  class="source-row"
  data-id={source.id}
  data-band={band}
  data-score={source.score ?? -1}
  data-name={source.name.toLowerCase()}
>
  <button
    class="source-edit"
    type="button"
    aria-label={`Edit ${source.name}`}
    data-edit-source={JSON.stringify(facts)}
  ></button>
  <span class="source-main">
    <span class="source-icon" aria-hidden="true">
      <span class="source-initial">{sourceInitial(source.name)}</span>
      {
        source.favicon_url && (
          <img
            src={`/api/site-icon?url=${encodeURIComponent(source.favicon_url)}`}
            alt=""
            width="20"
            height="20"
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
            data-favicon
          />
        )
      }
    </span>
    <span class="source-text">
      {
        source.url ? (
          <a
            class="source-name"
            id={`source-${source.id}`}
            href={source.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-describedby="source-new-tab"
          >
            {source.name}
          </a>
        ) : (
          <span class="source-name" id={`source-${source.id}`}>{source.name}</span>
        )
      }
      <span class="source-host">{source.host}</span>
    </span>
  </span>
  <ScoreMeter score={source.score} label={source.score_label} />
  <label class="source-check">
    <input
      type="checkbox"
      autocomplete="off"
      checked={source.enabled}
      aria-label={`Read ${source.name}`}
      data-op={JSON.stringify({ op: "source.set", id: source.id, enabled: source.enabled })}
      data-field="enabled"
    />
    <span class="suggest-box" aria-hidden="true"></span>
  </label>
</li>
