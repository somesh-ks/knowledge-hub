---
import type { ManageSource } from "../lib/manage";
import { sourceInitial } from "../lib/sourceInitial";
import Icon from "./Icon.astro";
import ScoreMeter from "./ScoreMeter.astro";

interface Props {
  source: ManageSource;
  /** The name of the topic the source is filed under; empty for Other. */
  topicName?: string;
}

const { source, topicName = "" } = Astro.props;
// The bands of a score out of 3: Good is 2.1 and up, Fair 1.5 to 2.1, Poor under 1.5, New has none.
const band =
  source.score === null
    ? "new"
    : source.score >= 2.1
      ? "good"
      : source.score >= 1.5
        ? "fair"
        : "poor";
// What the edit panel shows about the source (topicsPanel.ts, SourceFacts).
const facts = {
  id: source.id,
  name: source.name,
  topic_id: source.topic_id ?? "",
  topic_name: topicName,
  url: source.url,
  host: source.host,
  score: source.score,
  label: source.score_label,
  parts: source.score_parts,
  reason: source.score_reason,
};
---

{/* One source under its topic. Its name and tile are one button that opens the source to edit, and
     the open button beside its score goes to the site in a new tab. The tile shows the name's first
     letter, and the site's own icon covers it once it loads (topicsPage.ts marks it loaded), so a
     site without an icon still has a face and every name starts at one edge. The checkbox at the
     end says whether the source is read: unticking switches it off, ticking switches it back on, and
     an off row stays where it is with its score, quieter. */}
<li
  class="source-row"
  data-id={source.id}
  data-band={band}
  data-score={source.score ?? -1}
  data-name={source.name.toLowerCase()}
>
  <button
    class="source-main"
    type="button"
    aria-label={`Edit ${source.name}`}
    data-edit-source={JSON.stringify(facts)}
  >
    <span class="source-icon" aria-hidden="true">
      <span class="source-initial">{sourceInitial(source.name)}</span>
      {
        source.favicon_url && (
          <img
            src={`/api/site-icon?url=${encodeURIComponent(source.favicon_url)}`}
            alt=""
            width="20"
            height="20"
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
            data-favicon
          />
        )
      }
    </span>
    <span class="source-text">
      <span class="source-name" id={`source-${source.id}`}>{source.name}</span>
      <span class="source-host">{source.host}</span>
    </span>
  </button>
  <ScoreMeter score={source.score} label={source.score_label} />
  {
    source.url ? (
      <a
        class="icon-btn source-open press"
        href={source.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Open ${source.name} in a new tab`}
      >
        <Icon name="openInNew" />
      </a>
    ) : (
      <span class="source-slot" />
    )
  }
  <label class="source-check">
    <input
      type="checkbox"
      autocomplete="off"
      checked={source.enabled}
      aria-label={`Read ${source.name}`}
      data-op={JSON.stringify({ op: "source.set", id: source.id, enabled: source.enabled })}
      data-field="enabled"
    />
    <span class="suggest-box" aria-hidden="true"><Icon name="check" class="suggest-check" /></span>
  </label>
</li>
