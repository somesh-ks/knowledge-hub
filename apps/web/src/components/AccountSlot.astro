---
import Avatar from "../design-system/Avatar.astro";
import "../styles/account.css";

interface Props {
  /** Where this copy stands: in the app bar (below 64rem) or at the top right of a wide screen. */
  place: "bar" | "desk";
}

const { place } = Astro.props;
---

{/* The reader's face, a link to the profile. The server draws the default shape; accountAvatar.ts puts
     the one the mood and the reader's pick call for before the first frame is painted. There is no
     sign-in yet (Google comes later), so the avatar is the whole control. */}
<a class={`account-slot account-${place}`} href="/profile" aria-label="Your profile" data-account data-astro-prefetch="hover">
  <Avatar />
</a>
