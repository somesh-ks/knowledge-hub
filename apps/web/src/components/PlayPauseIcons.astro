---
import Icon from "../design-system/Icon.astro";
import type { IconSize } from "../design-system/icon";

interface Props {
  size?: IconSize;
}

const { size = "md" } = Astro.props;
---

<span class="swap">
  <Icon name="play" size={size} class="swap-paused" />
  <Icon name="pause" size={size} class="swap-playing" />
</span>
