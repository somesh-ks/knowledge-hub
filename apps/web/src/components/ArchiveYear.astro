---
import type { ArchiveYear } from "../lib/archive";
import ArchiveMonth from "./ArchiveMonth.astro";
import Icon from "./Icon.astro";

interface Props {
  group: ArchiveYear;
  /** The newest year starts open, and so does its newest month. */
  isNewest: boolean;
}

const { group, isNewest } = Astro.props;
---

<details class="year-group" open={isNewest}>
  <summary>
    <span>{group.year}</span>
    <Icon name="chevronDown" />
  </summary>
  {group.months.map((month, index) => <ArchiveMonth month={month} open={isNewest && index === 0} />)}
</details>
