---
import type { ArchiveYear } from "../lib/archive";
import ArchiveMonth from "./ArchiveMonth.astro";

interface Props {
  group: ArchiveYear;
  /** True for the newest year, whose first month opens the page. */
  isNewest: boolean;
}

const { group, isNewest } = Astro.props;
---

{/* A year is only its months: each month header carries the year, so there is one header per group
     instead of two stacked. */}
{
  group.months.map((month, index) => (
    <ArchiveMonth month={month} year={group.year} isFirst={isNewest && index === 0} />
  ))
}
