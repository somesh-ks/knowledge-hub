---
import { getPalette } from "@dispatch/cover";
import { tintColors } from "../scripts/ambientTint";
import "../styles/ambient.css";

interface Props {
  /** The cover's palette id. */
  palette: string;
}

const { ground, accent, shade } = getPalette(Astro.props.palette);
// The cover's hues at the lightness each theme can carry; ambient.css picks the set.
const light = tintColors(ground, accent, shade, "light");
const dark = tintColors(ground, accent, shade, "dark");
const vars = `--ambient-a-l:${light[0]};--ambient-b-l:${light[1]};--ambient-c-l:${light[2]};--ambient-a-d:${dark[0]};--ambient-b-d:${dark[1]};--ambient-c-d:${dark[2]}`;
---

{/* Light from the cover spilling onto the page behind the header. A CSS layer shows the same colors
     before any script runs and wherever WebGL is missing; the canvas fades in over it. */}
<div class="ambient" aria-hidden="true" data-ambient={`${light.join(",")},${dark.join(",")}`} style={vars}>
  <div class="ambient-still"></div>
  <canvas class="ambient-canvas"></canvas>
</div>

<script>
  import "../scripts/ambientEntry";
</script>
