---
import type { AudioMode } from "../lib/digests";
import { AUDIO_UNAVAILABLE_COPY } from "../lib/digestView";
import { idleBriefingChip } from "../player/core/readerMath";
import Icon from "./Icon.astro";
import PlayChip from "./PlayChip.astro";

interface Props {
  digestId: string;
  mode: AudioMode;
  /** The chip's label before anything plays: "8 min". */
  length: string;
  /** Where the share button points. A briefing's dated address unless the page says otherwise. */
  sharePath?: string;
  /** What the share button names: "briefing" or "episode". */
  noun?: string;
}

const { digestId, mode, length, sharePath = `/d/${digestId}`, noun = "briefing" } = Astro.props;
const chip = idleBriefingChip(length);
const unavailable = mode === "ready" ? null : AUDIO_UNAVAILABLE_COPY[mode];
---

<div class="hero-actions">
  {/* The player owns this chip once it hydrates (readerSync writes its state, label and name).
       Without audio the chip still works: pressing it makes the audio first (narration on Play),
       and the line under it says so. */}
  <PlayChip
    label={chip.label}
    state="idle"
    aria-label={chip.name}
    aria-describedby={unavailable ? "play-hint" : undefined}
    data-play-digest={digestId}
  />
  {/* Shares the dated address, so a link sent from today's page still opens this briefing next week. */}
  <button
    class="icon-btn share press"
    type="button"
    aria-label={`Share this ${noun}`}
    data-share={sharePath}
  >
    <Icon name="share" class="share-icon" />
    <Icon name="check" class="share-done" />
  </button>
  <span class="sr-only" role="status" data-share-status></span>
</div>
{unavailable && <p class="hero-hint" id="play-hint">{unavailable.label}. {unavailable.hint}</p>}
