---
import type { AudioMode } from "../lib/digests";
import { AUDIO_UNAVAILABLE_COPY } from "../lib/digestView";
import { idleBriefingChip } from "../player/core/readerMath";
import PlayChip from "./PlayChip.astro";

interface Props {
  digestId: string;
  mode: AudioMode;
  /** The chip's label before anything plays: "8 min". */
  length: string;
  /** What is said beside the chip, in the chip's own size: "12 stories", or "Discussion", "7 October". */
  facts?: string[];
}

const { digestId, mode, length, facts = [] } = Astro.props;
const chip = idleBriefingChip(length);
const unavailable = mode === "expired" ? AUDIO_UNAVAILABLE_COPY.expired : null;
---

<div class="hero-actions">
  {/* The player owns this chip once it hydrates (readerSync writes its state, label and name).
       Without audio the chip still works: pressing it makes the audio first (narration on Play).
       Only audio that has expired gets a line under it. */}
  <PlayChip
    label={chip.label}
    state="idle"
    aria-label={chip.name}
    aria-describedby={unavailable ? "play-hint" : undefined}
    data-play-digest={digestId}
  />
  {
    facts.length > 0 && (
      <p class="meta hero-facts">
        {facts.map((part) => (
          <Fragment>
            <span>{part}</span>{" "}
          </Fragment>
        ))}
      </p>
    )
  }
</div>
{unavailable && <p class="hero-hint" id="play-hint">{unavailable.label}. {unavailable.hint}</p>}
