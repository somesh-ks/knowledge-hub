---
import Slider from "../design-system/Slider.astro";

/** The slider's stops (a format mix, a perspective), the op it sends and the field it sets. */
interface Custom {
  stops: readonly { name: string; value: number }[];
  op: object;
  field: string;
}

interface Props {
  id: string;
  label: string;
  /** Spoken with the stop. */
  name?: string;
  weight: number;
  custom: Custom;
}

const { id, label, name = label, weight, custom } = Astro.props;
const stops = custom.stops;
const place = Math.max(
  0,
  stops.findIndex((s) => s.value === weight),
);
const stopName = stops[place]?.name ?? "Normal";
---

{/* A slider on fixed stops. The stop's name sits under the label, where topicsPage.ts updates it as
     the thumb moves, so the slider ends where every control ends. The input holds the stop's place
     so the stops sit evenly; data-stops maps it back to the value that is saved. */}
<div class="settings-row topic-weight">
  <div class="settings-text">
    <label class="settings-label" for={`weight-${id}`}>{label}</label>
    <output class="settings-hint" for={`weight-${id}`} data-word>{stopName}</output>
  </div>
  <Slider
    id={`weight-${id}`}
    min="0"
    max={stops.length - 1}
    step="1"
    value={place}
    autocomplete="off"
    aria-valuetext={`${name}, ${stopName}`}
    style={`--range-fill: ${(place / (stops.length - 1)) * 100}%`}
    data-op={JSON.stringify(custom.op)}
    data-field={custom.field}
    data-stops={stops.map((s) => s.value).join(",")}
    data-names={stops.map((s) => s.name).join(",")}
    data-label={name}
    data-mix
  />
</div>
