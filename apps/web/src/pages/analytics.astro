---
import Icon from "../components/Icon.astro";
import SettingsHead from "../components/SettingsHead.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/settings.css";
import "../styles/costs.css";

const title = "Costs";

// The range sets both the window and the column: a column a day, a week or a month.
const RANGES = [
  { value: "day", days: 30, label: "30 days" },
  { value: "week", days: 91, label: "3 months" },
  { value: "month", days: 365, label: "12 months" },
];
// What the breakdown under the chart splits the spend by. By person shows once there are two people.
const SPLITS = [
  { value: "provider", label: "By provider" },
  { value: "kind", label: "By use" },
  { value: "scope", label: "Shared or personal" },
  { value: "user", label: "By person" },
];
---

<BaseLayout title={title} view="settings" skipLabel="Skip to the costs">
  <main id="main" tabindex="-1">
    {/* Static shell: the numbers load after first paint from /api/costs (scripts/costsPage.ts), so the
         page costs nothing at start. One card answers it all (2026-10-22, the owner): the range and
         breakdown chips at its top, the total, the chart, then the breakdown. */}
    <div class="settings-view costs" data-settings data-costs>
      <SettingsHead title={title} note="What the app spends on paid services." />

      <section class="card-group costs-card" aria-labelledby="costs-total-label">
        <div class="costs-head">
          <div class="costs-filters">
            <label class="sort-field">
              <span class="sr-only">Range</span>
              <select id="costs-range" autocomplete="off">
                {RANGES.map((range) => <option value={range.value} data-days={range.days}>{range.label}</option>)}
              </select>
              <Icon name="chevronDown" />
            </label>
            <label class="sort-field">
              <span class="sr-only">Breakdown</span>
              <select id="costs-by" autocomplete="off">
                {SPLITS.map((split) => <option value={split.value}>{split.label}</option>)}
              </select>
              <Icon name="chevronDown" />
            </label>
          </div>
          <div class="costs-answer costs-data" aria-live="polite">
            <h2 class="costs-label" id="costs-total-label" data-costs-label>Total spend</h2>
            <p class="costs-total" data-costs-total>Loading</p>
            <p class="costs-detail" data-costs-detail>&nbsp;</p>
          </div>
          {/* Chart or table (owner, 2026-10-23): the segmented navigation as two glyph tabs, compact
               (costs.css). The card's data-view shows one panel and hides the other (costsPage.ts).
               After the answer in the reading order, just before the panels it switches; placed at
               the filter row's end from 40rem and beside the answer on a phone (D177). */}
          <div class="segmented-nav costs-view" role="tablist" aria-label="Show as" data-costs-view>
            <button
              class="segmented-nav-tab"
              type="button"
              role="tab"
              id="costs-view-chart"
              aria-selected="true"
              aria-controls="costs-chart"
              aria-label="Chart"
              data-value="chart"
            >
              <Icon name="chartBar" />
            </button>
            <button
              class="segmented-nav-tab"
              type="button"
              role="tab"
              id="costs-view-table"
              aria-selected="false"
              aria-controls="costs-grid"
              aria-label="Table"
              tabindex="-1"
              data-value="table"
            >
              <Icon name="table" />
            </button>
          </div>
        </div>

        <div class="costs-chart" id="costs-chart" role="tabpanel" aria-labelledby="costs-view-chart">
          <div class="costs-plot costs-data" data-costs-plot tabindex="0" role="group" aria-label="Spend over time">
            <div class="costs-tip" data-costs-tip hidden></div>
            <p class="costs-empty" data-costs-empty hidden></p>
          </div>

          <h3 class="sr-only" data-costs-rank-head>By provider</h3>
          <ol class="costs-rank costs-data" data-costs-rank></ol>
        </div>

        <div class="costs-table" id="costs-grid" role="tabpanel" aria-labelledby="costs-view-table" data-costs-table>
          {/* A tab stop only while it scrolls sideways, so a keyboard can scroll it (costsPage.ts). */}
          <div class="costs-table-scroll scroll-fade-inline" role="region" aria-label="Spend table" data-costs-table-scroll>
            <table data-costs-grid></table>
          </div>
        </div>
      </section>
      <p class="settings-note costs-note" data-costs-note></p>
    </div>
  </main>
</BaseLayout>

<script>
  import "../scripts/costsPage";
</script>
