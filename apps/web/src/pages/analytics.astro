---
import Icon from "../components/Icon.astro";
import SettingsHead from "../components/SettingsHead.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/settings.css";
import "../styles/manage.css";
import "../styles/costs.css";

const title = "Costs";

// The period sets both the window and the bucket: a column a day, a week or a month.
const RANGES = [
  { value: "day", days: 30, label: "30 days" },
  { value: "week", days: 91, label: "13 weeks" },
  { value: "month", days: 365, label: "12 months" },
];
---

<BaseLayout title={title} view="settings" skipLabel="Skip to the costs">
  <main id="main" tabindex="-1">
    {/* Static shell: the numbers load after first paint from /api/costs (scripts/costsPage.ts), so the page costs nothing at start. */}
    <div class="settings-view costs" data-settings data-costs>
      <SettingsHead title={title} note="What the app spent on paid services, from the cost ledger." />

      {/* The controls scope everything below them, in the settings row grammar. */}
      <section aria-labelledby="costs-range-head">
        <h2 class="section-head" id="costs-range-head">Range</h2>
        <div class="rows card-group">
          <div class="settings-row" data-layout="choice">
            <span class="settings-text">
              <span class="settings-label" id="costs-period-label">Period</span>
            </span>
            <fieldset class="segmented-choice" role="radiogroup" aria-labelledby="costs-period-label">
              {
                RANGES.map((range, index) => (
                  <label class="segmented-choice-item">
                    <input type="radio" name="costs-range" value={range.value} data-days={range.days} checked={index === 0} />
                    <span>{range.label}</span>
                  </label>
                ))
              }
            </fieldset>
          </div>
          <div class="settings-row">
            <label class="settings-label" for="costs-by">Group by</label>
            <span class="manage-select value-select">
              <select class="manage-input" id="costs-by" autocomplete="off">
                <option value="provider">Provider</option>
                <option value="kind">Kind</option>
                <option value="scope">Shared or personal</option>
                <option value="user">User</option>
              </select>
              <Icon name="chevronDown" />
            </span>
          </div>
        </div>
      </section>

      <section class="costs-data" aria-labelledby="costs-total-head" aria-live="polite">
        <h2 class="section-head" id="costs-total-head">Total</h2>
        <div class="card-group costs-summary">
          <p class="costs-hero">
            <span class="costs-hero-label" data-costs-spent-label>Spent in the last 30 days</span>
            <span class="costs-hero-value" data-costs-total>Loading</span>
            <span class="costs-tag" data-costs-estimate hidden>Estimate</span>
          </p>
          <dl class="costs-kpis">
            <div><dt>Per run</dt><dd data-costs-per-run></dd></div>
            <div><dt>Runs</dt><dd data-costs-runs></dd></div>
            <div data-costs-users hidden><dt>Per user</dt><dd data-costs-per-user></dd></div>
          </dl>
        </div>
      </section>

      <section class="costs-data" aria-labelledby="costs-time-head">
        <h2 class="section-head" id="costs-time-head">Over time</h2>
        <div class="card-group costs-chart">
          <div class="costs-plot" data-costs-plot tabindex="0" role="group" aria-label="Spend over time. Use the arrow keys to read each column.">
            <div class="costs-tip" data-costs-tip hidden></div>
          </div>
          <p class="costs-empty" data-costs-empty hidden>Nothing spent in this range yet. The ledger fills after the engine's first paid run.</p>
        </div>
      </section>

      <section class="costs-data" aria-labelledby="costs-rank-head">
        <h2 class="section-head" id="costs-rank-head" data-costs-rank-head>By provider</h2>
        <ol class="card-group costs-rank" data-costs-rank></ol>
        <details class="costs-table" data-costs-table>
          <summary>Show as a table</summary>
          <div class="costs-table-scroll"><table data-costs-grid></table></div>
        </details>
        <p class="settings-note costs-note" data-costs-note></p>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  import "../scripts/costsPage";
</script>
