---
import EmptyState from "../components/EmptyState.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" view="home" nav={null} skipLabel="Skip to the content">
  <main id="main" tabindex="-1">
    <EmptyState
      title="Page not found"
      body="There is nothing at this address. It may have moved, or the link may be mistyped."
      primary={{ label: "Open today's briefing", href: "/" }}
      secondary={{ label: "Archive", href: "/archive" }}
    />
  </main>
</BaseLayout>
