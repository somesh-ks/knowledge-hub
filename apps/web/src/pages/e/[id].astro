---
import type { GetStaticPaths } from "astro";
import EpisodeView from "../../components/EpisodeView.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { EpisodeEntry } from "../../lib/episodes";
import { getSite } from "../../lib/site";

export const getStaticPaths = (async () => {
  const { episodes } = await getSite();
  return episodes.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

interface Props {
  entry: EpisodeEntry;
}

const { entry } = Astro.props;
---

<BaseLayout title={entry.episode.title} view="library" digestId={entry.id}>
  <EpisodeView entry={entry} />
</BaseLayout>
