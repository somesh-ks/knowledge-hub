---
import type { GetStaticPaths } from "astro";
import EmptyState from "../../components/EmptyState.astro";
import EpisodeView from "../../components/EpisodeView.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { type AlbumOption, catchUpAlbum } from "../../lib/catchUps";
import { episodeSections } from "../../lib/episodeHighlights";
import { type EpisodeEntry, episodeLength, storyLookups } from "../../lib/episodes";
import { episodeCard } from "../../lib/linkCard";
import type { SectionRef } from "../../lib/sectionLabel";
import { getSite } from "../../lib/site";
import { CONTENT_CDN_CACHE, readFromContentRepo } from "../../server/contentRepo";

// Rendered on request from the content repository (D173), so a new episode shows without a build.
// The static test build prerenders it from getStaticPaths instead (astro.config.mjs).
export const prerender = false;

export const getStaticPaths = (async () => {
  const site = await getSite();
  const lookups = storyLookups(site.entries);
  return site.episodes.map((entry) => ({
    params: { id: entry.id },
    props: { entry, ...lookups, album: catchUpAlbum(site.episodes, entry.id) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: EpisodeEntry;
  summaries: ReadonlyMap<string, string>;
  topics: ReadonlyMap<string, string>;
  sections: ReadonlyMap<string, SectionRef>;
  album: AlbumOption[];
}

let props = Astro.props as Props;
let removed = false;
if (!Astro.isPrerendered) {
  const unavailable = await readFromContentRepo("e");
  if (unavailable) return unavailable;
  const site = await getSite();
  const entry = site.episodes.find((episode) => episode.id === Astro.params.id);
  if (!entry) {
    // A deleted episode's old address, or a share link to it: a page that says so, never a bare 404.
    removed = true;
    Astro.response.status = 404;
    Astro.response.headers.set("Vercel-CDN-Cache-Control", CONTENT_CDN_CACHE);
  } else {
    props = { entry, ...storyLookups(site.entries), album: catchUpAlbum(site.episodes, entry.id) };
    Astro.response.headers.set("Vercel-CDN-Cache-Control", CONTENT_CDN_CACHE);
  }
}

const { entry, summaries, topics, sections, album } = props;
const tabs = entry ? episodeSections(entry.episode, { summaries, sections }).length > 1 : false;
---

{
  removed || !entry ? (
    <BaseLayout title="Episode removed" view="library" nav={null} skipLabel="Skip to the content">
      <main id="main" tabindex="-1">
        <EmptyState
          art="notfound"
          title="This episode was removed"
          body="It is no longer in the Library."
          primary={{ label: "Open the Library", href: "/library" }}
          secondary={null}
        />
      </main>
    </BaseLayout>
  ) : (
<BaseLayout
  title={entry.episode.title}
  view="library"
  digestId={entry.id}
  card={episodeCard(entry)}
  audio={{ noun: "episode", length: episodeLength(entry.episode) }}
  layout={tabs ? "aside" : "single"}
  tabs={tabs}
  skipLabel="Skip to the episode"
>
  <EpisodeView entry={entry} summaries={summaries} topics={topics} sections={sections} album={album} />
</BaseLayout>
  )
}
