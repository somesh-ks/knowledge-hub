---
import type { GetStaticPaths } from "astro";
import EpisodeView from "../../components/EpisodeView.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { episodeSections } from "../../lib/episodeHighlights";
import { type EpisodeEntry, episodeLength, storyLookups } from "../../lib/episodes";
import { episodeCard } from "../../lib/linkCard";
import type { SectionRef } from "../../lib/sectionLabel";
import { getSite } from "../../lib/site";
import { CONTENT_CDN_CACHE, notFoundPage, readFromContentRepo } from "../../server/contentRepo";

// Rendered on request from the content repository (D173), so a new episode shows without a build.
// The static test build prerenders it from getStaticPaths instead (astro.config.mjs).
export const prerender = false;

export const getStaticPaths = (async () => {
  const site = await getSite();
  const lookups = storyLookups(site.entries);
  return site.episodes.map((entry) => ({ params: { id: entry.id }, props: { entry, ...lookups } }));
}) satisfies GetStaticPaths;

interface Props {
  entry: EpisodeEntry;
  summaries: ReadonlyMap<string, string>;
  topics: ReadonlyMap<string, string>;
  sections: ReadonlyMap<string, SectionRef>;
}

let props = Astro.props as Props;
if (!Astro.isPrerendered) {
  const unavailable = await readFromContentRepo("e");
  if (unavailable) return unavailable;
  const site = await getSite();
  const entry = site.episodes.find((episode) => episode.id === Astro.params.id);
  if (!entry) {
    return notFoundPage(Astro.url);
  }
  props = { entry, ...storyLookups(site.entries) };
  Astro.response.headers.set("Vercel-CDN-Cache-Control", CONTENT_CDN_CACHE);
}

const { entry, summaries, topics, sections } = props;
const tabs = episodeSections(entry.episode, { summaries, sections }).length > 1;
---

<BaseLayout
  title={entry.episode.title}
  view="library"
  digestId={entry.id}
  card={episodeCard(entry)}
  audio={{ noun: "episode", length: episodeLength(entry.episode) }}
  layout={tabs ? "aside" : "single"}
  tabs={tabs}
  skipLabel="Skip to the episode"
>
  <EpisodeView entry={entry} summaries={summaries} topics={topics} sections={sections} />
</BaseLayout>
