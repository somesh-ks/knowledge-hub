---
import type { GetStaticPaths } from "astro";
import DigestView from "../../components/DigestView.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { DigestEntry } from "../../lib/digests";
import { listenLength } from "../../lib/digestView";
import { briefingCard } from "../../lib/linkCard";
import { getSite } from "../../lib/site";
import { CONTENT_CDN_CACHE, readFromContentRepo } from "../../server/contentRepo";

// Rendered on request from the content repository (D173), so a new briefing shows without a build.
// The static test build prerenders it from getStaticPaths instead (astro.config.mjs).
export const prerender = false;

export const getStaticPaths = (async () => {
  const { entries } = await getSite();
  return entries.map((entry, index) => ({
    params: { id: entry.id },
    props: { entry, earlier: entries.slice(index + 1, index + 4), isLatest: index === 0 },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: DigestEntry;
  earlier: DigestEntry[];
  isLatest: boolean;
}

let props = Astro.props as Props;
if (!Astro.isPrerendered) {
  const unavailable = await readFromContentRepo("d");
  if (unavailable) return unavailable;
  const site = await getSite();
  const index = site.entries.findIndex((entry) => entry.id === Astro.params.id);
  const entry = site.entries[index];
  // The 404 page is built, not part of this function, so it is fetched from the site's own edge.
  if (!entry) {
    const notFound = await fetch(new URL("/404", Astro.url)).catch(() => null);
    return new Response(notFound?.ok ? await notFound.text() : "Not found", {
      status: 404,
      headers: { "Content-Type": "text/html; charset=utf-8" },
    });
  }
  props = { entry, earlier: site.entries.slice(index + 1, index + 4), isLatest: index === 0 };
  Astro.response.headers.set("Vercel-CDN-Cache-Control", CONTENT_CDN_CACHE);
}

const { entry, earlier, isLatest } = props;
---

<BaseLayout
  title={entry.player.title}
  view="home"
  nav={isLatest ? "today" : "library"}
  layout="aside"
  digestId={entry.id}
  card={briefingCard(entry)}
  audio={{
    noun: "briefing",
    length: listenLength(entry),
    expired: entry.audioMode === "expired",
  }}
>
  <DigestView entry={entry} earlier={earlier} isLatest={isLatest} />
</BaseLayout>
