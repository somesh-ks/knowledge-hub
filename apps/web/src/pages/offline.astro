---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Offline" view="home" skipLabel="Skip to the content">
  <main id="main" tabindex="-1">
    <section class="empty" aria-labelledby="page-title">
      <h1 id="page-title" tabindex="-1">You are offline</h1>
      <p>This page is not saved on this device yet. Open a briefing you have read before, or reconnect and try again.</p>
      <div class="empty-actions">
        <a class="btn-primary press press-subtle" href="/">Open today's briefing</a>
        <a class="btn-secondary press press-subtle" href="/archive">Archive</a>
      </div>
    </section>
  </main>
</BaseLayout>
