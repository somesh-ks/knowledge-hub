---
import EmptyState from "../components/EmptyState.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

{/* The stand-in (D330): the worker answers a page this device never opened with this one, at the
     address that was asked for. It says one thing, "You are offline", and offers one button, Try
     again (owner, 2026-11-02). scripts/standIn.ts brings the real page in, in place, the moment the
     site can be reached. The pages a reader expects offline (Saved, Library, Settings) never
     reach it: they are kept ready (sw.js). */}
<BaseLayout title="You are offline" view="home" nav={null} skipLabel="Skip to the content">
  <main id="main" tabindex="-1" data-stand-in>
    <EmptyState
      art="offline"
      title="You are offline"
      body=""
      primary={{ label: "Try again", href: "#", retry: true }}
      secondary={null}
    />
  </main>
</BaseLayout>
