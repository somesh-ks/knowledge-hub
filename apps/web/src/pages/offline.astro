---
import EmptyState from "../components/EmptyState.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

{/* The stand-in (D330): the worker answers a page this device never opened with this one, at the
     address that was asked for. It says nothing about the connection, which the strip above the app
     already says; it says the page is not here, and scripts/standIn.ts brings the real page in, in
     place, the moment the site can be reached. */}
<BaseLayout title="Not saved offline" view="home" nav={null} skipLabel="Skip to the content">
  <main id="main" tabindex="-1" data-stand-in>
    <EmptyState
      art="offline"
      title="Not saved on this device"
      body="Open it once online and it will be here next time."
      primary={{ label: "Try again", href: "#", retry: true }}
      secondary={{ label: "Open Library", href: "/library" }}
    />
  </main>
</BaseLayout>
