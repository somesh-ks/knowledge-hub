---
import EmptyState from "../components/EmptyState.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Offline" view="home" nav={null} skipLabel="Skip to the content">
  <main id="main" tabindex="-1">
    <EmptyState
      title="You are offline"
      body="This page is not saved on this device yet. Open a briefing you have read before, or reconnect and try again."
      primary={{ label: "Open today's briefing", href: "/" }}
      secondary={{ label: "Archive", href: "/archive" }}
    />
  </main>
</BaseLayout>
