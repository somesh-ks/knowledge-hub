---
import {
  MIX_STOPS,
  PROFILE_LABEL,
  PROFILE_NOTE,
  SOURCE_FORMATS,
  STRUCTURE_PROFILES,
} from "@singularity/core";
import { topicArt } from "@singularity/cover";
import EmptyArt from "../../components/EmptyArt.astro";
import Icon from "../../components/Icon.astro";
import ManageChrome from "../../components/ManageChrome.astro";
import SettingsHead from "../../components/SettingsHead.astro";
import SheetHeader from "../../components/SheetHeader.astro";
import WeightRow from "../../components/WeightRow.astro";
import Button from "../../design-system/Button.astro";
import Field from "../../design-system/Field.astro";
import Select from "../../design-system/Select.astro";
import Switch from "../../design-system/Switch.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadManage } from "../../lib/manage";
import { loadScheduleView } from "../../lib/schedule";
import { FORMAT_LABEL } from "../../lib/sourceFilter";
import { loadStructureData } from "../../lib/structurePage";
import { addOffers, blockCount, PER_SOURCE_MAX, rowsHtml } from "../../lib/structureView";
import { PLAYBACK_RATES } from "../../player/core/playerTypes";
import "../../styles/settings.css";
import "../../styles/manage.css";
import "../../styles/topics.css";
import "../../styles/create.css";

// The type mix (config/preferences.json): one for every topic, so one slider per source type here
// rather than on each topic's page (2026-10-20). Normal is the default and is not in the file.
// Listed alphabetically by label (2026-10-24), not in SOURCE_FORMATS order.
const { typeMix, topics, sections } = await loadManage();
const stops = MIX_STOPS.map((s) => ({ name: s.name, value: s.factor }));
const formats = [...SOURCE_FORMATS].sort((a, b) =>
  FORMAT_LABEL[a].localeCompare(FORMAT_LABEL[b], undefined, { sensitivity: "base" }),
);
const rows = formats.map((format) => ({
  id: `type-${format}`,
  label: FORMAT_LABEL[format],
  name: `${FORMAT_LABEL[format]} sources`,
  weight: MIX_STOPS.find((s) => s.name === typeMix[format])?.factor ?? 1,
  custom: { stops, op: { op: "mix.set", format_mix: {} }, field: `format_mix.${format}` },
}));

// The podcast structure (D170): the listener profile and the one list of blocks every podcast
// follows, drawn here and again by the editor (structureEditor.ts) from the same markup once the
// store and this device's edits are read.
const structure = await loadStructureData(topics, sections, await loadScheduleView());
// Each profile's picture is the category card's generated art, seeded by the profile.
const profileArt = Object.fromEntries(
  STRUCTURE_PROFILES.map((id) => [id, topicArt(id, PROFILE_LABEL[id])]),
);
const offers = addOffers(structure.blocks, structure.sections);
---

<BaseLayout title="Preferences" view="settings" skipLabel="Skip to preferences">
  <main id="main" tabindex="-1">
    {/* The sliders that count for every topic alike, and the podcasts' structure, in one card behind
         the segmented switch a topic's page has (?view=structure, kept on reload). The topics editor
         (topicsPage.ts) records a slider and autosave.ts sends every slider moved in one mix.set a
         moment later; the structure has its own editor (structureEditor.ts), saving the same way. */}
    <div class="manage topics preferences-page" data-topics>
      <SettingsHead title="Preferences" />
      <noscript>
        <p class="manage-note">Changing preferences needs JavaScript, which is turned off in this browser.</p>
      </noscript>

      {/* Autoplay is kept in this browser, like Interface sounds: settingsPage.ts fills the switch in. */}
      <div class="settings-view" data-settings>
        <div class="rows card-group">
          <div class="settings-row">
            <label class="settings-label" for="settings-autoplay">Podcast autoplay</label>
            <Switch id="settings-autoplay" name="autoplay" />
          </div>
          {/* Where every episode starts (2026-10-25), in the playback card under Autoplay (owner,
               2026-10-27). A speed chosen in the player lasts one episode. Saved on this device with
               the player's other preferences, not through the config store. */}
          <div class="settings-row">
            <label class="settings-label" for="default-speed">Default playback speed</label>
            <Select class="value-select" id="default-speed" autocomplete="off" data-needs-js data-default-speed>
              {PLAYBACK_RATES.map((rate) => <option value={rate}>{rate}x</option>)}
            </Select>
          </div>
        </div>
      </div>

      <fieldset class="manage-fields" data-fields>
        <legend class="sr-only">Preferences</legend>
        <div class="topic">
          <div class="topic-panel">
            <div class="segmented-nav topic-view" role="tablist" aria-label="Show" data-topic-view data-param="view">
              <button
                class="segmented-nav-tab"
                type="button"
                role="tab"
                id="pref-tab-types"
                aria-selected="true"
                aria-controls="pref-pane-types"
                data-value="types"
              >
                Source types
              </button>
              <button
                class="segmented-nav-tab"
                type="button"
                role="tab"
                id="pref-tab-structure"
                aria-selected="false"
                aria-controls="pref-pane-structure"
                tabindex="-1"
                data-value="structure"
              >
                Podcast structure
              </button>
            </div>

            <section
              class="topic-view-pane topic-weights pref-view-types"
              data-store-held
              role="tabpanel"
              id="pref-pane-types"
              aria-labelledby="pref-tab-types"
            >
              <h2 class="section-head sr-only" id="types-head">Source types</h2>
              <div class="rows topic-controls">
                {rows.map((row) => <WeightRow {...row} />)}
              </div>
            </section>

            {/* A tab for each kind and Reorder; its blocks in order; Add under them. The rows are
                 lib/structureView.ts's markup, drawn again by the editor after each change. */}
            <section
              class="topic-view-pane pref-view-structure"
              data-store-held="editor"
              role="tabpanel"
              id="pref-pane-structure"
              aria-labelledby="pref-tab-structure"
              data-structure={JSON.stringify(structure)}
            >
              {/* The profile picks the list: a select, in the Daily and Weekly pages' row (owner,
                   2026-10-25). Editing a block or the order switches it to Custom. Reorder sits at
                   the row's end, in reach above the list however long it is. */}
              <div class="structure-kinds-bar">
                {/* The profile is a card as the category page's is (topic-card): its drawn picture, one line on
                     what it changes, and the page's own select at the end. structureEditor.ts repaints the
                     picture and the line from the chosen option (2026-10-26). */}
                <div class="topic-card profile-card structure-profile">
                  {
                    STRUCTURE_PROFILES.map((id) => (
                      <div class="topic-card-art" data-profile-art={id} hidden={id !== structure.profile} set:html={profileArt[id]} />
                    ))
                  }
                  <div class="topic-card-text">
                    <h2 class="profile-card-title">Listener profile</h2>
                    <p class="settings-note" data-profile-note>{PROFILE_NOTE[structure.profile]}</p>
                  </div>
                  {/* The shared settings select, as Theme's on /settings: no rule of its own (2026-10-27). */}
                  <div class="topic-card-menu settings-row">
                    <Select class="value-select" id="structure-profile" aria-label="Profile" autocomplete="off" data-needs-js>
                      {
                        STRUCTURE_PROFILES.map((id) => (
                          <option value={id} data-note={PROFILE_NOTE[id]} selected={id === structure.profile}>{PROFILE_LABEL[id]}</option>
                        ))
                      }
                    </Select>
                  </div>
                </div>
              </div>
              {/* Under the card's hairline, the list's head: how many sections, and Reorder and Add at
                   its end (owner, 2026-10-27). The grips show only after Reorder is pressed, so a stray
                   drag never moves a block (owner, 2026-10-24); below 64rem the floating button at the
                   page's foot is Reorder instead. */}
              <div class="topic-sources-head structure-list-head">
                <h2 class="section-head" data-block-count>{blockCount(structure.blocks.length - 2)}</h2>
                <div class="structure-list-actions">
                  <Button variant="tonal" class="structure-reorder" data-reorder data-needs-js>
                    <span data-reorder-label>Reorder</span>
                  </Button>
                  <span class="structure-add" style="--row-anchor: --structure-add">
                    <Button
                      variant="tonal"
                      data-add-block
                      data-needs-js
                      disabled={offers.length === 0}
                    >
                      <Icon name="plus" />
                      <span>Add section</span>
                    </Button>
                  </span>
                </div>
              </div>
              <p class="sr-only" id="structure-grip-hint">Drag to move, or press the up and down arrow keys.</p>
              <ol
                class="rows topic-controls structure-list"
                aria-label="Structure blocks"
                data-structure-list
                set:html={rowsHtml(structure.blocks, structure, structure.skip)}
              ></ol>
              {/* Shown by topics.css while the list has no block between the hello and the sign-off
                   (owner, 2026-10-27). Nothing is saved until one is added: an episode needs one. */}
              <div class="structure-empty empty" data-compact>
                <EmptyArt art="library" size="compact" />
                <p class="empty-title">No blocks yet</p>
                <p class="empty-body">
                  Add a section to start your podcast. Until then, episodes keep the structure they had.
                </p>
              </div>
            </section>
          </div>
        </div>
      </fieldset>
      <ManageChrome />
      {/* The page's floating button below 64rem (lib/fab.ts): Reorder, Done while reordering, so
           Done stays in reach down a long list. The shape, place and fold are .create-fab's. */}
      <button
        class="create-fab structure-reorder-fab pref-view-structure"
        type="button"
        aria-label="Reorder"
        data-reorder
        data-needs-js
      >
        <span class="structure-reorder-icon" data-reorder-icon="grip"><Icon name="grip" class="icon-lg" /></span>
        <span class="structure-reorder-icon" data-reorder-icon="check"><Icon name="check" class="icon-lg" /></span>
        <span class="create-fab-label" aria-hidden="true" data-reorder-label>Reorder</span>
      </button>

      {/* What leaving Custom asks (structureEditor.ts): the shared confirm dialog, saying the owner's
           own list is kept and comes back with Custom (owner, 2026-10-27). */}
      <dialog
        class="confirm-dialog"
        aria-labelledby="profile-confirm-title"
        aria-describedby="profile-confirm-lede"
        data-profile-confirm
      >
        <div class="confirm-form">
          <h2 class="sheet-title" id="profile-confirm-title" data-profile-confirm-title>Switch profile?</h2>
          <p class="create-hint confirm-lede" id="profile-confirm-lede">
            Your custom structure is kept and you can switch back.
          </p>
          <div class="confirm-actions">
            <Button variant="text" data-profile-keep autofocus>Cancel</Button>
            <Button variant="filled" data-profile-replace>Switch</Button>
          </div>
        </div>
      </dialog>
    </div>

    {/* A block's Edit sheet, cloned by structureEditor.ts each time it opens: the Topics panel's
         sheet (full screen on a phone, a side panel from 40rem). Each part shows for the blocks that
         have it; the prompt is the block's own (D182). */}
    <template id="structure-sheet-template">
      <dialog class="create-sheet regen-sheet topics-panel structure-sheet" aria-labelledby="structure-sheet-title">
        <SheetHeader
          title="Edit block"
          titleId="structure-sheet-title"
          close="data-panel-close"
          titleData={{ "data-sheet-title": "" }}
        />
        <div class="create-sheet-body">
          <form class="manage-form structure-form" novalidate>
            <div class="manage-field" data-part="title">
              <label for="structure-title">Title</label>
              <Field
                id="structure-title"
                name="title"
                type="text"
                maxlength="60"
                autocomplete="off"
                enterkeyhint="next"
                aria-describedby="structure-title-error"
              />
              <p class="manage-error" id="structure-title-error" role="alert" data-error="title" hidden>
                <Icon name="alert" /><span>Give it a title.</span>
              </p>
            </div>
            <div class="manage-field" data-part="brief">
              <label for="structure-brief">What it says</label>
              <Field
                multiline
                id="structure-brief"
                name="brief"
                maxlength="280"
                rows="3"
                aria-describedby="structure-brief-error"
              />
              <p class="manage-error" id="structure-brief-error" role="alert" data-error="brief" hidden>
                <Icon name="alert" /><span>Say what it should cover.</span>
              </p>
            </div>
            <div class="manage-field" data-part="depth">
              <span class="field-label" id="structure-depth-label">Depth</span>
              <fieldset class="segmented-choice" role="radiogroup" aria-labelledby="structure-depth-label">
                <label class="segmented-choice-item"><input type="radio" name="depth" value="deep" /><span>In depth</span></label>
                <label class="segmented-choice-item"><input type="radio" name="depth" value="brief" /><span>Short</span></label>
              </fieldset>
            </div>
            <div class="manage-field" data-part="length">
              <span class="field-label" id="structure-length-label">Length</span>
              <fieldset class="segmented-choice" role="radiogroup" aria-labelledby="structure-length-label">
                <label class="segmented-choice-item"><input type="radio" name="length" value="short" /><span>Short</span></label>
                <label class="segmented-choice-item"><input type="radio" name="length" value="long" /><span>Long</span></label>
              </fieldset>
            </div>
            {/* What code holds a block to, whatever model writes it (the owner, 2026-10-24: "deterministic
                 parameters ... we've gotta stay robust"): each a settings row whose value is a select,
                 so the number shows. Auto leaves it to the app. The script fills Stories up to the
                 block's own most. */}
            <div class="rows card-group structure-rules" data-part="rules">
              <div class="settings-row" data-part="stories">
                <label class="settings-label" for="structure-stories">Stories</label>
                <Select class="value-select" id="structure-stories" name="stories" autocomplete="off">
                  <option value="">Auto</option>
                </Select>
              </div>
              <div class="settings-row" data-part="per-source">
                <label class="settings-label" for="structure-per-source">Most from one source</label>
                <Select class="value-select" id="structure-per-source" name="per_source" autocomplete="off">
                  <option value="">Auto</option>
                  {Array.from({ length: PER_SOURCE_MAX }, (_, at) => <option value={String(at + 1)}>{String(at + 1)}</option>)}
                </Select>
              </div>
            </div>
            {/* The prompt, kept but out of the way: closed under its own row at the sheet's foot, as
                 Create's More options is, since prompt styles change as models do (the owner,
                 2026-10-24). */}
            <details class="create-more card-group structure-advanced" data-part="prompt">
              <summary class="create-more-summary">
                <span class="create-more-text">
                  <span class="create-more-title">Writing instructions (advanced)</span>
                  <span class="create-more-values" data-prompt-state></span>
                </span>
                <Icon name="chevronDown" class="create-more-chevron" />
              </summary>
              <div class="create-more-body manage-field">
                <label for="structure-prompt">Instructions for the model</label>
                <Field
                  multiline
                  class="structure-prompt"
                  id="structure-prompt"
                  name="prompt"
                  rows="8"
                  spellcheck="false"
                  aria-describedby="structure-prompt-count"
                />
                <div class="structure-prompt-foot">
                  <p class="manage-quiet" id="structure-prompt-count" data-count></p>
                  <Button variant="text" data-reset>Reset to built-in</Button>
                </div>
                <p class="manage-error" role="alert" data-error="prompt" hidden>
                  <Icon name="alert" /><span>Too long to save in one go. Shorten it a little.</span>
                </p>
              </div>
            </details>
            <p class="manage-quiet" data-part="spoken">Spoken by the app, not written by a model.</p>
            <p class="manage-quiet" data-part="own">What it says is what the model is told.</p>
          </form>
        </div>
        <div class="source-sheet-foot">
          <Button variant="filled" data-sheet-done>Save</Button>
        </div>
      </dialog>
    </template>
  </main>
</BaseLayout>

<script>
  import { installSettingsPage } from "../../scripts/settingsPage";
  import { installTopicsPage } from "../../scripts/topicsPage";

  installTopicsPage();
  installSettingsPage();
</script>

<script>
  import { isPlaybackRate } from "../../player/core/playerTypes";
  import { getPreferences } from "../../player/core/preferences";

  // Read on each page load, so the select shows what the player will start at.
  function installDefaultSpeed(): void {
    const select = document.querySelector<HTMLSelectElement>("[data-default-speed]");
    if (!select) return;
    const preferences = getPreferences();
    const current = preferences.get().rate;
    // A speed saved when the slider set the default is not a preset: it still shows, and stays chosen.
    if (![...select.options].some((o) => Number(o.value) === current)) {
      select.add(new Option(`${current}x`, String(current)), 0);
    }
    select.value = String(current);
    select.addEventListener("change", () => {
      const rate = Number(select.value);
      if (isPlaybackRate(rate)) preferences.set({ rate });
    });
  }

  document.addEventListener("astro:page-load", installDefaultSpeed);
</script>
