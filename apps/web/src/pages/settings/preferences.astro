---
import SettingsHead from "../../components/SettingsHead.astro";
import Menu from "../../design-system/Menu.astro";
import Select from "../../design-system/Select.astro";
import Switch from "../../design-system/Switch.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PLAYBACK_RATES } from "../../player/core/playerTypes";
import "../../styles/settings.css";

const title = "Preferences";
---

<BaseLayout title={title} view="settings" skipLabel="Skip to the preferences">
  <main id="main" tabindex="-1">
    {/* How playback starts (D335, amends D326): the podcast autoplay switch and the speed every
         episode starts at. Both are kept on this device with the player's other preferences, so
         settingsPage.ts fills the switch in and the script below fills the speed. This page held the
         podcast structure editor until the owner removed that feature (2026-11-02); the route stays. */}
    <div class="settings-view" data-settings>
      <SettingsHead title={title} />
      <noscript>
        <p class="settings-note">These settings need JavaScript, which is turned off in this browser.</p>
      </noscript>
      <section>
        <div class="rows card-group">
          <div class="settings-row">
            <label class="settings-label" for="settings-autoplay">Podcast autoplay</label>
            <Switch id="settings-autoplay" name="autoplay" />
          </div>
          {/* Where every episode starts (2026-10-25). A speed chosen in the player lasts one episode.
               Saved on this device with the player's other preferences, not through the config store.
               The value opens the player's speed screen (big number, stepper and slider in 0.25x
               steps) in the sheet below instead of a list: a phone's bottom sheet, a popover under
               the value from 40rem (data-opens, design-system/selectSheet.ts; scripts/defaultSpeed.ts, D338). */}
          <div class="settings-row">
            <label class="settings-label" for="default-speed">Default playback speed</label>
            <Select
              class="value-select speed-default"
              id="default-speed"
              autocomplete="off"
              data-needs-js
              data-default-speed
              data-opens="default-speed-sheet"
            >
              {PLAYBACK_RATES.map((rate) => <option value={rate}>{rate}x</option>)}
            </Select>
          </div>
        </div>
        {/* Outside the row, so the row's cap on a slider (settings.css) does not reach the sheet. */}
        <Menu id="default-speed-sheet" title="Default playback speed" class="speed-default-sheet">
          <div data-speed-root></div>
        </Menu>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  import { installSettingsPage } from "../../scripts/settingsPage";

  installSettingsPage();
</script>

<script>
  import { installDefaultSpeed } from "../../scripts/defaultSpeed";

  installDefaultSpeed();
</script>
