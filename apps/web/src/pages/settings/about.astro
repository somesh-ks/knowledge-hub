---
import SettingsHead from "../../components/SettingsHead.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/settings.css";

const title = "About";
---

<BaseLayout title={title} view="settings" skipLabel="Skip to the about page">
  <main id="main" tabindex="-1">
    <div class="settings-view" data-settings>
      <SettingsHead title={title} />
      <section>
        <h2 class="section-head">About the project</h2>
        <div class="rows card-group">
          <p class="settings-about">
            Singularity is a private design-engineering news briefing, created to help people cut through the noise and get high value news. AI picks stories from chosen news outlets and categories and turns them into a podcast, on its own, that you read or hear.
          </p>
        </div>
      </section>

      <section>
        <h2 class="section-head">About the author</h2>
        <div class="rows card-group">
          <p class="settings-about">
            I am Somesh, a designer and engineer. Find me on <a class="text-link" href="https://www.linkedin.com/in/someshks/" target="_blank" rel="noopener">LinkedIn</a>.
          </p>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
