---
import { MIX_STOPS, PERSPECTIVE_STOPS, SOURCE_FORMATS } from "@dispatch/core";
import { topicArt } from "@dispatch/cover";
import EmptyArt from "../../../components/EmptyArt.astro";
import Icon from "../../../components/Icon.astro";
import ManageChrome from "../../../components/ManageChrome.astro";
import MultiSelect from "../../../components/MultiSelect.astro";
import SettingsHead from "../../../components/SettingsHead.astro";
import SourceFilter from "../../../components/SourceFilter.astro";
import SourceRow from "../../../components/SourceRow.astro";
import SuggestedSources from "../../../components/SuggestedSources.astro";
import TopicsPanel from "../../../components/TopicsPanel.astro";
import WeightRow from "../../../components/WeightRow.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { loadManage, type ManageSource, type ManageTopic } from "../../../lib/manage";
import { loadScheduleView } from "../../../lib/schedule";
import { loadSourceCatalog, suggestSources } from "../../../lib/sourceCatalog";
import { FORMAT_LABEL } from "../../../lib/sourceFilter";
import {
  type GroupPage,
  OTHER_ID,
  suggestionWords,
  topicChoicesOf,
  topicLayout,
} from "../../../lib/topicPages";
import "../../../styles/settings.css";
import "../../../styles/manage.css";
import "../../../styles/topics.css";
import "../../../styles/episode-actions.css";

/**
 * One page for each of the owner's three topics (Design, AI, Technology), each of their own topics
 * apart from those, each general news topic, and Other (D69). The judge's finer topics have no page:
 * their sources show on their group's.
 */
export async function getStaticPaths() {
  const { topics, sources } = await loadManage();
  const layout = topicLayout(topics, sources);
  const choices = topicChoicesOf(layout);
  const taken = [...topics.map((t) => t.id), ...layout.groups.map((group) => group.id)];
  const list = (id: string) => layout.sources.get(id) ?? [];
  return [
    ...layout.groups.map((group) => ({
      params: { id: group.id },
      props: { group, topic: null, list: list(group.id), choices, taken },
    })),
    ...[...layout.own, ...layout.general].map((topic) => ({
      params: { id: topic.id },
      props: { group: null, topic, list: list(topic.id), choices, taken },
    })),
    {
      params: { id: OTHER_ID },
      props: { group: null, topic: null, list: list(OTHER_ID), choices, taken },
    },
  ];
}

interface Props {
  group: GroupPage | null;
  topic: ManageTopic | null;
  list: ManageSource[];
  choices: { id: string; name: string }[];
  taken: string[];
}

const { group, topic, list, choices, taken } = Astro.props;

// The names a new topic may not take again (topicProblems): every topic a person sees.
const names = choices.map((choice) => choice.name);
const [{ sources, topics: allTopics }, catalog] = await Promise.all([
  loadManage(),
  loadSourceCatalog(),
]);
const name = group?.name ?? topic?.name ?? "Other";
const note = group?.note ?? topic?.description ?? "Sources not filed under a topic.";
// A source on a group's page shows the group as its topic, so its edit panel moves it only when
// another topic is chosen.
const shown = group ? { id: group.home, name: group.name } : undefined;
// The catalogue's feeds that fit the topic and are not among the sources: all known at build time, so
// they are in the page and need no request. Where nothing fits, the page has no such section.
const words = suggestionWords({ group, topic });
const suggested = words ? suggestSources(catalog, sources, words) : [];
// Where the topic plays (D69): one of the owner's three sets it for every judge topic it gathers.
const schedule = await loadScheduleView();
const scopeIds = group ? group.members.map((member) => member.id) : topic ? [topic.id] : [];
const SCOPES = [
  { key: "daily", label: "Daily", skipped: schedule.skipTopics },
  { key: "weekly", label: "Weekly", skipped: schedule.weekly.skip_topics },
  // Custom: episodes made on request, by the name the Library's filter gives them.
  { key: "custom", label: "Custom", skipped: schedule.custom.skip_topics },
] as const;
const inScope = (key: (typeof SCOPES)[number]["key"]): boolean => {
  const skipped = SCOPES.find((scope) => scope.key === key)?.skipped ?? [];
  return !scopeIds.every((id) => skipped.includes(id));
};
// How much each judge topic a group gathers counts (D69), by name. A group of one shows a plain
// Weight row, as a topic of the owner's does; the member that shares the group's name reads as
// the group in general, so Design's own row is not "Design" under Design.
const weightRows = (group?.members ?? [])
  .map((member) => ({
    id: member.id,
    label:
      group && group.members.length === 1
        ? "Weight"
        : member.name === group?.name
          ? `${member.name} in general`
          : member.name,
    name: member.name,
    weight: member.weight,
  }))
  .sort((a, b) => a.label.localeCompare(b.label));
// The topic as Edit topic sends it: a topic is always on, so it goes as enabled.
const upsert =
  topic &&
  JSON.stringify({
    op: "topic.upsert",
    topic: {
      id: topic.id,
      name: topic.name,
      description: topic.description,
      weight: topic.weight,
      enabled: true,
      keywords: topic.keywords,
      section_id: topic.section_id,
    },
  });
// A topic at Off keeps its page: its slider is how it comes back.
const editable = topic !== null;
// A general news topic feeds General episodes by how many outlets carry a story, so it has no weight.
const general = topic?.origin === "general";
// The Formats group: one slider for each format the topic's sources use, and for a general news topic a
// Perspective slider. Both go as one topic.mix (managePageSave.ts joins them).
const usedFormats = SOURCE_FORMATS.filter((format) =>
  list.some((source) => source.format === format),
);
const mixStops = MIX_STOPS.map((s) => ({ name: s.name, value: s.factor }));
const perspectiveStops = PERSPECTIVE_STOPS.map((s) => ({ name: s.name, value: s.value }));
// A group page keeps its one mix on the group's home topic; a topic apart keeps its own.
const mixOwner = group ? allTopics.find((t) => t.id === group.home) : topic;
const mixRows = mixOwner
  ? usedFormats.map((format) => ({
      id: `mix-${mixOwner.id}-${format}`,
      label: FORMAT_LABEL[format],
      name: `${FORMAT_LABEL[format]} in ${name}`,
      weight: MIX_STOPS.find((s) => s.name === mixOwner.format_mix?.[format])?.factor ?? 1,
      custom: {
        stops: mixStops,
        op: { op: "topic.mix", id: mixOwner.id, format_mix: {} },
        field: `format_mix.${format}`,
      },
    }))
  : [];
// A long list shows its first SHOWN sources and a button for the rest (D103).
const SHOWN = 7;
const hidden = Math.max(0, list.length - SHOWN);
// The topic's picture: a pure function of its id and name, drawn here at build time like the page.
const art = topicArt(group?.id ?? topic?.id ?? OTHER_ID, name);
// What Edit topic hands the panel (topicsPanel.ts, TopicFacts). Every topic can change its name; a
// built-in one keeps what counts, as fixed questions judge it.
const facts = topic && {
  id: topic.id,
  name: topic.name,
  description: topic.description,
  keywords: topic.keywords,
  origin: topic.origin,
};
---

<BaseLayout title={name} view="settings" skipLabel={`Skip to ${name}`}>
  <main id="main" tabindex="-1">
    {/* A topic's page: its summary card, how much it counts, and its sources. A topic is always on and
         available to every podcast, so there is no switch. The controls carry the edit they stand for
         (data-op); topicsEditor.ts records a change and autosave.ts sends it a moment later. */}
    <div class="manage topics topic-page" data-topics data-taken={[...taken, OTHER_ID].join(" ")} data-names={JSON.stringify(names)}>
      <noscript>
        <p class="manage-note">Changing topics and sources needs JavaScript, which is turned off in this browser.</p>
      </noscript>

      <fieldset class="manage-fields" data-fields>
        <legend class="sr-only">{name}</legend>
        <div class="topic" data-id={topic?.id ?? ""} data-topic>
          {/* The summary card: the topic's generated picture, its name and what counts as it, and a
               More menu with Edit and, for a topic of the owner's own, Delete. The menu is the app's
               popover menu (HeroMenu.astro, heroMenu.ts). */}
          {/* From 64rem there is no app bar above the page, so the way up is a line over the card. */}
          <nav class="topic-up" aria-label="Breadcrumb">
            <a class="settings-up" href="/settings/topics">
              <Icon name="chevronLeft" />
              <span>Topics and sources</span>
            </a>
          </nav>
          <div class="topic-card">
            <div class="topic-card-art" set:html={art} />
            <div class="topic-card-text">
              <SettingsHead title={name} crumbs={false} note={note} />
            </div>
            {
              topic && (
                <div class="topic-card-menu">
                  <button
                    class="icon-btn topic-more press"
                    type="button"
                    aria-label={`More actions for ${name}`}
                    aria-haspopup="menu"
                    popovertarget="topic-menu"
                    data-hero-more
                    data-needs-js
                  >
                    <Icon name="moreVert" />
                  </button>
                  <div class="hero-menu-list" id="topic-menu" popover role="menu" aria-label={`More actions for ${name}`}>
                    <button
                      class="hero-menu-item"
                      type="button"
                      role="menuitem"
                      aria-haspopup="dialog"
                      aria-label={`Edit topic ${name}`}
                      data-edit-topic={JSON.stringify(facts)}
                      data-topic-base={upsert}
                    >
                      Edit
                    </button>
                    {topic.origin === "custom" && (
                      <button
                        class="hero-menu-item hero-menu-delete topic-delete"
                        type="button"
                        role="menuitem"
                        data-pressed="false"
                        aria-label={`Delete topic ${name}`}
                        data-name={name}
                        data-label={`Delete topic ${name}`}
                        data-label-undo={`Keep topic ${name}`}
                        data-op={JSON.stringify({ op: "topic.remove", id: topic.id })}
                        data-remove
                        data-confirm
                      >
                        <span class="topic-delete-do">Delete</span>
                        <span class="topic-delete-undo">Keep topic</span>
                      </button>
                    )}
                  </div>
                </div>
              )
            }
          </div>
          {
            (group || (editable && topic)) && (
              <div class="rows topic-controls">
                {/* Where the topic plays (D69), and how much it counts. A general news topic is ranked
                     by how many outlets carry a story, so it has no weight. */}
                <div class="settings-row topic-scope">
                  <div class="settings-text">
                    <span class="settings-label" id="scope-label">Listen in</span>
                  </div>
                  <MultiSelect
                    id="scope"
                    labelledby="scope-label"
                    empty="In no podcast"
                    all="All podcasts"
                    options={SCOPES.map((scope) => ({
                      value: scope.key,
                      label: scope.label,
                      checked: inScope(scope.key),
                      op: JSON.stringify({ op: "topic.scope", ids: scopeIds }),
                      field: scope.key,
                    }))}
                  />
                </div>
                {topic && !general && <WeightRow id={topic.id} label="Weight" name={topic.name} weight={topic.weight} />}
                {weightRows.length === 1 && weightRows.map((row) => <WeightRow {...row} />)}
              </div>
            )
          }
          {
            weightRows.length > 1 && (
              <section class="topic-weights" aria-labelledby="weights-head">
                <h2 class="section-head" id="weights-head">Topic weightage</h2>
                <div class="rows topic-controls">
                  {weightRows.map((row) => <WeightRow {...row} />)}
                </div>
              </section>
            )
          }

          {
            (mixRows.length > 0 || (topic && general)) && (
              <section class="topic-weights" aria-labelledby="mix-head">
                <h2 class="section-head" id="mix-head">{mixRows.length > 0 ? "Formats" : "Perspective"}</h2>
                <div class="rows topic-controls">
                  {mixRows.map((row) => <WeightRow {...row} />)}
                  {topic && general && (
                    <WeightRow
                      id={`perspective-${topic.id}`}
                      label="Perspective"
                      name={`${topic.name} perspective`}
                      weight={topic.perspective ?? 0}
                      custom={{
                        stops: perspectiveStops,
                        op: { op: "topic.mix", id: topic.id, perspective: 0 },
                        field: "perspective",
                      }}
                    />
                  )}
                </div>
              </section>
            )
          }

          <div class="topic-sources-head">
            <h2 class="section-head">Sources</h2>
            {
              (topic === null || editable) && (
                <button
                  class="btn-secondary topic-add-source"
                  type="button"
                  aria-label={`Add source to ${name}`}
                  data-add-source={group?.home ?? topic?.id ?? ""}
                  data-needs-js
                >
                  <Icon name="plus" />
                  <span>Add source</span>
                </button>
              )
            }
          </div>
          {list.length > 0 && <SourceFilter sources={list} />}
          <ul class="topic-sources" role="list" data-sources aria-label={`${name} sources`}>
            {list.map((source) => <SourceRow source={source} topicName={topic?.name ?? ""} shownTopic={shown} />)}
          </ul>
          {
            hidden > 0 && (
              <button class="btn topic-show-all" type="button" data-show-all>
                {`Show ${hidden} more`}
              </button>
            )
          }
          {/* Shown by topics.css while the list above has no row: the section is otherwise blank. */}
          <div class="topic-empty empty" data-compact>
            <EmptyArt art="library" size="compact" />
            <p class="empty-title">No sources yet</p>
            <p class="empty-body">
              {topic === null || editable
                ? `Add a site or a feed, and its stories can reach your ${general ? "episodes" : "briefings"}.`
                : "Sources filed under this topic are listed here."}
            </p>
          </div>

          <SuggestedSources offers={suggested} name={name} topicId={group?.home ?? topic?.id ?? ""} />
          <p class="manage-quiet topic-gone" tabindex="-1">Removed.</p>
        </div>
      </fieldset>

      <ManageChrome />
      <TopicsPanel topics={choices} />
      {
        topic?.origin === "custom" && (
          <dialog class="confirm-dialog" aria-labelledby="topic-delete-title" aria-describedby="topic-delete-lede" data-topic-confirm>
            <div class="confirm-form">
              <h2 class="sheet-title" id="topic-delete-title">{`Delete ${name}?`}</h2>
              <p class="create-hint confirm-lede" id="topic-delete-lede">Its sources move to Other.</p>
              <div class="confirm-actions">
                <button class="btn" type="button" data-confirm-cancel autofocus>Cancel</button>
                <button class="btn confirm-delete" type="button" data-confirm-delete>Delete</button>
              </div>
            </div>
          </dialog>
        )
      }
    </div>
  </main>
</BaseLayout>

<script>
  import { installTopicsPage } from "../../../scripts/topicsPage";

  installTopicsPage();
</script>
