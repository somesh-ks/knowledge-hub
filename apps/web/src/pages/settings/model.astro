---
import Icon from "../../components/Icon.astro";
import ManageChrome from "../../components/ManageChrome.astro";
import SettingsHead from "../../components/SettingsHead.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadWriterView, writerLabel } from "../../lib/writer";
import "../../styles/settings.css";
import "../../styles/manage.css";
import "../../styles/podcast.css";

const { model, provider } = await loadWriterView();
---

<BaseLayout title="Model" view="settings" skipLabel="Skip to the model settings">
  <main id="main" tabindex="-1">
    {/* The writer: a vendor, then a model from that vendor's list. scripts/podcastPage.ts runs the
         combobox and records a change; autosave.ts sends it a moment later. */}
    <div class="manage" data-manage="podcast">
      <SettingsHead title="Model" />
      <noscript>
        <p class="manage-note">Changing the model needs JavaScript, which is turned off in this browser.</p>
      </noscript>

      <fieldset class="manage-fields" data-fields>
        <legend class="sr-only">Model</legend>
        <div class="daily-panel" data-panel>
          <div class="daily-model">
            <div class="rows" data-models data-saved={model ?? ""} data-provider={provider}>
              <div class="settings-row">
                <label class="settings-label" for="daily-vendor">Provider</label>
                <span class="manage-select value-select">
                  <select class="manage-input" id="daily-vendor" name="vendor" autocomplete="off">
                    <option value="anthropic" selected={provider === "anthropic"}>Anthropic</option>
                    <option value="nebius" selected={provider === "nebius"}>Nebius</option>
                  </select>
                  <Icon name="chevronDown" />
                </span>
              </div>
              <div class="settings-row">
                <div class="settings-text">
                  <label class="settings-label" for="model-input">Model</label>
                </div>
                <div class="daily-selects daily-selects-one daily-combo" data-combo>
                  <span class="manage-select">
                    <input
                      class="manage-input"
                      id="model-input"
                      type="text"
                      role="combobox"
                      aria-expanded="false"
                      aria-controls="model-listbox"
                      aria-autocomplete="list"
                      autocomplete="off"
                      autocapitalize="off"
                      spellcheck="false"
                      value={writerLabel(model, provider)}
                    />
                    <button class="daily-combo-toggle" type="button" tabindex="-1" aria-label="Show all models" data-toggle>
                      <Icon name="chevronDown" />
                    </button>
                  </span>
                  <div class="daily-listbox" id="model-listbox" role="listbox" aria-label="Models" data-list hidden></div>
                </div>
              </div>
            </div>
            <p class="sr-only" aria-live="polite" data-count></p>

            {/* Without the live list the combobox still offers the top models by name; this field
                 takes the id of any other model. */}
            <div class="manage-field" data-fallback hidden>
              <p class="manage-quiet">Only the top models are listed right now. For another model, type its id.</p>
              <label for="model-typed">Model id</label>
              <input
                class="manage-input"
                id="model-typed"
                type="text"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
                maxlength="120"
                aria-describedby="model-typed-note"
              />
              <span class="manage-quiet" id="model-typed-note" data-typed-note hidden>
                Use letters, digits and . _ - / : only.
              </span>
            </div>
          </div>
        </div>
      </fieldset>

      <ManageChrome />
    </div>
  </main>
</BaseLayout>

<script>
  import { installPodcastPage } from "../../scripts/podcastEntry";

  installPodcastPage();
</script>
