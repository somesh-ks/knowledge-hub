---
import Icon from "../../components/Icon.astro";
import ManageChrome from "../../components/ManageChrome.astro";
import SettingsHead from "../../components/SettingsHead.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadWriterView, writerLabel } from "../../lib/writer";
import "../../styles/settings.css";
import "../../styles/manage.css";
import "../../styles/podcast.css";

const { model, provider } = await loadWriterView();
---

<BaseLayout title="AI Model" view="settings" skipLabel="Skip to the model settings">
  <main id="main" tabindex="-1">
    {/* The writer: a vendor, then a model from that vendor's list. scripts/podcastPage.ts fills the
         model select and records a change; autosave.ts sends it a moment later. */}
    <div class="manage" data-manage="podcast">
      <SettingsHead title="AI Model" />
      <noscript>
        <p class="manage-note">Changing the model needs JavaScript, which is turned off in this browser.</p>
      </noscript>

      <fieldset class="manage-fields" data-fields>
        <legend class="sr-only">AI Model</legend>
        <div class="daily-panel" data-panel>
          <div class="daily-model">
            <div class="rows" data-models data-saved={model ?? ""} data-provider={provider}>
              <div class="settings-row">
                <label class="settings-label" for="daily-vendor">Provider</label>
                <span class="manage-select value-select">
                  <select class="manage-input" id="daily-vendor" name="vendor" autocomplete="off">
                    <option value="anthropic" selected={provider === "anthropic"}>Anthropic</option>
                    <option value="nebius" selected={provider === "nebius"}>Nebius</option>
                  </select>
                  <Icon name="chevronDown" />
                </span>
              </div>
              <div class="settings-row">
                <div class="settings-text">
                  <label class="settings-label" for="model-select">AI Model</label>
                </div>
                <span class="manage-select value-select">
                  <select class="manage-input" id="model-select" name="model" autocomplete="off">
                    <option value={model ?? ""} selected>{writerLabel(model, provider)}</option>
                  </select>
                  <Icon name="chevronDown" />
                </span>
              </div>
            </div>
          </div>
        </div>
      </fieldset>

      <ManageChrome />
    </div>
  </main>
</BaseLayout>

<script>
  import { installPodcastPage } from "../../scripts/podcastEntry";

  installPodcastPage();
</script>
