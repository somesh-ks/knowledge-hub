---
import SettingsHead from "../../components/SettingsHead.astro";
import Select from "../../design-system/Select.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/settings.css";

const title = "Notifications";
---

<BaseLayout title={title} view="settings" skipLabel="Skip to the notification settings">
  <main id="main" tabindex="-1">
    {/* Kept in this browser (its permission and push subscription), so nothing is set here:
         notificationsSettings.ts fills the select and the line under it in, as settingsPage.ts does
         for the other pages. The select waits inert until then, so a stored On never shows Off first. */}
    <div class="settings-view" data-settings>
      <SettingsHead title={title} note="Hear when a podcast you asked for is ready." />
      <noscript>
        <p class="settings-note">These settings need JavaScript, which is turned off in this browser.</p>
      </noscript>
      <section>
        <div class="rows card-group">
          <div class="settings-row">
            <div class="settings-text">
              <label class="settings-label" for="settings-notifications">Notifications</label>
              <span class="settings-hint" data-notifications-note>A ping when a Catch up or a new take you started is ready.</span>
            </div>
            <Select class="value-select" id="settings-notifications" name="notifications" autocomplete="off" inert>
              <option value="on">On</option>
              <option value="off">Off</option>
            </Select>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  import { installSettingsPage } from "../../scripts/settingsPage";

  installSettingsPage();
</script>
