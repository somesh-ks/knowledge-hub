---
import Icon from "../../components/Icon.astro";
import ManageChrome from "../../components/ManageChrome.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadManage } from "../../lib/manage";
// The switch is the settings page's own; the rows and fields are manage.css, and the search field
// and the chips are the Library's.
import "../../styles/settings.css";
import "../../styles/manage.css";

const { sources, candidates } = await loadManage();
const filters = [
  { id: "all", label: "All" },
  { id: "pinned", label: "Pinned" },
  { id: "off", label: "Off" },
  ...(candidates.length > 0 ? [{ id: "suggested", label: "Suggested" }] : []),
];
const quietLine = (host: string, record: string | null, struggling: boolean): string =>
  [host, record, struggling ? "Not loading lately" : null].filter(Boolean).join(" · ");
---

<BaseLayout title="Sources" view="settings" skipLabel="Skip to the sources">
  <main id="main" tabindex="-1">
    {/* Every source is a row in the page, so searching and the chips only hide and show rows, and
         the list reads with scripts off. managePage.ts records changes and sends them on Save. */}
    <div class="manage" data-manage="sources">
      <a class="btn manage-back press press-subtle" href="/settings">
        <Icon name="arrowBack" />
        <span>Settings</span>
      </a>
      <h1 class="page-title manage-title" id="page-title" tabindex="-1">Sources</h1>
      <noscript>
        <p class="manage-note">Changing sources needs JavaScript, which is turned off in this browser.</p>
      </noscript>

      <fieldset class="manage-fields" data-fields>
        <legend class="sr-only">Sources</legend>

        <form class="manage-form" data-needs-js data-add="source" aria-labelledby="add-source">
          <h2 class="section-head" id="add-source">Add a source</h2>
          <div class="manage-field">
            <label for="source-url">Site or feed address</label>
            <input
              class="manage-input"
              id="source-url"
              name="url"
              type="text"
              inputmode="url"
              required
              maxlength="2048"
              autocomplete="off"
              autocapitalize="none"
              spellcheck="false"
            />
          </div>
          <button class="btn-primary manage-submit press press-subtle" type="submit">
            <Icon name="plus" />
            <span>Add source</span>
          </button>
        </form>

        <ul class="rows manage-queued" role="list" data-queued aria-label="Waiting to be saved"></ul>

        <form class="library-tools manage-tools" role="search" aria-label="Sources" data-needs-js>
          <label class="search-field">
            <Icon name="search" />
            <span class="sr-only">Search sources</span>
            <input
              type="search"
              name="q"
              placeholder="Search sources"
              autocomplete="off"
              enterkeyhint="search"
              data-search
            />
          </label>
          <div class="library-bar">
            <div class="filter-chips" role="group" aria-label="Show">
              {
                filters.map((filter) => (
                  <button
                    class="filter-chip press press-subtle"
                    type="button"
                    aria-pressed={filter.id === "all" ? "true" : "false"}
                    data-filter={filter.id}
                  >
                    {filter.label}
                  </button>
                ))
              }
            </div>
          </div>
        </form>
        <p class="sr-only" role="status" data-status></p>

        <section data-section-of="sources">
          <h2 class="section-head">Your sources</h2>
          {sources.length === 0 && <p class="manage-note">No sources yet.</p>}
          <ul class="rows" role="list">
            {
              sources.map((source) => (
                <li
                  class="manage-row"
                  data-id={source.id}
                  data-find={source.search}
                >
                  <div class="manage-main">
                    <div class="manage-text">
                      <span class="manage-name" id={`name-${source.id}`}>
                        {source.name}
                      </span>
                      <span class="manage-quiet" id={`line-${source.id}`} data-line>
                        {quietLine(source.host, source.record, source.struggling)}
                      </span>
                      <span class="manage-quiet manage-flag">Removed when you save.</span>
                    </div>
                    <button
                      class="icon-btn manage-pin press"
                      type="button"
                      aria-pressed={source.pinned ? "true" : "false"}
                      aria-label={`Pin ${source.name}`}
                      data-op={JSON.stringify({ op: "source.set", id: source.id })}
                      data-field="pinned"
                      data-pin
                    >
                      <Icon name="pin" />
                      <Icon name="pinFill" />
                    </button>
                    <input
                      class="settings-switch"
                      type="checkbox"
                      role="switch"
                      autocomplete="off"
                      checked={source.enabled}
                      aria-labelledby={`name-${source.id}`}
                      aria-describedby={`line-${source.id}`}
                      data-op={JSON.stringify({ op: "source.set", id: source.id })}
                      data-field="enabled"
                    />
                    <button
                      class="icon-btn manage-remove press"
                      type="button"
                      aria-pressed="false"
                      aria-label={`Remove ${source.name}`}
                      data-op={JSON.stringify({ op: "source.remove", id: source.id })}
                      data-remove
                    >
                      <Icon name="trash" />
                    </button>
                  </div>
                </li>
              ))
            }
          </ul>
        </section>

        {
          candidates.length > 0 && (
            <section data-section-of="suggested">
              <h2 class="section-head">Suggested</h2>
              <ul class="rows" role="list">
                {candidates.map((candidate) => (
                  <li
                    class="manage-row"
                    data-find={candidate.search}
                    data-url={candidate.feed_url}
                  >
                    <div class="manage-main">
                      <div class="manage-text">
                        <span class="manage-name">{candidate.domain}</span>
                        <span class="manage-quiet">{candidate.detail}</span>
                      </div>
                      <button
                        class="btn manage-suggest press press-subtle"
                        type="button"
                        aria-pressed="false"
                        aria-label={`Add ${candidate.domain}`}
                        data-op={JSON.stringify({
                          op: "source.add",
                          url: candidate.feed_url,
                          ...(candidate.topic_id ? { topic_ids: [candidate.topic_id] } : {}),
                        })}
                        data-suggest
                      >
                        <Icon name="plus" />
                        <Icon name="check" />
                        <span class="manage-suggest-add">Add</span>
                        <span class="manage-suggest-added">Added</span>
                      </button>
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <div class="library-empty manage-empty" data-empty hidden>
          <p>No sources match.</p>
        </div>
      </fieldset>

      <ManageChrome />
    </div>
  </main>
</BaseLayout>

<script>
  import { installManagePage } from "../../scripts/managePage";

  installManagePage();
</script>
