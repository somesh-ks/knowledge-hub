---
import ManageChrome from "../../components/ManageChrome.astro";
import PodcastProfile from "../../components/PodcastProfile.astro";
import SettingsHead from "../../components/SettingsHead.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadManage } from "../../lib/manage";
import { loadScheduleView } from "../../lib/schedule";
import { byName, topicLayout } from "../../lib/topicPages";
import "../../styles/settings.css";
import "../../styles/manage.css";
import "../../styles/podcast.css";

/**
 * One page per scheduled episode: Daily and Weekly. An episode made on request is set up in the Create
 * panel itself, so it has no page here.
 */
export function getStaticPaths() {
  return [{ params: { profile: "daily" } }, { params: { profile: "weekly" } }];
}

type Profile = "daily" | "weekly";
const profile = Astro.params.profile as Profile;
const [{ topics, sources }, schedule] = await Promise.all([loadManage(), loadScheduleView()]);
const layout = topicLayout(topics, sources);
// Every topic can be put in or out of a scheduled podcast: the owner's three, their own and the
// general news topics, by name as the Sources page lists them (2026-10-22).
const scopeTopics = [
  ...layout.groups.map((group) => ({
    id: group.id,
    name: group.name,
    ids: group.members.map((member) => member.id),
  })),
  ...layout.own.map((topic) => ({ id: topic.id, name: topic.name, ids: [topic.id] })),
  ...layout.general.map((topic) => ({ id: topic.id, name: topic.name, ids: [topic.id] })),
].sort(byName);

const PAGES = {
  daily: {
    title: "Daily Podcast",
    values: {
      timezone: schedule.timezone,
      hour: schedule.hour,
      cadenceDays: schedule.cadenceDays,
      skipTopics: schedule.skipTopics,
      lengthMinutes: schedule.lengthMinutes,
    },
  },
  weekly: {
    title: "Weekly Podcast",
    values: {
      timezone: schedule.timezone,
      hour: schedule.weekly.hour,
      day: schedule.weekly.day,
      skipTopics: schedule.weekly.skip_topics,
      format: schedule.weekly.format,
      lengthMinutes: schedule.weekly.length_minutes,
    },
  },
} as const;
const { title, values } = PAGES[profile];
---

<BaseLayout title={title} view="settings" skipLabel={`Skip to the ${title} settings`}>
  <main id="main" tabindex="-1">
    {/* Static HTML with the saved values written in. scripts/podcastPage.ts records a change and
         autosave.ts sends it a moment later. The voices are on the Podcast voice page. */}
    <div class="manage" data-manage="podcast">
      <SettingsHead title={title} />
      <noscript>
        <p class="manage-note">Changing these settings needs JavaScript, which is turned off in this browser.</p>
      </noscript>

      <fieldset class="manage-fields" data-fields>
        <legend class="sr-only">{title}</legend>
        <div class="daily-panel" data-panel>
          <PodcastProfile
            id={profile}
            values={values}
            topics={scopeTopics}
          />
        </div>
      </fieldset>

      <ManageChrome />
    </div>
  </main>
</BaseLayout>

<script>
  import { installPodcastPage } from "../../scripts/podcastEntry";

  installPodcastPage();
</script>
