---
import SettingsHead from "../../components/SettingsHead.astro";
import Select from "../../design-system/Select.astro";
import Slider from "../../design-system/Slider.astro";
import Switch from "../../design-system/Switch.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/settings.css";

const title = "Sounds and haptics";
---

<BaseLayout title={title} view="settings" skipLabel="Skip to the sound and haptics settings">
  <main id="main" tabindex="-1">
    {/* The switch and the slider are kept in this browser, so nothing is set here: settingsPage.ts
         fills them in and marks the page ready, as on the Settings index. */}
    <div class="settings-view" data-settings>
      <SettingsHead title={title} note="The small sounds and touch feedback the app makes as you use it." />
      <noscript>
        <p class="settings-note">These settings need JavaScript, which is turned off in this browser.</p>
      </noscript>
      <section>
        <div class="rows card-group">
          <div class="settings-row">
            <label class="settings-label" for="settings-sounds">Interface sounds</label>
            <Switch id="settings-sounds" name="sounds" />
          </div>
          <div class="settings-row">
            <label class="settings-label" for="settings-volume">Volume</label>
            <Slider id="settings-volume" name="volume" min="0" max="1" step="0.05" />
          </div>
        </div>
      </section>
      {/* Touch feedback (D273). Hidden where this device has no motor to ask (a desktop browser, an
           iPhone before iOS 18): settingsPage.ts shows it. The select waits inert for its listener,
           as Theme's does, so a stored Off never shows On first. */}
      <section data-haptics-section hidden>
        <div class="rows card-group">
          <div class="settings-row">
            <label class="settings-label" for="settings-haptics">Haptics</label>
            <Select class="value-select" id="settings-haptics" name="haptics" autocomplete="off" inert>
              <option value="on">On</option>
              <option value="off">Off</option>
            </Select>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  import { installSettingsPage } from "../../scripts/settingsPage";

  installSettingsPage();
</script>
