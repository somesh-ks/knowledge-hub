---
import { topicEmoji } from "@dispatch/core";
import AddFab from "../../components/AddFab.astro";
import Icon from "../../components/Icon.astro";
import ManageChrome from "../../components/ManageChrome.astro";
import SettingsHead from "../../components/SettingsHead.astro";
import SourceFilter from "../../components/SourceFilter.astro";
import SourceRow from "../../components/SourceRow.astro";
import TopicsPanel from "../../components/TopicsPanel.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { outletsSummary } from "../../lib/blockedOutlets";
import { loadBlockedDomains } from "../../lib/blockedProfile";
import { loadManage } from "../../lib/manage";
import {
  byName,
  OTHER_ID,
  plural,
  topicChoicesOf,
  topicLayout,
  topicSummary,
} from "../../lib/topicPages";
// The switch and the slider are the settings page's own; the form fields, the saving toast and the
// passphrase dialog are manage.css; the rows and stars are topics.css.
import "../../styles/settings.css";
import "../../styles/manage.css";
import "../../styles/topics.css";

const { topics, sources } = await loadManage();
const blocked = await loadBlockedDomains();
// Every topic in one list, by name (D69): Design, AI and Technology (the judge's finer topics live
// inside them and are not listed), the general news topics and any of the owner's own. Other,
// which is no topic, comes last. Each topic's page sets where it plays.
const layout = topicLayout(topics, sources);
const { groups } = layout;
// How many sources a topic has, and how many of them are read.
const counts = (id: string): [number, number] => {
  const list = layout.sources.get(id) ?? [];
  return [list.length, list.filter((source) => source.enabled).length];
};
const rows = [
  ...groups.map((group) => ({
    id: group.id,
    name: group.name,
    emoji: topicEmoji(group),
    hint: topicSummary(null, ...counts(group.id)),
    members: group.members.map((member) => member.id),
    never: undefined,
  })),
  ...[...layout.own, ...layout.general].map((topic) => ({
    id: topic.id,
    name: topic.name,
    emoji: topicEmoji(topic),
    hint: topicSummary(topic, ...counts(topic.id)),
    members: [topic.id],
    never: topic.never_publish ? "" : undefined,
  })),
].sort(byName);
// Where every source shows and whether it is read, so a source switched off, moved, removed or
// added since the build is counted in the rows' lines (savedView.ts recounts them).
const spots = Object.fromEntries(
  [...layout.sources].flatMap(([page, list]) =>
    list.map((source) => [source.id, { page, on: source.enabled }]),
  ),
);
// Every source once, by name, under the page it is filed on: the flat list the search shows. The
// sources no topic page shows (the Other list) are not offered here (2026-10-21).
const pageNames = new Map(rows.map((row) => [row.id, row.name] as const));
const library = new Map<string, { source: (typeof sources)[number]; page: string }>();
for (const [page, list] of layout.sources) {
  if (page === OTHER_ID) continue;
  for (const source of list) library.set(source.id, { source, page });
}
const libraryRows = [...library.values()].sort((a, b) =>
  a.source.name.localeCompare(b.source.name, "en"),
);
const choices = topicChoicesOf(layout);
---

<BaseLayout title="Sources" view="settings" skipLabel="Skip to sources">
  <main id="main" tabindex="-1">
    {/* One row per topic, each leading to its own page (topics/[id].astro) with its switch, its
         weight and its sources. Here: a search over every source, and Add, which opens one panel for
         a new topic or a new source, chosen by a segmented control at its top. topicsPage.ts loads
         the editor on first use; autosave.ts sends a change a moment later. */}
    <div
      class="manage topics"
      data-topics
      data-taken={[...topics.map((topic) => topic.id), ...groups.map((group) => group.id), OTHER_ID].join(" ")}
      data-names={JSON.stringify(choices.map((choice) => choice.name))}
    >
      <SettingsHead title="Sources" />
      <noscript>
        <p class="manage-note">Changing topics and sources needs JavaScript, which is turned off in this browser.</p>
      </noscript>

      <fieldset class="manage-fields" data-fields>
        <legend class="sr-only">Topics</legend>
        {/* Search alone (2026-10-20): no count and no filters. Add is the floating button below
             64rem (AddFab.astro) and a button beside the search from 64rem; one shows at a time. */}
        <SourceFilter sources={libraryRows.map((row) => row.source)}>
          <button
            slot="action"
            class="btn-secondary topic-add-source topics-add"
            type="button"
            aria-label="Add a topic or a source"
            data-add-topic
            data-needs-js
          >
            <Icon name="plus" />
            <span>Add</span>
          </button>
        </SourceFilter>

        <ul class="topic-sources topics-added" role="list" data-sources data-added aria-label="Sources being added"></ul>
        <ul class="rows manage-queued" role="list" data-queued aria-label="Topics being added"></ul>

        <div class="rows topics-index" data-spots={JSON.stringify(spots)}>
          {
            rows.map((row) => (
              <a
                class="row-action"
                href={`/settings/topics/${row.id}`}
                data-page={row.id}
                data-members={row.members.join(" ")}
                data-never={row.never}
              >
                <span class="topic-emoji" aria-hidden="true">{row.emoji}</span>
                <span class="settings-text">
                  <span class="settings-label">{row.name}</span>
                  <span class="settings-hint" data-hint>{row.hint}</span>
                </span>
                <Icon name="chevronRight" />
              </a>
            ))
          }
        </div>

        {/* Every source, shown in place of the topics while the search or a chip is set. */}
        <ul class="topic-sources topics-library" role="list" hidden data-library data-all aria-label="Matching sources">
          {
            libraryRows.map(({ source, page }) => {
              const group = groups.find((candidate) => candidate.id === page);
              return (
                <SourceRow
                  source={source}
                  topicName={pageNames.get(page) ?? ""}
                  shownTopic={group ? { id: group.home, name: group.name } : undefined}
                  labelled
                />
              );
            })
          }
        </ul>

        {/* Outlets left out of every briefing and episode, under a line of their own; their page is
             blocked-outlets.astro. */}
        <div class="rows topics-more">
          <a class="row-action" href="/settings/blocked-outlets">
            <span class="topic-emoji topic-blocked-mark" aria-hidden="true"><Icon name="blocked" /></span>
            <span class="settings-text">
              <span class="settings-label">Blocked sources</span>
              <span class="settings-hint" data-blocked-hint data-blocked={JSON.stringify(blocked)}>
                {outletsSummary(blocked.length)}
              </span>
            </span>
            <Icon name="chevronRight" />
          </a>
        </div>

      </fieldset>

      <AddFab label="Add a topic or a source" />
      <ManageChrome />
      <TopicsPanel topics={choices} />
    </div>
  </main>
</BaseLayout>

<script>
  import { installTopicsPage } from "../../scripts/topicsPage";

  installTopicsPage();
</script>
