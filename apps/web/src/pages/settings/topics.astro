---
import Icon from "../../components/Icon.astro";
import ManageChrome from "../../components/ManageChrome.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadManage, WEIGHT_STEP_MAX, WEIGHT_STEPS } from "../../lib/manage";
import { catalogLine, loadSourceCatalog } from "../../lib/sourceCatalog";
// The switch and the slider are the settings page's own; the rows and fields are manage.css.
import "../../styles/settings.css";
import "../../styles/manage.css";

const { topics } = await loadManage();
const catalog = await loadSourceCatalog();
// A topic that never publishes has nothing to turn on or weigh, so it comes last and stays plain.
const editable = topics.filter((topic) => !topic.never_publish);
const fixed = topics.filter((topic) => topic.never_publish);
---

<BaseLayout title="Topics" view="settings" skipLabel="Skip to the topics">
  <main id="main" tabindex="-1">
    {/* Every row is static HTML with its current state written in, so the list reads with scripts
         off. managePage.ts adds the editing: it only ever records a change and sends it on Save. */}
    <div
      class="manage"
      data-manage="topics"
      data-steps={WEIGHT_STEPS.join("|")}
      data-taken={topics.map((topic) => topic.id).join(" ")}
    >
      <a class="btn manage-back press press-subtle" href="/settings">
        <Icon name="arrowBack" />
        <span>Settings</span>
      </a>
      <h1 class="page-title manage-title" id="page-title" tabindex="-1">Topics</h1>
      <noscript>
        <p class="manage-note">Changing topics needs JavaScript, which is turned off in this browser.</p>
      </noscript>

      <fieldset class="manage-fields" data-fields>
        <legend class="sr-only">Topics</legend>

        <ul class="rows manage-queued" role="list" data-queued aria-label="Waiting to be saved"></ul>

        <section>
          <h2 class="section-head">{editable.length} topics</h2>
          <ul class="rows" role="list">
            {
              editable.map((topic) => (
                <li
                  class="manage-row"
                  data-id={topic.id}
                >
                  <div class="manage-main">
                    <div class="manage-text">
                      <span class="manage-name" id={`name-${topic.id}`}>
                        {topic.name}
                      </span>
                      <span class="manage-quiet" id={`line-${topic.id}`} data-line>
                        {topic.description}
                      </span>
                      <span class="manage-quiet manage-flag">Removed when you save</span>
                    </div>
                    <input
                      class="settings-switch"
                      type="checkbox"
                      role="switch"
                      autocomplete="off"
                      checked={topic.enabled}
                      aria-labelledby={`name-${topic.id}`}
                      aria-describedby={`line-${topic.id}`}
                      data-op={JSON.stringify({
                        op: "topic.upsert",
                        topic: {
                          id: topic.id,
                          name: topic.name,
                          description: topic.description,
                          weight: topic.weight,
                          enabled: topic.enabled,
                          keywords: topic.keywords,
                          section_id: topic.section_id,
                        },
                      })}
                      data-field="topic.enabled"
                    />
                    {topic.origin === "custom" && (
                      <button
                        class="icon-btn manage-remove press"
                        type="button"
                        aria-pressed="false"
                        aria-label={`Remove ${topic.name}`}
                        data-op={JSON.stringify({ op: "topic.remove", id: topic.id })}
                        data-remove
                      >
                        <Icon name="trash" />
                      </button>
                    )}
                  </div>
                  <div class="manage-weight">
                    <input
                      class="settings-range"
                      type="range"
                      min="0"
                      max="1"
                      step={1 / WEIGHT_STEP_MAX}
                      value={topic.step / WEIGHT_STEP_MAX}
                      autocomplete="off"
                      aria-label={`${topic.name}, amount in briefings`}
                      aria-valuetext={WEIGHT_STEPS[topic.step]}
                      style={`--range-fill: ${(topic.step / WEIGHT_STEP_MAX) * 100}%`}
                      data-op={JSON.stringify({ op: "weights.set", weights: {} })}
                      data-field={`weights.${topic.id}`}
                      data-weight
                    />
                    <span class="manage-quiet manage-word" aria-hidden="true" data-word>
                      {WEIGHT_STEPS[topic.step]}
                    </span>
                  </div>
                </li>
              ))
            }
            {
              fixed.map((topic) => (
                <li class="manage-row">
                  <div class="manage-main">
                    <div class="manage-text">
                      <span class="manage-name">{topic.name}</span>
                      <span class="manage-quiet">Never in a briefing</span>
                    </div>
                  </div>
                </li>
              ))
            }
          </ul>
        </section>

        <details class="manage-add" id="add-topic" data-needs-js>
          <summary class="btn press press-subtle">
            <Icon name="plus" />
            <span>Add a topic</span>
          </summary>
          <form class="manage-form" data-add="topic" aria-label="Add a topic" novalidate>
            <div class="manage-field">
              <label for="topic-name">Name</label>
              <input
                class="manage-input"
                id="topic-name"
                name="name"
                type="text"
                required
                maxlength="60"
                autocomplete="off"
                aria-describedby="topic-name-error"
              />
              <p class="manage-error" id="topic-name-error" role="alert" data-error="name" hidden>
                <Icon name="alert" /><span></span>
              </p>
            </div>
            <div class="manage-field">
              <label for="topic-description">What should count as this topic</label>
              <textarea
                class="manage-input"
                id="topic-description"
                name="description"
                required
                maxlength="400"
                rows="3"
                aria-describedby="topic-description-error"></textarea>
              <p class="manage-error" id="topic-description-error" role="alert" data-error="description" hidden>
                <Icon name="alert" /><span></span>
              </p>
            </div>
            <fieldset class="manage-suggest-group" data-suggestions hidden>
              <legend class="manage-legend">Suggested sources</legend>
              <ul class="rows" role="list">
                {
                  catalog.map((source) => (
                    <li
                      hidden
                      data-offer={source.name}
                      data-tags={source.tags.join(" ")}
                      data-feed={source.feed_url}
                    >
                      <label class="manage-pick">
                        <input type="checkbox" name="source" value={source.feed_url} />
                        <span class="manage-text">
                          <span class="manage-name">{source.name}</span>
                          <span class="manage-quiet">{catalogLine(source)}</span>
                        </span>
                      </label>
                    </li>
                  ))
                }
              </ul>
            </fieldset>
            <p class="manage-quiet" data-no-suggestions hidden>
              No matching sources yet.
            </p>
            <button class="btn-primary manage-submit press press-subtle" type="submit">
              <Icon name="plus" />
              <span>Add topic</span>
            </button>
          </form>
        </details>
      </fieldset>

      <ManageChrome />
    </div>
  </main>
</BaseLayout>

<script>
  import { installManagePage } from "../../scripts/managePage";

  installManagePage();
</script>
