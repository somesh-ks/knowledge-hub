---
import CreateForm from "../components/CreateForm.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Catch up" view="create" skipLabel="Skip to the form">
  <main id="main" tabindex="-1">
    <div class="settings-view create-page">
      <h1 class="text-display" id="page-title" tabindex="-1">Catch up</h1>
      <noscript>
        <p class="create-note">Making an episode needs JavaScript, which is turned off in this browser.</p>
      </noscript>
      <CreateForm />
    </div>
  </main>
  <script>
    // Loaded on demand, so it stays one shared module. A script this small is otherwise inlined into
    // the page, and an inline module is blocked by the Content-Security-Policy when a client-side
    // navigation brings the page in.
    void import("../scripts/createPage");
  </script>
</BaseLayout>
