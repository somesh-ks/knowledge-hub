---
import Banner from "../design-system/Banner.astro";
import DigestView from "../components/DigestView.astro";
import EmptyState from "../components/EmptyState.astro";
import EpisodeView from "../components/EpisodeView.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { catchUpAlbum } from "../lib/catchUps";
import { hasSectionTabs, listenLength } from "../lib/digestView";
import { episodeSections } from "../lib/episodeHighlights";
import { episodeLength, storyLookups } from "../lib/episodes";
import { longDate } from "../lib/format";
import { newestItem } from "../lib/latest";
import { briefingCard, episodeCard } from "../lib/linkCard";
import { getSite } from "../lib/site";
import { CONTENT_CDN_CACHE, readFromContentRepo } from "../server/contentRepo";

// Rendered on request from the content repository (D173); the static test build prerenders it.
export const prerender = false;

if (!Astro.isPrerendered) {
  const unavailable = await readFromContentRepo("home");
  if (unavailable) return unavailable;
  Astro.response.headers.set("Vercel-CDN-Cache-Control", CONTENT_CDN_CACHE);
}

const site = await getSite();
// Latest is the newest item of any kind: a catch-up episode made after the briefing opens as itself.
const newest = newestItem(site);
const episode =
  newest?.kind === "episode" ? site.episodes.find((e) => e.id === newest.id) : undefined;
const lookups = episode ? storyLookups(site.entries) : undefined;
const episodeTabs =
  episode && lookups ? episodeSections(episode.episode, lookups).length > 1 : false;
// Where a device that deleted this episode goes while the store still lists it (deletedEpisodes.ts).
const fallback: string[] = [];
if (episode) {
  const skipped = new Set([episode.id]);
  for (let i = 0; i < 3; i++) {
    const next = newestItem(site, skipped);
    if (!next) break;
    skipped.add(next.id);
    fallback.push(next.kind === "episode" ? `/e/${next.id}` : `/d/${next.id}`);
  }
}
const latest = site.entries[0];
const earlier = site.entries.slice(1, 4);
---

{
  episode && lookups ? (
    <BaseLayout
      title={episode.episode.title}
      view="home"
      digestId={episode.id}
      latestFallback={fallback}
      card={episodeCard(episode)}
      audio={{ noun: "episode", length: episodeLength(episode.episode) }}
      layout={episodeTabs ? "aside" : "single"}
      tabs={episodeTabs}
      skipLabel="Skip to the episode"
    >
      <EpisodeView entry={episode} {...lookups} album={catchUpAlbum(site.episodes, episode.id)} />
    </BaseLayout>
  ) : (
<BaseLayout
  title={latest?.player.title}
  view="home"
  layout={latest && hasSectionTabs(latest) ? "aside" : "single"}
  tabs={latest ? hasSectionTabs(latest) : false}
  skipLabel={latest ? undefined : "Skip to the content"}
  digestId={latest?.id}
  card={latest && briefingCard(latest)}
  audio={latest && {
    noun: "podcast",
    length: listenLength(latest),
    expired: latest.audioMode === "expired",
  }}
>
  <Fragment slot="banners">
    {
      latest && site.showNothingBanner && (
        <Banner
          tone="info"
          icon="info"
          title="Nothing cleared the bar."
          body={`No new stories since ${longDate(latest.digest.date)}. The next podcast is due within two days.`}
        />
      )
    }
  </Fragment>
  {
    latest ? (
      <DigestView entry={latest} earlier={earlier} isLatest />
    ) : (
      <main id="main" tabindex="-1">
        <EmptyState />
      </main>
    )
  }
</BaseLayout>
  )
}
