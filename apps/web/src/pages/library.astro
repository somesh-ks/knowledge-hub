---
import BriefingCard from "../components/BriefingCard.astro";
import EmptyState from "../components/EmptyState.astro";
import EpisodeCard from "../components/EpisodeCard.astro";
import Icon from "../components/Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { LIBRARY_FILTERS, LIBRARY_SORTS, resultSummary } from "../lib/library";
import { libraryItems } from "../lib/libraryCard";
import { getSite } from "../lib/site";

const { entries, episodes } = await getSite();
const items = libraryItems(entries, episodes);
---

<BaseLayout title="Library" view="library" skipLabel="Skip to the library">
  <main id="main" class="library" tabindex="-1">
    {
      items.length === 0 ? (
        <EmptyState />
      ) : (
        <div data-library>
          <h1 class="page-title library-title" id="page-title" tabindex="-1">
            Library
          </h1>
          {/* Search, then what to show, then the order. Every briefing is already in the page, so
               all three work without a round trip, and the page is whole with scripts off. */}
          <form class="library-tools" role="search" aria-label="Library">
            <div class="search-wrap">
            <label class="search-field">
              <Icon name="search" />
              <span class="sr-only">Search episodes</span>
              <input
                type="search"
                name="q"
                placeholder="Search episodes"
                autocomplete="off"
                enterkeyhint="search"
                data-library-search
              />
            </label>
            <button class="search-clear press press-subtle" type="button" aria-label="Clear text" data-library-clear-text hidden>
              <Icon name="close" />
            </button>
            </div>
            <div class="library-bar">
              <label class="sort-field filter-field">
                <span class="sr-only">Show</span>
                <select data-library-filter>
                  {LIBRARY_FILTERS.map((filter) => (
                    <option value={filter.id}>{filter.label}</option>
                  ))}
                </select>
                <Icon name="chevronDown" />
              </label>
              <label class="sort-field">
                <span class="sr-only">Sort</span>
                <select data-library-sort>
                  {LIBRARY_SORTS.map((sort) => (
                    <option value={sort.id}>{sort.label}</option>
                  ))}
                </select>
                <Icon name="chevronDown" />
              </label>
              {/* How the library is laid out: covers in a grid, or compact rows. Remembered on this device. */}
              <div class="view-switch" role="group" aria-label="View">
                <button class="view-btn press press-subtle" type="button" aria-pressed="true" aria-label="Gallery view" data-library-view="gallery">
                  <svg class="icon" viewBox="0 0 256 256" aria-hidden="true" focusable="false"><path d="M104 40H56a16 16 0 0 0-16 16v48a16 16 0 0 0 16 16h48a16 16 0 0 0 16-16V56a16 16 0 0 0-16-16Zm0 64H56V56h48Zm96-64h-48a16 16 0 0 0-16 16v48a16 16 0 0 0 16 16h48a16 16 0 0 0 16-16V56a16 16 0 0 0-16-16Zm0 64h-48V56h48Zm-96 32H56a16 16 0 0 0-16 16v48a16 16 0 0 0 16 16h48a16 16 0 0 0 16-16v-48a16 16 0 0 0-16-16Zm0 64H56v-48h48Zm96-64h-48a16 16 0 0 0-16 16v48a16 16 0 0 0 16 16h48a16 16 0 0 0 16-16v-48a16 16 0 0 0-16-16Zm0 64h-48v-48h48Z"></path></svg>
                </button>
                <button class="view-btn press press-subtle" type="button" aria-pressed="false" aria-label="List view" data-library-view="list">
                  <svg class="icon" viewBox="0 0 256 256" aria-hidden="true" focusable="false"><path d="M224 128a8 8 0 0 1-8 8H40a8 8 0 0 1 0-16h176a8 8 0 0 1 8 8ZM40 72h176a8 8 0 0 0 0-16H40a8 8 0 0 0 0 16Zm176 112H40a8 8 0 0 0 0 16h176a8 8 0 0 0 0-16Z"></path></svg>
                </button>
              </div>
            </div>
          </form>
          <p class="sr-only" role="status" data-library-status>
            {resultSummary(items.length, items.length)}
          </p>
          <ul class="library-grid" role="list" data-library-grid>
            {items.map((item, index) =>
              item.kind === "episode" ? (
                <EpisodeCard entry={item.entry} priority={index < 6} />
              ) : (
                <BriefingCard entry={item.entry} priority={index < 6} />
              ),
            )}
          </ul>
          <div class="library-empty" data-library-empty hidden>
            <p>Nothing matches.</p>
            <button class="btn" type="button" data-library-clear>
              Clear search
            </button>
          </div>
        </div>
      )
    }
  </main>
  <script>
    import "../scripts/libraryPage";
  </script>
</BaseLayout>
