---
import BriefingCard from "../components/BriefingCard.astro";
import EmptyArt from "../components/EmptyArt.astro";
import EpisodeActions from "../components/EpisodeActions.astro";
import EpisodeCard from "../components/EpisodeCard.astro";
import Button from "../design-system/Button.astro";
import Icon from "../design-system/Icon.astro";
import Select from "../design-system/Select.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { LIBRARY_FILTERS, LIBRARY_SORTS, monthLabel, monthOf, resultSummary } from "../lib/library";
import { type LibraryItem, libraryItems } from "../lib/libraryCard";
import { getSite } from "../lib/site";
// Inline, so a saved List view is on the page before its first frame, not after the page's script.
// astro.config.mjs hashes this same file into the Content-Security-Policy.
import libraryViewInit from "../scripts/libraryViewInit.js?raw";
import { CONTENT_CDN_CACHE, readFromContentRepo } from "../server/contentRepo";

// Rendered on request from the content repository (D173); the static test build prerenders it.
export const prerender = false;

if (!Astro.isPrerendered) {
  const unavailable = await readFromContentRepo("library");
  if (unavailable) return unavailable;
  Astro.response.headers.set("Vercel-CDN-Cache-Control", CONTENT_CDN_CACHE);
}

const { entries, episodes } = await getSite();
const items = libraryItems(entries, episodes);
const dateOf = (item: LibraryItem): string =>
  item.kind === "episode" ? item.entry.episode.date : item.entry.digest.date;
---

<BaseLayout
  title="Library"
  view="library"
  skipLabel="Skip to the library"
  library={items.length === 0 ? "empty" : "items"}
>
  <main id="main" class="library" tabindex="-1">
    {
      items.length === 0 ? (
        <section class="library-none" aria-labelledby="page-title">
          <h1 class="page-title text-display library-title" id="page-title" tabindex="-1">
            Library
          </h1>
          {/* The page keeps its title; under it, the scene, what is true and the one thing to do. */}
          <div class="empty">
            <EmptyArt art="library" />
            <h2 class="empty-title">Nothing here yet</h2>
            <p class="empty-body">Podcasts arrive on your schedule. Episodes you make are kept here too.</p>
            <div class="empty-actions">
              <Button variant="filled" href="/create" data-create-open data-sound="open">
                Catch up
              </Button>
            </div>
          </div>
        </section>
      ) : (
        <div data-library>
          <h1 class="page-title text-display library-title" id="page-title" tabindex="-1">
            Library
          </h1>
          {/* Search, then what to show, then the order. Every briefing is already in the page, so
               all three work without a round trip, and the page is whole with scripts off. */}
          <form class="library-tools" role="search" aria-label="Library">
            <div class="search-wrap">
            <label class="search-field">
              <Icon name="search" />
              <span class="sr-only">Search your library</span>
              <input
                type="search"
                name="q"
                placeholder="Search your library"
                autocomplete="off"
                enterkeyhint="search"
                data-library-search
              />
            </label>
            <button class="search-clear press press-subtle" type="button" aria-label="Clear text" data-library-clear-text hidden>
              <Icon name="close" />
            </button>
            </div>
            <div class="library-bar">
              {/* What to show: one kind at a time, or everything while none is ticked. Each chip is
                   a checkbox (Tab and Space); the script unticks the others. */}
              <fieldset class="filter-chips library-filters" aria-label="Show" data-library-filters>
                {LIBRARY_FILTERS.filter((filter) => filter.id !== "all").map((filter) => (
                  <label class="filter-chip">
                    <input type="checkbox" name="show" value={filter.id} data-library-filter />
                    <Icon name="check" class="filter-chip-check" />
                    <span>{filter.label}</span>
                  </label>
                ))}
              </fieldset>
              <Select variant="tonal" label="Sort" class="library-sort" data-library-sort>
                {LIBRARY_SORTS.map((sort) => (
                  <option value={sort.id}>{sort.label}</option>
                ))}
              </Select>
              {/* How the library is laid out: covers in a grid, or compact rows. Remembered on this device. */}
              <div class="view-switch" role="group" aria-label="View">
                <button class="view-btn press press-subtle" type="button" aria-pressed="true" aria-label="Gallery view" data-library-view="gallery">
                  <Icon name="viewGrid" />
                </button>
                <button class="view-btn press press-subtle" type="button" aria-pressed="false" aria-label="List view" data-library-view="list">
                  <Icon name="viewList" />
                </button>
              </div>
            </div>
          </form>
          {/* After the view switch and before the first card: a saved List view is set here. */}
          <script is:inline set:html={libraryViewInit.trim()} />
          <p class="sr-only" role="status" data-library-status>
            {resultSummary(items.length, items.length)}
          </p>
          <ul class="library-grid" role="list" data-library-grid>
            {/* A month's heading before its first card, newest first as the cards come. Only the list
                 shows them (library.css); libraryPage.ts moves them with the cards. */}
            {items.map((item, index) => {
              const month = monthOf(dateOf(item));
              const previous = items[index - 1];
              return (
                <>
                  {(previous === undefined || monthOf(dateOf(previous)) !== month) && (
                    <li class="library-month" data-month-head data-month={month}>
                      <h2 class="library-month-head">{monthLabel(month)}</h2>
                    </li>
                  )}
                  {item.kind === "episode" ? (
                    <EpisodeCard entry={item.entry} priority={index < 6} />
                  ) : (
                    <BriefingCard entry={item.entry} priority={index < 6} menu />
                  )}
                </>
              );
            })}
          </ul>
          {/* The script shows this and writes its title and button from emptyCopy(); the line under
               the title follows the search box in CSS, so it needs no script of its own. */}
          <div class="library-empty empty" data-library-empty hidden>
            <EmptyArt art="results" />
            <h2 class="empty-title" data-library-empty-message>No results</h2>
            <p class="empty-body library-empty-search">Try different words, or show the whole library.</p>
            <p class="empty-body library-empty-filter">Show all to see the rest of your library.</p>
            <div class="empty-actions">
              <Button variant="filled" data-library-clear>
                Clear search
              </Button>
            </div>
          </div>
        </div>
      )
    }
  </main>
  {/* The dialogs Regenerate and Delete open, once for every row's menu (scripts/episodeActions.ts). */}
  {items.length > 0 && <EpisodeActions id="library" />}
  <script>
    import "../scripts/libraryPage";
  </script>
</BaseLayout>
