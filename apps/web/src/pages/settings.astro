---
import Icon from "../components/Icon.astro";
import ManageChrome from "../components/ManageChrome.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadManage } from "../lib/manage";
import { loadScheduleView } from "../lib/schedule";
import { dailySummary, topicsSummary, voicesSummary, weeklySummary } from "../lib/settingsSummary";
import { topicLayout } from "../lib/topicPages";
import { loadWriterView, writerLabel } from "../lib/writer";
import { THEME_PREFERENCES, type ThemePreference } from "../player/core/preferences";
// The build links this file before the layout's stylesheet, so its rules never rely on coming last:
// where one adjusts a shared rule, it does so with a more specific selector.
import "../styles/settings.css";
import "../styles/manage.css";

const [schedule, writer, manage] = await Promise.all([
  loadScheduleView(),
  loadWriterView(),
  loadManage(),
]);
// The topics a person sees (D69): the owner's three, any of their own apart from those, and the
// general news topics; the judge's finer topics are inside the three.
const layout = topicLayout(manage.topics, manage.sources);
const shownTopics = [...layout.groups, ...layout.own, ...layout.general].map((topic) => topic.id);
const spots = Object.fromEntries(
  [...layout.sources].flatMap(([page, list]) =>
    list.map((source) => [source.id, { page, on: source.enabled }]),
  ),
);
// Each row leads to the one page that sets it, and says its current state in a few words. What the
// words are worked out from rides along as data, so an edit saved since the build can be shown in
// them (scripts/settingsSaved.ts, loaded only when one is kept).
const PODCAST = [
  {
    href: "/settings/daily",
    label: "Daily",
    hint: dailySummary(schedule),
    data: {
      summary: "daily",
      hour: schedule.hour,
      cadence: schedule.cadenceDays,
      timezone: schedule.timezone,
    },
  },
  {
    href: "/settings/weekly",
    label: "Weekly",
    hint: weeklySummary({ ...schedule.weekly, timezone: schedule.timezone }),
    data: {
      summary: "weekly",
      day: schedule.weekly.day,
      hour: schedule.weekly.hour,
      timezone: schedule.timezone,
    },
  },
  {
    href: "/settings/topics",
    label: "Sources",
    hint: topicsSummary(shownTopics.length, manage.sources.length),
    data: {
      summary: "topics",
      shown: shownTopics.join(" "),
      taken: manage.topics.map((topic) => topic.id).join(" "),
      sources: JSON.stringify(spots),
    },
  },
  {
    href: "/settings/preferences",
    label: "Preferences",
    hint: "Story types",
    data: {},
  },
];
// The voices every podcast is read in, and the interface's own sounds, each on a page of its own.
// Whether sounds are on is kept in this browser, so settingsPage.ts writes that row's line.
const SOUND = [
  {
    href: "/settings/voice",
    label: "Podcast voice",
    hint: voicesSummary(schedule.voiceId ?? "", schedule.voiceIdB ?? ""),
    data: { summary: "voice", voice: schedule.voiceId ?? "", "voice-b": schedule.voiceIdB ?? "" },
  },
  { href: "/settings/sounds", label: "Interface sounds", hint: "On", data: { "sounds-hint": "" } },
];

// The day this build was made, which is what changes when the site does.
const updated = new Intl.DateTimeFormat("en-GB", {
  timeZone: "Europe/Stockholm",
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(new Date());

const THEME_LABELS: Record<ThemePreference, string> = {
  system: "System",
  light: "Light",
  dark: "Dark",
};
---

<BaseLayout title="Settings" view="settings" skipLabel="Skip to the settings">
  <main id="main" tabindex="-1">
    {/* Static markup with native controls. No radio is checked and no value is set here: the stored
         choice is only known in the browser, so settingsPage.ts fills the controls in and then marks
         the page ready. Until then each control keeps its place and shows no state, which is why a
         stored Dark never flashes System first. */}
    <div class="settings-view" data-settings>
      <h1 id="page-title" tabindex="-1">Settings</h1>
      <noscript>
        <p class="settings-note">These settings need JavaScript, which is turned off in this browser.</p>
      </noscript>

      <section>
        <h2 class="section-head">Podcast</h2>
        <div class="rows">
          {
            PODCAST.map((row) => (
              <a
                class="row-action"
                href={row.href}
                {...Object.fromEntries(Object.entries(row.data).map(([key, value]) => [`data-${key}`, value]))}
              >
                <span class="settings-text">
                  <span class="settings-label">{row.label}</span>
                  <span class="settings-hint" data-hint>{row.hint}</span>
                </span>
                <Icon name="chevronRight" />
              </a>
            ))
          }
        </div>
      </section>

      {/* Intelligence holds the model select alone, and is the model editor's root:
           scripts/podcastEntry.ts loads it after first paint and fills the select, and autosave.ts
           sends a pick a moment later. */}
      <section data-manage="podcast">
        <h2 class="section-head">Intelligence</h2>
        <div class="rows">
          <div class="settings-row" data-models data-saved={writer.model ?? ""} data-provider={writer.provider}>
            <label class="settings-label" for="model-select">AI model</label>
            <span class="manage-select value-select">
              <select class="manage-input" id="model-select" name="model" autocomplete="off">
                <option value={writer.model ?? ""} selected>{writerLabel(writer.model, writer.provider)}</option>
              </select>
              <Icon name="chevronDown" />
            </span>
          </div>
        </div>
        <ManageChrome />
      </section>

      <section>
        <h2 class="section-head">Sound</h2>
        <div class="rows">
          {
            SOUND.map((row) => (
              <a
                class="row-action"
                href={row.href}
                {...Object.fromEntries(Object.entries(row.data).map(([key, value]) => [`data-${key}`, value]))}
              >
                <span class="settings-text">
                  <span class="settings-label">{row.label}</span>
                  <span class="settings-hint" data-hint>{row.hint}</span>
                </span>
                <Icon name="chevronRight" />
              </a>
            ))
          }
        </div>
      </section>

      <section>
        <h2 class="section-head">Appearance</h2>
        <div class="rows">
          {/* A select drawn as the AI model's is (2026-10-21). No option is selected in the markup:
               settingsPage.ts sets the stored one, and until then the value is not drawn, so a stored
               Dark never shows System first. */}
          <div class="settings-row">
            <label class="settings-label" for="settings-theme">Theme</label>
            <span class="manage-select value-select theme-select">
              <select class="manage-input" id="settings-theme" name="theme" autocomplete="off">
                {THEME_PREFERENCES.map((theme) => <option value={theme}>{THEME_LABELS[theme]}</option>)}
              </select>
              <Icon name="chevronDown" />
            </span>
          </div>
        </div>
      </section>

      <section>
        <h2 class="section-head">About</h2>
        <p class="settings-about">
          Singularity is a hobby project by Somesh Kesarla Suresh. It picks stories from chosen news outlets and topics and turns them into a podcast, on its own.
        </p>
        <div class="rows">
          <div class="settings-row">
            <span class="settings-label">Last updated</span>
            <span class="settings-hint">{updated}</span>
          </div>
        </div>
      </section>

      {/* Only Safari on iOS can do this, and only when the app is not already on the Home Screen, so
           the section starts hidden and the script shows it where it applies. */}
      {/* Chrome and Edge on Android hand the page an install prompt; the row shows only while one is held. */}
      <section data-install-app hidden>
        <div class="rows">
          <div class="settings-row">
            <div class="settings-text">
              <span class="settings-label">Install Singularity</span>
              <span class="settings-hint">Opens on its own, like an app, and works offline.</span>
            </div>
            <button class="btn" type="button" data-install-app-button>Install</button>
          </div>
        </div>
      </section>

      <section data-install-hint hidden>
        <div class="rows">
          <div class="settings-row">
            <div class="settings-text">
              <span class="settings-label">Add Singularity to your Home Screen</span>
              <span class="settings-hint">In Safari, tap Share, then Add to Home Screen.</span>
            </div>
            <button class="btn" type="button" data-install-dismiss>Hide this</button>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  import { installPodcastPage } from "../scripts/podcastEntry";
  import { installSettingsPage } from "../scripts/settingsPage";

  installSettingsPage();
  installPodcastPage();
</script>
