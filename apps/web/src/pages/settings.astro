---
import ManageChrome from "../components/ManageChrome.astro";
import Button from "../design-system/Button.astro";
import Icon from "../design-system/Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildDayShort } from "../lib/buildDay";
import { loadManage } from "../lib/manage";
import { loadScheduleView } from "../lib/schedule";
import { dailySummary, sourcesSummary, weeklySummary } from "../lib/settingsSummary";
import { topicLayout } from "../lib/topicPages";
// The build links this file before the layout's stylesheet, so its rules never rely on coming last:
// where one adjusts a shared rule, it does so with a more specific selector.
import "../styles/settings.css";
import "../styles/manage.css";

const [schedule, manage] = await Promise.all([loadScheduleView(), loadManage()]);
// Where every source shows, so the Sources row can count an edit saved since the build.
const layout = topicLayout(manage.topics, manage.sources);
const spots = Object.fromEntries(
  [...layout.sources].flatMap(([page, list]) =>
    list.map((source) => [source.id, { page, on: source.enabled }]),
  ),
);
type Row = { href: string; label: string; hint?: string; data: Record<string, string | number> };

// Each row leads to the one page that sets it, and says its current state in a few words. What the
// words are worked out from rides along as data, so an edit saved since the build can be shown in
// them (scripts/settingsSaved.ts, loaded only when one is kept). A row with nothing to say has no
// line (2026-10-22): its name is enough.
const PODCAST: Row[] = [
  {
    href: "/settings/daily",
    label: "Daily",
    hint: dailySummary(schedule),
    data: {
      summary: "daily",
      hour: schedule.hour,
      cadence: schedule.cadenceDays,
      timezone: schedule.timezone,
    },
  },
  {
    href: "/settings/weekly",
    label: "Weekly",
    hint: weeklySummary({ ...schedule.weekly, timezone: schedule.timezone }),
    data: {
      summary: "weekly",
      day: schedule.weekly.day,
      hour: schedule.weekly.hour,
      timezone: schedule.timezone,
    },
  },
  {
    href: "/settings/categories",
    label: "Sources",
    hint: sourcesSummary({ total: manage.sources.length }),
    data: { summary: "sources", sources: JSON.stringify(spots) },
  },
  // The route stays /settings/preferences: the page is the podcast's structure alone now (D326).
  {
    href: "/settings/preferences",
    label: "Structure",
    data: {},
  },
];
// The app's own settings (D326). Appearance and Sound and voice say nothing: their names are enough.
// Haptics says On or Off, written by settingsPage.ts from this device's preferences, and is hidden on a
// device with no motor to ask. Notifications' line is the browser's (notificationsSettings.ts).
const APP: Row[] = [
  { href: "/settings/appearance", label: "Appearance", data: {} },
  { href: "/settings/sound", label: "Sound and voice", data: {} },
];

const updated = buildDayShort();
---

<BaseLayout title="Settings" view="settings" skipLabel="Skip to the settings">
  <main id="main" tabindex="-1">
    {/* Static markup with native controls and links. The rows that show a state wait for the script
         that knows it (this device's preferences, the browser's notifications), so no build-time word
         ever paints first. */}
    <div class="settings-view" data-settings>
      <h1 class="text-display" id="page-title" tabindex="-1">Settings</h1>
      <noscript>
        <p class="settings-note">These settings need JavaScript, which is turned off in this browser.</p>
      </noscript>

      <section>
        <h2 class="section-head text-heading">Podcast settings</h2>
        <div class="rows card-group">
          {
            PODCAST.map((row) => (
              <a
                class="row-action"
                href={row.href}
                {...Object.fromEntries(Object.entries(row.data).map(([key, value]) => [`data-${key}`, value]))}
              >
                <span class="settings-text">
                  <span class="settings-label">{row.label}</span>
                  {/* A line the store can change waits for it, so the build's words never paint first
                       (settings.css, held for the store). */}
                  {row.hint !== undefined && (
                    <span class="settings-hint" data-hint data-store-held={"summary" in row.data ? "" : undefined}>
                      {row.hint}
                    </span>
                  )}
                </span>
                <Icon name="chevronRight" />
              </a>
            ))
          }
        </div>
      </section>

      <section>
        <h2 class="section-head text-heading">App settings</h2>
        <div class="rows card-group">
          {
            APP.map((row) => (
              <a class="row-action" href={row.href}>
                <span class="settings-text">
                  <span class="settings-label">{row.label}</span>
                </span>
                <Icon name="chevronRight" />
              </a>
            ))
          }
          <a class="row-action" href="/settings/haptics" data-haptics-row hidden>
            <span class="settings-text">
              <span class="settings-label">Haptics</span>
              <span class="settings-hint" data-hint data-haptics-hint></span>
            </span>
            <Icon name="chevronRight" />
          </a>
          <a class="row-action" href="/settings/notifications" data-notifications-hint>
            <span class="settings-text">
              <span class="settings-label">Notifications</span>
              <span class="settings-hint" data-hint>Off</span>
            </span>
            <Icon name="chevronRight" />
          </a>
        </div>
      </section>

      {/* No heading: three rows say what they are. The date under them is the build's, small and
           centred; from 64rem the side column carries it (settings.css). */}
      <section aria-label="About">
        <div class="rows card-group">
          <a class="row-action" href="/settings/about">
            <span class="settings-text">
              <span class="settings-label">About</span>
            </span>
            <Icon name="chevronRight" />
          </a>
          <a class="row-action" href="/settings/privacy">
            <span class="settings-text">
              <span class="settings-label">Privacy</span>
            </span>
            <Icon name="chevronRight" />
          </a>
          <a class="row-action" href="/settings/changelog">
            <span class="settings-text">
              <span class="settings-label">Change log</span>
            </span>
            <Icon name="chevronRight" />
          </a>
        </div>
        <p class="settings-updated">Last updated on {updated}</p>
      </section>

      {/* Only Safari on iOS can do this, and only when the app is not already on the Home Screen, so
           the section starts hidden and the script shows it where it applies. */}
      {/* Chrome and Edge on Android hand the page an install prompt; the row shows only while one is held. */}
      <section data-install-app hidden>
        <div class="rows card-group card-group-accent">
          <div class="settings-row">
            <div class="settings-text">
              <span class="settings-label">Install Singularity</span>
              <span class="settings-hint">Opens on its own, like an app, and works offline.</span>
            </div>
            <Button variant="text" data-install-app-button>Install</Button>
          </div>
        </div>
      </section>

      <section data-install-hint hidden>
        <div class="rows card-group card-group-accent">
          <div class="settings-row">
            <div class="settings-text">
              <span class="settings-label">Add Singularity to your Home Screen</span>
              <span class="settings-hint">In Safari, tap Share, then Add to Home Screen.</span>
            </div>
            <Button variant="text" data-install-dismiss>Hide this</Button>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  import { installPodcastPage } from "../scripts/podcastEntry";
  import { installSettingsPage } from "../scripts/settingsPage";

  installSettingsPage();
  installPodcastPage();
</script>
