---
import Icon from "../components/Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadManage } from "../lib/manage";
import { readCounts } from "../lib/savedOverlay";
import { loadScheduleView } from "../lib/schedule";
import { dailySummary, modelSummary, topicsSummary, weeklySummary } from "../lib/settingsSummary";
import { topicLayout } from "../lib/topicPages";
import { loadWriterView } from "../lib/writer";
import { THEME_PREFERENCES, type ThemePreference } from "../player/core/preferences";
// The build links this file before the layout's stylesheet, so its rules never rely on coming last:
// where one adjusts a shared rule, it does so with a more specific selector.
import "../styles/settings.css";

const [schedule, writer, manage] = await Promise.all([
  loadScheduleView(),
  loadWriterView(),
  loadManage(),
]);
// The topics a person sees (D69): the owner's three, any of their own apart from those, and the
// general news topics; the judge's finer topics are inside the three.
const layout = topicLayout(manage.topics, manage.sources);
const shownTopics = [...layout.groups, ...layout.own, ...layout.general].map((topic) => topic.id);
// A source is read only while it is on and so is the topic whose page lists it: a general topic
// switched off reads none of its sources, whatever their own boxes say.
const offPages = manage.topics.filter((topic) => !topic.enabled).map((topic) => topic.id);
const spots = Object.fromEntries(
  [...layout.sources].flatMap(([page, list]) =>
    list.map((source) => [source.id, { page, on: source.enabled }]),
  ),
);
const sourcesOn = readCounts(spots, offPages, []).on;
// Each row leads to the one page that sets it, and says its current state in a few words. What the
// words are worked out from rides along as data, so an edit saved since the build can be shown in
// them (scripts/settingsSaved.ts, loaded only when one is kept).
const PODCAST = [
  {
    href: "/settings/daily",
    label: "Daily",
    hint: dailySummary(schedule),
    data: {
      summary: "daily",
      hour: schedule.hour,
      cadence: schedule.cadenceDays,
      timezone: schedule.timezone,
    },
  },
  {
    href: "/settings/weekly",
    label: "Weekly",
    hint: weeklySummary({ ...schedule.weekly, timezone: schedule.timezone }),
    data: {
      summary: "weekly",
      enabled: String(schedule.weekly.enabled),
      day: schedule.weekly.day,
      hour: schedule.weekly.hour,
      timezone: schedule.timezone,
    },
  },
  {
    href: "/settings/topics",
    label: "Topics and sources",
    hint: topicsSummary(shownTopics.length, manage.sources.length, sourcesOn),
    data: {
      summary: "topics",
      shown: shownTopics.join(" "),
      taken: manage.topics.map((topic) => topic.id).join(" "),
      sources: JSON.stringify(spots),
      off: offPages.join(" "),
    },
  },
  {
    href: "/settings/model",
    label: "Model",
    hint: modelSummary(writer.provider, writer.model),
    data: { summary: "model", provider: writer.provider, model: writer.model ?? "" },
  },
];

// The version is the day this build was made, which is what changes when the site does.
const version = new Intl.DateTimeFormat("en-GB", {
  timeZone: "Europe/Stockholm",
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(new Date());

const THEME_LABELS: Record<ThemePreference, string> = {
  system: "System",
  light: "Light",
  dark: "Dark",
};
---

<BaseLayout title="Settings" view="settings" skipLabel="Skip to the settings">
  <main id="main" tabindex="-1">
    {/* Static markup with native controls. No radio is checked and no value is set here: the stored
         choice is only known in the browser, so settingsPage.ts fills the controls in and then marks
         the page ready. Until then each control keeps its place and shows no state, which is why a
         stored Dark never flashes System first. */}
    <div class="settings-view" data-settings>
      <h1 id="page-title" tabindex="-1">Settings</h1>
      <noscript>
        <p class="settings-note">These settings need JavaScript, which is turned off in this browser.</p>
      </noscript>

      <section>
        <h2 class="section-head">Podcast</h2>
        <div class="rows">
          {
            PODCAST.map((row) => (
              <a
                class="row-action"
                href={row.href}
                {...Object.fromEntries(Object.entries(row.data).map(([key, value]) => [`data-${key}`, value]))}
              >
                <span class="settings-text">
                  <span class="settings-label">{row.label}</span>
                  <span class="settings-hint" data-hint>{row.hint}</span>
                </span>
                <Icon name="chevronRight" />
              </a>
            ))
          }
        </div>
      </section>

      <section>
        <h2 class="section-head">Sound</h2>
        <div class="rows">
          <div class="settings-row">
            <label class="settings-label" for="settings-sounds">Interface sounds</label>
            <input class="settings-switch" id="settings-sounds" name="sounds" type="checkbox" role="switch" />
          </div>
          <div class="settings-row">
            <label class="settings-label" for="settings-volume">Volume</label>
            <input class="settings-range" id="settings-volume" name="volume" type="range" min="0" max="1" step="0.05" />
          </div>
        </div>
      </section>

      <section>
        <h2 class="section-head">Appearance</h2>
        <div class="rows">
          <div class="settings-row" data-layout="choice">
            <div class="settings-text">
              <span class="settings-label" id="settings-theme-label">Theme</span>
            </div>
            <fieldset class="settings-choice" role="radiogroup" aria-labelledby="settings-theme-label">
              {
                THEME_PREFERENCES.map((theme) => (
                  <label class="settings-segment">
                    <input type="radio" name="theme" value={theme} />
                    <span>{THEME_LABELS[theme]}</span>
                  </label>
                ))
              }
            </fieldset>
          </div>
        </div>
      </section>

      <section>
        <h2 class="section-head">About</h2>
        <div class="rows">
          <div class="settings-row">
            <span class="settings-label">Made by Somesh Kesarla Suresh</span>
          </div>
          <div class="settings-row">
            <span class="settings-label">Version</span>
            <span class="settings-hint">{version}</span>
          </div>
        </div>
      </section>

      {/* Only Safari on iOS can do this, and only when the app is not already on the Home Screen, so
           the section starts hidden and the script shows it where it applies. */}
      <section data-install-hint hidden>
        <div class="rows">
          <div class="settings-row">
            <div class="settings-text">
              <span class="settings-label">Add Singularity to your Home Screen</span>
              <span class="settings-hint">In Safari, tap Share, then Add to Home Screen.</span>
            </div>
            <button class="btn" type="button" data-install-dismiss>Hide this</button>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  import { installSettingsPage } from "../scripts/settingsPage";

  installSettingsPage();
</script>
