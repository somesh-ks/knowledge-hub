---
import Avatar from "../design-system/Avatar.astro";
import Icon from "../design-system/Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
// Linked before the layout's stylesheet, as the Settings pages do (settings.css).
import "../styles/settings.css";
import "../styles/profile.css";
---

<BaseLayout title="Profile" view="settings" nav={null} skipLabel="Skip to your profile">
  <main id="main" tabindex="-1">
    {/* Who the app is for: the avatar, the shapes this mood offers for it, and the two lists that are
         the reader's own. Sign-in with Google comes later and will put the account photo in the
         avatar's place; until then nothing here asks for one (D326). */}
    <div class="settings-view profile" data-profile>
      <h1 class="text-display" id="page-title" tabindex="-1">Profile</h1>

      <div class="profile-face" data-account>
        <Avatar size="xl" />
      </div>

      <section>
        <h2 class="section-head text-heading">Avatar</h2>
        <div class="rows card-group">
          {/* profilePage.ts fills it with the shapes the current mood offers. */}
          <div class="profile-shapes" role="group" aria-label="Avatar shape" data-avatar-picker></div>
        </div>
      </section>

      <section aria-label="Downloads and favorites">
        <div class="rows card-group">
          <a class="row-action" href="/settings/downloads">
            <span class="settings-text">
              <span class="settings-label">Downloads</span>
            </span>
            <Icon name="chevronRight" />
          </a>
          <a class="row-action" href="/settings/saved">
            <span class="settings-text">
              <span class="settings-label">Saved</span>
            </span>
            <Icon name="chevronRight" />
          </a>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  import { installProfilePage } from "../scripts/profilePage";

  installProfilePage();
</script>
