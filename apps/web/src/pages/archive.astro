---
import ArchiveYear from "../components/ArchiveYear.astro";
import EmptyState from "../components/EmptyState.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { groupArchive } from "../lib/archive";
import { pluralize } from "../lib/format";
import { getSite } from "../lib/site";

const { entries } = await getSite();
const years = groupArchive(entries);
---

<BaseLayout title="Archive" view="archive" skipLabel="Skip to the archive">
  <main id="main" tabindex="-1">
    {
      entries.length === 0 ? (
        <EmptyState />
      ) : (
        <div class="archive-view">
          <header class="page-head">
            <h1 class="page-title" id="page-title" tabindex="-1">Archive</h1>
            <p class="meta">{pluralize(entries.length, "briefing")}, newest first</p>
          </header>
          {years.map((group, index) => <ArchiveYear group={group} isNewest={index === 0} />)}
        </div>
      )
    }
  </main>
</BaseLayout>
