---
import { ClientRouter } from "astro:transitions";
import appFont from "../assets/fonts/google-sans-flex-latin-wght-normal.woff2?url";
import AppNav, { type Destination } from "../components/AppNav.astro";
import Banner from "../components/Banner.astro";
import CreateFab from "../components/CreateFab.astro";
import CreateSheet from "../components/CreateSheet.astro";
import LaunchScreen from "../components/LaunchScreen.astro";
import PlayFab, { type PageAudio } from "../components/PlayFab.astro";
import RunStatus from "../components/RunStatus.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { readBrandColors } from "../lib/brandColors";
import { BUILD_ID } from "../lib/buildId";
import { loadConfigHash } from "../lib/configHash";
import { fabFor } from "../lib/fab";
import type { LinkCard } from "../lib/linkCard";
import PlayerRoot from "../player/PlayerRoot";
// The device banners go in before first paint too, by an inline script hashed the same way.
import bannersInit from "../scripts/bannersInit.js?raw";
// Moves keys saved as dispatch:* before D179, so it runs before anything reads them.
import storageRename from "../scripts/storageRename.js?raw";
// The theme script runs inline in the head so a stored light or dark choice never flashes the other
// theme before first paint. astro.config.mjs hashes this same file into the Content-Security-Policy.
import themeInit from "../scripts/themeInit.js?raw";
import SheetsRoot from "../sheets/SheetsRoot";
import "../styles/tokens.css";
import "../styles/foundations.css";
import "../styles/fonts.css";
import "../styles/shell.css";
import "../styles/buttons.css";
import "../styles/primitives.css";
import "../styles/cover.css";
import "../styles/reader.css";
import "../styles/banner.css";
import "../styles/empty.css";
import "../styles/hero.css";
import "../styles/briefing.css";
import "../styles/library.css";
import "../styles/aside.css";
import "../styles/view-transitions.css";
import "../styles/create-sheet.css";
import "../styles/utilities.css";

interface Props {
  /** The page title. The site name is appended. */
  title?: string;
  description?: string;
  /** Which kind of page this is. */
  view: "home" | "library" | "create" | "settings";
  /**
   * The destination marked as current in the navigation. Defaults to the one the view belongs to; an
   * earlier briefing or an episode passes "library", and a page outside the three (not found, offline)
   * passes null.
   */
  nav?: Destination | null;
  /** "aside" adds the contents column from 80rem. */
  layout?: "aside" | "single";
  /** Set on digest pages so the player and CSS can tell which briefing is on screen. */
  digestId?: string;
  /** The page's own audio, an episode or a briefing, which the floating Play button plays. */
  audio?: PageAudio;
  skipLabel?: string;
  /** false on the offline page, which says it itself: no banner repeats it above. */
  deviceBanner?: boolean;
  /** The Library page alone, with or without anything in it ("empty" draws .library-none). */
  library?: "empty" | "items";
  /** The card a chat app draws when this page's link is pasted: briefings and episodes (D153). */
  card?: LinkCard;
  /** Whether the page draws section tabs: a briefing or an episode with two sections or more. */
  tabs?: boolean;
}

const {
  title,
  description = "A private tech and design engineering briefing.",
  view,
  nav,
  layout = "single",
  digestId,
  audio,
  skipLabel = "Skip to the briefing",
  deviceBanner = true,
  library,
  card,
  tabs = false,
} = Astro.props;
// What the page holds, said on the root from the first frame, where the stylesheets once asked with
// a root :has() that restyled the whole page (D147): data-has-hero, a hero with its own Play (every
// page with audio draws one, DigestHero.astro and EpisodeView.astro); data-has-tabs, the section
// tabs (SectionTabs.astro, from two sections); data-library-page, the Library and whether it is empty.

const colors = readBrandColors();
// Create is the primary action, not a destination. Its page sits under the Library, where episodes
// are kept and where its Back leads, so the Library is the current tab there.
const destination =
  nav === undefined ? (view === "home" ? "today" : view === "create" ? "library" : view) : nav;
const pageTitle = title ? `${title}, Singularity` : "Singularity";
// Below 64rem a floating button carries a page's one primary action, as on Android, and only where
// that action is the next thing to do (lib/fab.ts, D60). Create belongs to the Library, the list
// where making an episode is next. On a page with audio of its own, Today, an older briefing or an
// episode, the next thing is to hear it, so it floats Play: the hero chip scrolls away with the
// page, and the button keeps the page's audio one press away from anywhere on it. Topics and
// sources and a topic's page float Add, which the page draws itself. Other Settings pages, Create
// itself, offline and not found would only be cluttered by one; the side column carries Create on
// wide screens everywhere. data-fab keeps room for the button while it shows. Play steps aside
// while the bar holds the page's audio, as the bar is then its control and two controls for one
// recording would compete: the player takes data-fab off, and the page gives the room back.
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
// The owner's config is in the store (D149): the settings pages lay what it holds over the copy they
// were built with (lib/savedKey.ts, configStoreRead.ts). Read from the build's environment, which on
// Vercel is the deployment's; without the switch no page asks. The tag names the config files the
// page was built from, so a page from another build never takes edits made against this one.
const configStore =
  (process.env.SINGULARITY_CONFIG_STORE ?? process.env.DISPATCH_CONFIG_STORE) === "postgres"
    ? await loadConfigHash()
    : null;
const fab = fabFor({ path, playable: Boolean(audio && digestId) });
// A page one level down (a briefing or an episode, a Settings sub-page, the Create page) leads back
// in the app bar: to where the person came from when that was in the app, else to its list.
// The latest briefing at its dated address is Today, a top-level destination: no Back there.
const back =
  destination === "today"
    ? undefined
    : /^\/(d|e)\//.test(path) || path === "/create"
      ? { href: "/library", label: "Back" }
      : /^\/settings\/./.test(path)
        ? { href: path.replace(/\/[^/]+$/, ""), label: "Back" }
        : undefined;
---

<!doctype html>
<html
  lang="en"
  data-view={view}
  data-fab={fab ? "" : undefined}
  data-layout={layout}
  data-digest-id={digestId}
  data-device-banner={deviceBanner ? undefined : "off"}
  data-has-hero={audio ? "" : undefined}
  data-has-tabs={tabs ? "" : undefined}
  data-library-page={library}
  data-player="closed"
  data-mini="hidden"
  data-player-state="idle"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={colors.surfaceLight} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={colors.surfaceDark} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Singularity" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={description} />
    <meta name="singularity-build" content={BUILD_ID} />
    {configStore && <meta name="singularity-config-store" content={configStore} />}
    <title>{pageTitle}</title>
    {
      card && (
        <>
          <meta property="og:type" content="article" />
          <meta property="og:site_name" content="Singularity" />
          <meta property="og:title" content={card.title} />
          <meta property="og:description" content={card.description} />
          <meta property="og:url" content={new URL(path, Astro.site).href} />
          <meta property="og:image" content={new URL(card.image, Astro.site).href} />
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content="1024" />
          <meta property="og:image:height" content="1024" />
          <meta property="og:image:alt" content={card.imageAlt} />
          <meta name="twitter:card" content="summary" />
        </>
      )
    }
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={appFont} as="font" type="font/woff2" crossorigin />
    <script is:inline set:html={storageRename.trim()} />
    <script is:inline set:html={themeInit.trim()} />
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <LaunchScreen />
    <a class="skip-link" href="#main">{skipLabel}</a>
    <SiteHeader back={back} />
    <AppNav current={destination} />
    {fab === "create" && <CreateFab />}
    <RunStatus />
    {/* The offline banner is cloned from this, so its markup has one home: by the script after the
         stack before first paint, and by deviceBanners.ts from then on. */}
    <template id="banner-offline">
      <Banner
        tone="warning"
        icon="wifiOff"
        title="You are offline"
        bodyId="offline-reason"
      />
    </template>
    <div class="banner-stack page" id="banners"><slot name="banners" /></div>
    <script is:inline set:html={bannersInit.trim()} />
    <div class="shell page"><slot /></div>
    {/* After the shell, so the hero's Play it waits for (create-sheet.css) is already in the page
         when the button is first styled: before it, the button showed for a frame on load. */}
    {fab === "play" && digestId && audio && <PlayFab digestId={digestId} {...audio} />}

    {/* Both islands live in the layout and persist across navigation, so the audio object inside the
         player module is never rebuilt and playback never stops while you move between pages. They
         wake when asked (scripts/islandWake.ts), so a first visit loads no React until it needs it. */}
    <PlayerRoot client:wake transition:persist="player" />
    <SheetsRoot client:wake transition:persist="sheets" />
    {/* The Create page has the form in the page itself; every other page gets it as the sheet. */}
    {view !== "create" && <CreateSheet />}

    <script>
      import { startPlayerRuntime } from "../player/core/playerRuntime";
      import "../scripts/app";
      import "../dev/agentation";

      // The audio store's wiring answers the page's Play controls at once; the bar's island waits.
      startPlayerRuntime();
    </script>
  </body>
</html>
