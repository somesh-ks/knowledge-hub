---
import { ClientRouter } from "astro:transitions";
import appFont from "../assets/fonts/google-sans-flex-latin-wght-normal.woff2?url";
import AppNav, { type Destination } from "../components/AppNav.astro";
import Banner from "../components/Banner.astro";
import CreateFab from "../components/CreateFab.astro";
import CreateSheet from "../components/CreateSheet.astro";
import RunStatus from "../components/RunStatus.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { readBrandColors } from "../lib/brandColors";
import PlayerRoot from "../player/PlayerRoot";
// The theme script runs inline in the head so a stored light or dark choice never flashes the other
// theme before first paint. astro.config.mjs hashes this same file into the Content-Security-Policy.
import themeInit from "../scripts/themeInit.js?raw";
import SheetsRoot from "../sheets/SheetsRoot";
import "../styles/tokens.css";
import "../styles/foundations.css";
import "../styles/fonts.css";
import "../styles/shell.css";
import "../styles/buttons.css";
import "../styles/primitives.css";
import "../styles/cover.css";
import "../styles/reader.css";
import "../styles/banner.css";
import "../styles/hero.css";
import "../styles/briefing.css";
import "../styles/library.css";
import "../styles/aside.css";
import "../styles/view-transitions.css";
import "../styles/create-sheet.css";
import "../styles/utilities.css";

interface Props {
  /** The page title. The site name is appended. */
  title?: string;
  description?: string;
  /** Which kind of page this is. */
  view: "home" | "library" | "create" | "settings";
  /**
   * The destination marked as current in the navigation. Defaults to the one the view belongs to; an
   * earlier briefing or an episode passes "library", and a page outside the three (not found, offline)
   * passes null.
   */
  nav?: Destination | null;
  /** "aside" adds the contents column from 80rem. */
  layout?: "aside" | "single";
  /** Set on digest pages so the player and CSS can tell which briefing is on screen. */
  digestId?: string;
  skipLabel?: string;
}

const {
  title,
  description = "A private tech and design engineering briefing.",
  view,
  nav,
  layout = "single",
  digestId,
  skipLabel = "Skip to the briefing",
} = Astro.props;

const colors = readBrandColors();
// Create is the primary action, not a destination, so its page marks none in the navigation.
const destination =
  nav === undefined ? (view === "home" ? "today" : view === "create" ? null : view) : nav;
const pageTitle = title ? `${title}, Singularity` : "Singularity";
---

<!doctype html>
<html
  lang="en"
  data-view={view}
  data-layout={layout}
  data-digest-id={digestId}
  data-player="closed"
  data-mini="hidden"
  data-player-state="idle"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={colors.surfaceLight} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={colors.surfaceDark} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Singularity" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={appFont} as="font" type="font/woff2" crossorigin />
    <script is:inline set:html={themeInit.trim()} />
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">{skipLabel}</a>
    <SiteHeader />
    <AppNav current={destination} />
    <CreateFab />
    <RunStatus />
    <div class="banner-stack page" id="banners"><slot name="banners" /></div>
    <div class="shell page"><slot /></div>

    {/* Both islands live in the layout and persist across navigation, so the audio object inside the
         player module is never rebuilt and playback never stops while you move between pages. */}
    <PlayerRoot client:idle transition:persist="player" />
    <SheetsRoot client:idle transition:persist="sheets" />
    {/* The Create page has the form in the page itself; every other page gets it as the sheet. */}
    {view !== "create" && <CreateSheet />}

    {/* Banners that depend on the device are cloned from these by app.ts, so their markup has one home. */}
    <template id="banner-offline">
      <Banner
        tone="warning"
        icon="wifiOff"
        title="You are offline"
        body="Showing the last briefing you opened. Audio needs a connection."
      />
    </template>
    <template id="banner-stale">
      <Banner
        tone="warning"
        icon="clock"
        title="This briefing is a few days old"
        body="No newer briefing has been published yet."
      />
    </template>

    <script>
      import "../scripts/app";
      import "../dev/agentation";
    </script>
  </body>
</html>
