---
/**
 * The Flag (flag.ts, D367): a region's flag, or text whose flag emoji are drawn as flags (a topic's
 * emoji). The text itself goes on the element that holds it as data-text (flag.ts showText), so a
 * script reads it back the same way after a change.
 */
import { flagBadgeClass, flagClass, flagParts, flagSrc, hasFlagArt } from "./flag";
import "../styles/flag.css";

interface Props {
  /** An ISO 3166-1 code: the flag alone, at the 16 by 12 of a row of controls. */
  region?: string;
  /** Text that may hold flag emoji: its flags drawn at the size of the words. */
  text?: string;
}

const { region, text = "" } = Astro.props;
const parts = region ? [{ region }] : flagParts(text);
---

{
  parts.map((part) =>
    typeof part === "string" ? (
      part
    ) : !hasFlagArt(part.region) ? (
      <span class={flagBadgeClass(region === undefined)} data-code={part.region} aria-hidden="true" />
    ) : (
      <img
        class={flagClass(region === undefined)}
        src={flagSrc(part.region)}
        alt=""
        aria-hidden="true"
        decoding="async"
        loading="lazy"
      />
    ),
  )
}
