---
import type { HTMLAttributes } from "astro/types";
import { sliderClass, sliderWaveFieldClass } from "./slider";
import "../styles/slider.css";

interface SliderProps {
  /** For placing the slider where it stands (a width, a flex basis). Never its look. */
  class?: string;
  /**
   * A hue: the rail is the whole spectrum, the thumb is the colour picked, and a swatch floats above it
   * while it is held (D328). The caller keeps --range-fill on the field the slider is wrapped in.
   */
  hue?: boolean;
  /**
   * The track up to the thumb drifts (a wave in Expressive, a zigzag in Halloween) and the rest stays
   * straight; Default draws the plain Slider. The caller keeps --range-fill on the field the input is wrapped in.
   */
  wavy?: boolean;
}

type Props = SliderProps & Omit<HTMLAttributes<"input">, keyof SliderProps | "type">;

const { class: placement, hue = false, wavy = false, ...rest } = Astro.props;
---

{
  hue ? (
    <span class:list={["slider-hue-field", placement]}>
      <input class={sliderClass()} type="range" {...rest} />
      <span class="slider-hue-swatch" aria-hidden="true" />
    </span>
  ) : wavy ? (
    <span class:list={[sliderWaveFieldClass(), placement]}>
      <input class={sliderClass()} type="range" {...rest} />
    </span>
  ) : (
    <input class:list={[sliderClass(), placement]} type="range" {...rest} />
  )
}
