{
  "name": "@singularity/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "tsx ../../packages/design-system/scripts/buildTokens.ts && tsx ../../scripts/pullConfig.ts && tsx ../../scripts/pullContent.ts",
    "build": "astro build",
    "postbuild": "tsx scripts/checkBundle.ts && tsx scripts/checkFunction.ts",
    "preview": "node e2e/run.mjs",
