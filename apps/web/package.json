    "e2e": "playwright test",
    "e2e:player": "playwright test -c src/player/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@astrojs/vercel": "11.0.17",
    "@base-ui/react": "^1.9.0",
    "@singularity/core": "workspace:*",
    "@singularity/cover": "workspace:*",
    "@singularity/design-system": "workspace:@singularityfm/design-system@*",
    "@singularity/engine": "workspace:*",
    "@singularity/sound": "workspace:*",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.5",
    "astro": "^7.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.14",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "agentation": "^3.1.2",
    "linkedom": "^0.18.14",
    "typescript": "~6.0.3",
    "vercel": "65.9.0"
  }
}
