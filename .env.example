# Copy to .env, fill in your editor, then run `npm run secrets:push`. Never paste values into chat.
# A value left empty is skipped. docs/runbook.md section 1.2 says where each one comes from.

# 1. Fetch
EXA_API_KEY=
FIRECRAWL_API_KEY=

# 2. Judge
TYPESAFE_API_KEY=

# 3. Write
ANTHROPIC_API_KEY=
# Optional: the Costs page reads Anthropic's bill with it (Vercel only).
ANTHROPIC_ADMIN_KEY=

# 4. Audio
SPEECHIFY_API_KEY=
SPEECHIFY_VOICE_ID=
SPEECHIFY_MONTHLY_CHARS=

# 5. Vercel and Blob
VERCEL_TOKEN=
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# 6. Commits (Vercel Hobby only deploys commits authored by the owner)
SINGULARITY_GIT_NAME=
SINGULARITY_GIT_EMAIL=26426782+somesh-ks@users.noreply.github.com

# 7. Generate button (Vercel env vars)
# Fine-grained GitHub token for this repo: Actions read and write, Contents read
GITHUB_SINGULARITY_TOKEN=
GITHUB_REPOSITORY=somesh-ks/knowledge-hub

# 8. Scheduled runs: Vercel Cron sends this with every call. 16 or more random characters,
# for example `openssl rand -hex 24`.
CRON_SECRET=

# 9. Optional: YouTube transcription and the topic emoji backup
GEMINI_API_KEY=

# 10. Neon (the config store and shared counters). Pooled connection string.
DATABASE_URL=

# 11. Command center at /admin (D224), sent to the singularity-admin Vercel project (needs `vercel link` in apps/admin).
# ADMIN_SESSION_SECRET: 32 or more random characters, for example `openssl rand -base64 32`.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
