# Copy to .env and fill in the values in your editor. .env is gitignored.
# Never paste these values into chat or commit them.
# After filling .env, `npm run secrets:push` sends them to GitHub Actions and Vercel
# without printing them.

# Judge (TypeSafe Jev)
TYPESAFE_API_KEY=

# Writer (Nebius Token Factory, OpenAI-compatible)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
DISPATCH_MODEL=
DISPATCH_FALLBACK_MODEL=

# Discovery and extraction
EXA_API_KEY=
FIRECRAWL_API_KEY=

# Audio (Speechify)
SPEECHIFY_API_KEY=
SPEECHIFY_VOICE_ID=geffen_32

# Hosting (Vercel). Create a token at https://vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
# Created by the Vercel CLI when the Blob store is made
BLOB_READ_WRITE_TOKEN=

# Generate button (set as Vercel environment variables)
# Fine-grained GitHub token for this repo only: Actions read and write, Contents read
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=somesh-ks/dispatch
# scrypt hash of the passphrase; create with: npm run passphrase
GENERATE_PASSPHRASE_HASH=

# Optional: one-time YouTube channel-ID lookup
YOUTUBE_API_KEY=
