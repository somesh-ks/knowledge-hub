# Copy to .env, fill in your editor, then run `npm run secrets:push`. Never paste values into chat.

# 1. Fetch
EXA_API_KEY=
FIRECRAWL_API_KEY=

# 2. Judge
TYPESAFE_API_KEY=

# 3. Write (models and their order are in config/models.json; ANTHROPIC_API_KEY is below)

# 4. Audio
SPEECHIFY_API_KEY=
SPEECHIFY_VOICE_ID=geffen_32
# The second host of a discussion; the site and the audio job must use the same one.
SPEECHIFY_VOICE_ID_B=
SPEECHIFY_MONTHLY_CHARS=500000
# Vercel token for the Audio step: https://vercel.com/account/tokens (Blob credentials come from OIDC)
VERCEL_TOKEN=

# 5. Commits (Vercel Hobby only deploys commits authored by the owner)
DISPATCH_GIT_NAME=Somesh Kesarla Suresh
DISPATCH_GIT_EMAIL=26426782+somesh-ks@users.noreply.github.com

# 6. Generate button (Vercel env vars)
# Fine-grained GitHub token for this repo: Actions read and write, Contents read
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=somesh-ks/knowledge-hub
# `npm run passphrase` writes this
GENERATE_PASSPHRASE_HASH=

# Optional: Composio (YouTube); nothing needs it yet
COMPOSIO_API_KEY=

# Optional: Gemini transcribes YouTube videos that have no subtitles (finalists only, capped per run)
GEMINI_API_KEY=
