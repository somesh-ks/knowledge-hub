      "field": { "$value": "oklch(84% 0.06 145)" },
      "shade": { "$value": "oklch(60% 0.09 150)" },
      "accent": { "$value": "oklch(44% 0.13 153)" },
      "text": { "$value": "oklch(22% 0.04 150)" }
    },
    "kelp": {
      "$description": "Deep teal water with a pale chartreuse flash. Dark pair of lichen.",
      "$extensions": { "dispatch": { "name": "Kelp", "tone": "dark" } },
      "ground": { "$value": "oklch(21% 0.04 195)" },
      "field": { "$value": "oklch(31% 0.065 192)" },
      "shade": { "$value": "oklch(54% 0.09 185)" },
