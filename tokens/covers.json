    "$type": "color",
    "ultramarine": {
      "$description": "Deep blue ground, signal yellow figure.",
      "$extensions": {
        "dispatch": {
          "name": "Ultramarine",
          "tone": "dark"
        }
      },
      "ground": {
        "$value": "oklch(38% 0.2 267)"
      },
      "accent": {
        "$value": "oklch(90% 0.17 100)"
      },
      "text": {
        "$value": "oklch(97% 0.012 100)"
      }
    },
