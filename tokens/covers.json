  "mode": {
    "$description": "How every cover adapts to the app's theme, applied after a cover is dressed so palettes and monthly schemes stay theme-free. Each colour's OKLCH lightness is mapped linearly into `lightness` (the band that sits well on that page) and its chroma scaled by `chroma`; contrast floors are then re-held by moving the foreground away from its ground. Covers outside the app (lock screen, social card) use the colours as authored.",
    "light": {
      "$description": "On the light page: full colour, the darkest inks lifted to charcoal as on the dark page so a grid reads calm (the owner: \"the album arts are much darker\", 2026-10-31); the palest stay as authored (the owner: bright ones in light mode).",
      "lightness": {
        "$value": [0.2, 1]
      },
      "chroma": {
        "$value": 1
      }
    },
    "dark": {
      "$description": "On the dark page: the darkest inks lift to charcoal and the palest settle to parchment, so a grid does not glare (the owner: faded ones in dark mode), while colour keeps its full chroma (then: slightly brighter in both themes, 2026-10-16).",
      "lightness": {
        "$value": [0.2, 0.9]
      },
      "chroma": {
        "$value": 1
      }
    }
  },
  "style": {
    "$description": "How a style (Settings, Style) redraws a cover, drawn live by cover.css from the month's dress, so every month and every palette follows the same rule (D314). Each colour keeps its place in the month: its hue is pulled toward the style's `hue` (the month's own centre keeps `keep` of its distance, each colour keeps `spread` of its distance from the month's centre, at most `cap` degrees), its chroma is scaled and lifted, and `flip` mirrors lightness inside a band per theme. Contrast floors are re-held after. A style with no rule here (Default) leaves covers as the month dressed them. `hue` is the one number a reader-set hue would move.",
    "expressive": {
      "$description": "Loud: the month's colours pulled toward electric violet, chroma lifted; lightness as the theme set it. Owner: \"LOVE THE COVERS\" (2026-11-01).",
      "hue": {
        "$value": 292
      },
      "keep": {
        "$value": 0.15
      },
      "spread": {
        "$value": 0.5
      },
      "cap": {
        "$value": 40
      },
      "chroma": {
        "$description": "Chroma becomes scale x chroma + add, at most max; a colour below floor-below becomes floor.",
        "scale": {
          "$value": 1.6
        },
        "add": {
          "$value": 0.05
        },
        "max": {
          "$value": 0.3
        },
        "floor-below": {
          "$value": 0.02
        },
        "floor": {
          "$value": 0.035
        }
      }
    },
    "halloween": {
      "$description": "Night: lightness mirrored so paper turns violet-black and ink turns pumpkin; the darkest colours take the night hue.",
      "hue": {
        "$value": 52
      },
      "keep": {
        "$value": 0.2
      },
      "spread": {
        "$value": 0.25
      },
      "cap": {
        "$value": 180
      },
      "chroma": {
        "scale": {
          "$value": 1.1
        },
        "add": {
          "$value": 0.03
        },
        "max": {
          "$value": 0.19
        },
        "floor-below": {
          "$value": 0.03
        },
        "floor": {
          "$value": 0.03
        }
      },
      "flip": {
        "$description": "Lightness l becomes low + (1 - l) x (high - low), per theme.",
        "light": {
          "$value": [0.13, 0.91]
        },
        "dark": {
          "$value": [0.09, 0.87]
        }
      },
      "night": {
        "$description": "A colour mirrored below `below` lightness is the ground: it takes this hue and chroma.",
        "below": {
          "$value": 0.37
        },
        "hue": {
          "$value": 305
        },
        "chroma": {
          "$value": 0.045
        }
      }
    }
  }
