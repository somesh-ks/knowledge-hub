{
  "$description": "Cover palettes for generated digest artwork. Colors are OKLCH; packages/cover converts them to sRGB hex with gamut clamping at build time. Each palette has a ground, a quiet field tint, a mid shade, one focal accent and a verified text color for the date (4.5:1 against ground and field).",
  "cover": {
    "$type": "color",
    "fog-lingonberry": {
      "$description": "The reader's own colors: lingonberry on cool fog. Light pair of sea-lingonberry.",
      "$extensions": { "dispatch": { "name": "Fog and Lingonberry", "tone": "light" } },
      "ground": { "$value": "oklch(94.6% 0.01 230)" },
      "field": { "$value": "oklch(87% 0.022 232)" },
      "shade": { "$value": "oklch(54% 0.05 245)" },
      "accent": { "$value": "oklch(50% 0.185 14)" },
      "text": { "$value": "oklch(21% 0.03 250)" }
    },
    "sea-lingonberry": {
      "$description": "Lingonberry on deep sea. Dark pair of fog-lingonberry.",
      "$extensions": { "dispatch": { "name": "Sea and Lingonberry", "tone": "dark" } },
      "ground": { "$value": "oklch(19% 0.024 250)" },
      "field": { "$value": "oklch(28% 0.034 250)" },
      "shade": { "$value": "oklch(54% 0.055 245)" },
      "accent": { "$value": "oklch(70% 0.165 14)" },
      "text": { "$value": "oklch(95% 0.008 230)" }
    },
    "ultramarine": {
      "$description": "Near-monochrome Klein blue on pale periwinkle.",
      "$extensions": { "dispatch": { "name": "Ultramarine", "tone": "light" } },
      "ground": { "$value": "oklch(94.5% 0.018 270)" },
      "field": { "$value": "oklch(85% 0.05 266)" },
      "shade": { "$value": "oklch(66% 0.11 262)" },
      "accent": { "$value": "oklch(47% 0.23 267)" },
      "text": { "$value": "oklch(23% 0.09 268)" }
    },
    "indigo-aqua": {
      "$description": "Deep indigo with a soft aqua spark. Dark pair of ultramarine.",
      "$extensions": { "dispatch": { "name": "Indigo and Aqua", "tone": "dark" } },
      "ground": { "$value": "oklch(22% 0.07 285)" },
      "field": { "$value": "oklch(31% 0.1 285)" },
      "shade": { "$value": "oklch(52% 0.15 288)" },
      "accent": { "$value": "oklch(82% 0.1 190)" },
      "text": { "$value": "oklch(95% 0.012 285)" }
