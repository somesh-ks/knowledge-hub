    },
    "toast": {
      "radius": {
        "$description": "Concentric: action radius (sm) plus padding.",
        "$type": "dimension",
        "$value": "{primitive.radius.lg}",
        "$extensions": {
          "dispatch": {
            "concentric": {
              "inner": "{primitive.radius.sm}",
              "padding": "{primitive.space.2}"
            }
          }
        }
      },
      "padding": {
        "$type": "dimension",
        "$value": "{primitive.space.2}"
      },
      "min-height": {
        "$type": "dimension",
        "$value": "3.5rem"
      },
      "bg": {
        "$type": "color",
        "$value": "{semantic.color.surface-inverse}"
      },
      "fg": {
        "$type": "color",
        "$value": "{semantic.color.on-surface-inverse}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": "{semantic.shadow.popover}"
      }
    },
    "banner": {
      "radius": {
        "$type": "dimension",
        "$value": "{primitive.radius.md}"
      },
      "padding": {
        "$type": "dimension",
        "$value": "{primitive.space.3}"
      }
    },
    "archive-row": {
      "padding": {
        "$type": "dimension",
        "$value": "{primitive.space.2}"
      },
      "radius": {
        "$description": "Concentric: cover thumb radius (sm) plus row padding.",
        "$type": "dimension",
        "$value": "{primitive.radius.lg}",
        "$extensions": {
          "dispatch": {
