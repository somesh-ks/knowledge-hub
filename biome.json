{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.vercel",
      "!**/.astro",
      "!**/.cache",
      "!**/.claude",
      "!**/test-results",
      "!**/playwright-report",
      "!docs/prototype",
      "!**/fixtures",
      "!loop/results",
      "!pnpm-lock.yaml",
      "!apps/web/public/emoji.json",
      "!packages/design-system/tokens/system.json",
      "!state",
      "!config"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "includes": ["**", "!packages/design-system/styles/menu.css"]
  },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } },
  "markdown": { "formatter": { "enabled": false } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": { "noImportantStyles": "error" },
      "correctness": { "usePlaywrightValidDescribeCallback": "off" },
      "suspicious": { "noExplicitAny": "error" },
      "style": { "noNonNullAssertion": "error" }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": { "noUnusedImports": "off", "noUnusedVariables": "off" }
        }
      }
    }
  ],
  "assist": { "enabled": true }
}
